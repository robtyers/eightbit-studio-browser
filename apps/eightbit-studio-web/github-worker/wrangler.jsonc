{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eightbit-studio-github",
  "account_id": "1efa1aec0723b1aeca51354c81416f4a",
  "main": "index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "eightbitstudio.com/studio-api/*", "zone_name": "eightbitstudio.com" }
  ],
  "vars": {
    "APP_ORIGIN": "https://eightbitstudio.com",
    "GITHUB_CLIENT_ID": "Iv23liwtB9Ftah2hTxsY",
    "GITHUB_APP_SLUG": "eightbit-studio-online"
  },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "GitHubSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GitHubSession"] }]
  // Secrets stay in Cloudflare. See docs/browser-edition.md for deployment and rollback.
}
