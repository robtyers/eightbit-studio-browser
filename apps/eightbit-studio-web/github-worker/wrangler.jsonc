{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eightbit-studio-github",
  "main": "index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "APP_ORIGIN": "https://eightbitstudio.com",
    "GITHUB_CLIENT_ID": "",
    "GITHUB_APP_SLUG": ""
  },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "GitHubSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GitHubSession"] }]
  // No route or secrets are provisioned by this file. See docs/browser-edition.md.
}
