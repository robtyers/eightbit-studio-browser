}

#[test]
fn staged_renum_synthetic_reference() {
    let fixtures: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/bc9cc9bfa3460e8e-renum.json"
    ))
    .unwrap();
    for row in fixtures["observations"].as_array().unwrap() {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        for line in row["programme"].as_array().unwrap() {
            let (number, text) = line.as_str().unwrap().split_once(' ').unwrap();
            store_line(&mut memory, &mut cpu, number.parse().unwrap(), text);
        }
        enable_guest_printer(&mut memory);
        let command = row["command"].as_str().unwrap();
        let success = execute_direct(&mut memory, &mut cpu, command);
        assert_eq!(
            success,
            row["errors"].as_array().unwrap().is_empty(),
            "{command}"
        );
        if !success {
            let error = row["errors"][0].as_str().unwrap();
            assert_eq!(
                candidate_error_index(&memory),
                if error == "FC" { 2 } else { 0 },
                "{command}"
            );
        }
        memory.output.clear();
        assert!(execute_direct(&mut memory, &mut cpu, "LIST"));
        assert_eq!(
            memory.output,
            row["listing"].as_str().unwrap().as_bytes(),
            "{command}"
        );
    }
}

#[test]
fn staged_renum_reports_missing_targets_using_new_line_numbers() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    store_line(&mut memory, &mut cpu, 10, "GOTO 99:IF A THEN 88 ELSE 77");
    store_line(&mut memory, &mut cpu, 20, "END");
    enable_guest_printer(&mut memory);
    assert!(execute_direct(&mut memory, &mut cpu, "RENUM 100"));
    assert_eq!(memory.output, b"UL 99 IN 100\rUL 88 IN 100\rUL 77 IN 100\r");
    assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], 0);
}

#[test]
fn staged_renum_memory_limit_failure_is_atomic() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    store_line(&mut memory, &mut cpu, 10, "GOTO10");
    store_line(&mut memory, &mut cpu, 20, "GOTO20");
    assert!(execute_direct(&mut memory, &mut cpu, "Z=85"));
    let end = word(&memory, 0x1b);
    let before = memory.bytes[0x1e01..usize::from(word(&memory, 0x1f))].to_vec();
    let pointers = memory.bytes[0x19..0x21].to_vec();
    set_word(&mut memory, 0x21, end + 128 + 4);
    assert!(!execute_direct(&mut memory, &mut cpu, "RENUM63998,0,1"));
    assert_eq!(memory.bytes[0x19..0x21], pointers);
    assert_eq!(memory.bytes[0x1e01..0x1e01 + before.len()], before);
    assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], 0);
    assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
}

#[test]
fn staged_renum_range_and_expansion_failures_preserve_programme() {
    for command in [
        "RENUM63999,0,1",
        "RENUM1,0,63999",
        "RENUM10,0,0",
        "RENUM64000",
        "RENUM1,20,1",
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(&mut memory, &mut cpu, 10, "GOTO20");
        store_line(&mut memory, &mut cpu, 20, "END");
        let end = usize::from(word(&memory, 0x1b));
        let before = memory.bytes[0x1e01..end].to_vec();
        assert!(!execute_direct(&mut memory, &mut cpu, command), "{command}");
        assert_eq!(memory.bytes[0x1e01..end], before, "{command}");
        assert_eq!(usize::from(word(&memory, 0x1b)), end, "{command}");
        assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], 0);
        assert!(execute_direct(&mut memory, &mut cpu, "RENUM100,0,10"));
    }
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    store_line(
        &mut memory,
        &mut cpu,
        1,
        &format!("GOTO1:{}", " ".repeat(245)),
    );
    let end = usize::from(word(&memory, 0x1b));
    let before = memory.bytes[0x1e01..end].to_vec();
    assert!(!execute_direct(&mut memory, &mut cpu, "RENUM63999,0,1"));
    assert_eq!(memory.bytes[0x1e01..end], before);
    assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], 0);
}
#[test]
fn staged_renum_large_programme_keeps_every_link_and_reference() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    memory.probe_address = 0x0800;
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    for line in 1..=500 {
        store_line(
            &mut memory,
            &mut cpu,
            line,
            if line == 500 { "END" } else { "GOTO500" },
        );
    }
    let begin = memory.cycles;
    assert!(execute_direct_with_budget(
        &mut memory,
        &mut cpu,
        "RENUM60000,0,1",
        64_000_000
    ));
    let cycles = memory.cycles - begin;
    let mut cursor = usize::from(word(&memory, 0x19));
    for index in 0..500 {
        assert_eq!(word(&memory, cursor + 2), 60000 + index);
        let next = usize::from(word(&memory, cursor));
        assert!(next > cursor && next < usize::from(word(&memory, 0x1b)));
        if index < 499 {
            assert_eq!(
                &memory.bytes[cursor + 4..next],
                &[0x81, 0xbc, b'6', b'0', b'4', b'9', b'9', 0]
            );
        }
        cursor = next;
    }
    assert_eq!(word(&memory, cursor), 0);
    assert_eq!(cursor + 2, usize::from(word(&memory, 0x1b)));
    assert_eq!(word(&memory, 0x1b), word(&memory, 0x1d));
    assert_eq!(word(&memory, 0x1d), word(&memory, 0x1f));
    assert!(cycles < 300_000_000, "bounded renumbering: {cycles}");
    println!("500-line native RENUM: {cycles} guest E cycles");
}

#[test]
fn staged_edit_synthetic_reference() {
    let fixtures: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/34d27d666899e995-edit.json"
    ))
    .unwrap();
    for row in fixtures["observations"].as_array().unwrap() {
        let keys = row["keys"].as_str().unwrap();
        // XRoar's type injection does not expose these control characters as
        // physical key events; their separate matrix observation owns them.
        if keys.contains('\x15') || keys.contains('\x1b') || keys.contains('\x03') {
            continue;
        }
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        store_line(&mut memory, &mut cpu, 10, row["body"].as_str().unwrap());
        enable_guest_printer(&mut memory);
        supply_original_keyboard(&mut memory, keys.as_bytes());
        assert!(execute_direct(&mut memory, &mut cpu, "EDIT10"), "{keys:?}");
        memory.output.clear();
        assert!(execute_direct(&mut memory, &mut cpu, "LIST"));
        assert_eq!(
            memory.output,
            row["listing"].as_str().unwrap().as_bytes(),
            "{keys:?}"
        );
    }
}

#[test]
fn staged_edit_shift_exit_insert_and_guarded_storage() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    store_line(&mut memory, &mut cpu, 10, "PRINT \"ABCABC\"");
    enable_guest_printer(&mut memory);
    supply_original_keyboard(&mut memory, b"7 IXY\x15C!\r");
    assert!(execute_direct(&mut memory, &mut cpu, "EDIT10"));
    memory.output.clear();
    assert!(execute_direct(&mut memory, &mut cpu, "LIST"));
    assert_eq!(memory.output, b"10 PRINT \"XY!BCABC\"\r");
    let before = memory.bytes[0x1e01..usize::from(word(&memory, 0x1b))].to_vec();
    supply_original_keyboard(&mut memory, b"7 DQ");
    assert!(execute_direct(&mut memory, &mut cpu, "EDIT10"));
    assert_eq!(
        memory.bytes[0x1e01..usize::from(word(&memory, 0x1b))],
        before
    );
    assert!(!execute_direct(&mut memory, &mut cpu, "EDIT99"));
    assert!(execute_direct(&mut memory, &mut cpu, "PRINT 42"));
}

#[test]
fn staged_edit_ignores_physical_break_in_command_and_insertion_modes() {
    for keys in [b"\x03Q".as_slice(), b"IZ\x03\x15Q".as_slice()] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(&mut memory, &mut cpu, 10, "REM ABC");
        let before = memory.bytes[0x1e01..usize::from(word(&memory, 0x1b))].to_vec();
        supply_original_keyboard(&mut memory, keys);
        assert!(execute_direct(&mut memory, &mut cpu, "EDIT10"));
        assert_eq!(
            word(&memory, 0x6600),
            0x6700 + u16::try_from(keys.len()).unwrap()
        );
        assert_eq!(memory.bytes[0x1e01..0x1e01 + before.len()], before);
    }
}
