#[test]
fn consuming_allocation_uses_only_authoritative_public_roots() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/7ea7dcd6266ff192-consuming-collection-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let id = fact["id"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR50"));
        install_authored_string_extension(&mut memory);
        let callback = [
            0x7c, 0x63, 0x38, 0xbd, 0, 0x9f, 0xbd, 0, 0x9f, 0xbd, 0, 0x9f, 0x86, 0xff, 0x97, 6,
            0xbe, 0x63, 0x34, 0x9f, 0x52, 0x39,
        ];
        memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "Q$=STRING$(10,65):Q$=\"\":A$=CHR$(90):M=VARPTR(A$)"
        ));
        let scalar = (usize::from(word(&memory, 0x1b))..usize::from(word(&memory, 0x1d)))
            .step_by(7)
            .find(|&p| memory.bytes[p..p + 2] == [b'A', 0x80])
            .unwrap()
            + 2;
        let original = word(&memory, scalar + 2);
        let descriptor = if fact["usesScalarDescriptor"].as_bool().unwrap() {
            scalar
        } else {
            let value = memory.bytes[scalar..scalar + 5].to_vec();
            memory.bytes[0x6310..0x6315].copy_from_slice(&value);
            0x6310
        };
        set_word(&mut memory, 0x6334, u16::try_from(descriptor).unwrap());
        if !fact["retainsScalarAlias"].as_bool().unwrap() {
            assert!(execute_direct(&mut memory, &mut cpu, "A$=\"\""));
        }
        assert!(
            execute_direct(&mut memory, &mut cpu, source),
            "{id}: {source}"
        );
        assert_eq!(memory.bytes[0x6338], 1, "callback {id}");
        let expected = fact["result"].as_str().unwrap().as_bytes();
        let value = numeric_scalar(&memory, [b'B', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([value[2], value[3]]));
        assert_eq!(usize::from(value[0]), expected.len(), "length {id}");
        assert_eq!(
            &memory.bytes[pointer..pointer + expected.len()],
            expected,
            "value {id}"
        );
        assert_eq!(
            word(&memory, descriptor + 2) != original,
            fact["descriptorMoved"].as_bool().unwrap(),
            "descriptor movement {id}"
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn presentation_native_using_separator_lifecycle_and_recovery() {
    for (source, expected, success) in [
        ("PRINT#-2,USING\"[##]\";1;2;", "[ 1][ 2]", true),
        ("PRINT#-2,USING\"[##]\";1,2", "[ 1][ 2]\r", true),
        ("PRINT#-2,USING\"X##Y##Z\";1;", "X 1Y", true),
        ("PRINT#-2,USING\"X##Y##Z\";1", "X 1Y\r", true),
        ("PRINT#-2,USING\"X##Y##Z\";1;2;", "X 1Y 2Z", true),
        ("PRINT#-2,USING\"[##]\";1,,2", "[ 1][", false),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, source),
            success,
            "{source}"
        );
        assert_eq!(memory.output, expected.as_bytes(), "{source}");
        assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0);
        assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], 0);
        memory.output.clear();
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "PRINT#-2,USING\"##\";7"
        ));
        assert_eq!(memory.output, b" 7\r");
    }
}

#[test]
fn presentation_native_editor_count_survives_keys_display_and_command_reentry() {
    for (keys, expected) in [
        (b"4 2CXY2\x082D\r".as_slice(), "REM CABCABC"),
        (b"4 2SA1CX\r".as_slice(), "REM ABCABCXBC"),
        (b"4 2KA\r".as_slice(), "REM ABC"),
        (b"200 200\x084 C!\r".as_slice(), "REM !BCABCABC"),
        (b"4 IXY\x152D\r".as_slice(), "REM XYCABCABC"),
        (b"256 C!\r".as_slice(), "R!M ABCABCABC"),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(&mut memory, &mut cpu, 10, "REM ABCABCABC");
        memory.bytes[0x3d9] = 0xa5;
        supply_original_keyboard(&mut memory, keys);
        assert!(execute_direct(&mut memory, &mut cpu, "EDIT10"), "{keys:?}");
        assert_eq!(
            word(&memory, 0x6600),
            0x6700 + u16::try_from(keys.len()).unwrap()
        );
        assert_eq!(memory.bytes[0x3d9], 0xa5);
        memory.output.clear();
        assert!(execute_direct(&mut memory, &mut cpu, "LIST"));
        assert_eq!(
            memory.output,
            format!("10 {expected}\r").as_bytes(),
            "{keys:?}"
        );
    }
}

#[test]
fn presentation_native_repeated_renumber_and_editor_quit_keep_state_owned() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    store_line(&mut memory, &mut cpu, 10, "GOTO20");
    store_line(&mut memory, &mut cpu, 20, "PRINT\"END\":END");
    for command in ["RENUM100,0,10", "RENUM10,0,10", "RENUM60000,0,1"] {
        assert!(execute_direct(&mut memory, &mut cpu, command));
        assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], 0);
    }
    let before = memory.bytes[0x1e01..usize::from(word(&memory, 0x1b))].to_vec();
    supply_original_keyboard(&mut memory, b"I123\x15Q");
    assert!(execute_direct(&mut memory, &mut cpu, "EDIT60000"));
    assert_eq!(memory.bytes[0x1e01..0x1e01 + before.len()], before);
    memory.output.clear();
    assert!(execute_direct(&mut memory, &mut cpu, "LIST"));
    assert_eq!(memory.output, b"60000 GOTO60001\r60001 PRINT\"END\":END\r");
    assert!(execute_direct(&mut memory, &mut cpu, "Z=42"));
    assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(42));
}

#[test]
fn string_function_first_argument_error_order_matches_reference() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/5f73d2ab82c7c584-string-argument-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x23, 0x7ffe);
        set_word(&mut memory, 0x27, 0x7ffe);
        let errors = fact["errors"].as_array().unwrap();
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, source),
            errors.is_empty(),
            "{source}"
        );
        if let Some(error) = errors.first() {
            let expected = match error.as_str().unwrap() {
                "SN" => 2,
                "TM" => 24,
                "FC" => 8,
                "OS" => 30,
                _ => unreachable!(),
            };
            assert_eq!(
                memory.bytes[usize::from(symbol("ERROR_CODE"))],
                expected,
                "{source}"
            );
        }
        assert_eq!(word(&memory, 0x0b), 0x1a9, "{source}: public temporaries");
        assert!(
            execute_direct(&mut memory, &mut cpu, "Z=42"),
            "{source}: recovery"
        );
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(42));
    }
}

#[test]
fn exec_continuation_uses_public_cursor_ignores_machine_flags_and_retains_errors() {
    for carry in [false, true] {
        for source in ["EXEC24576:POKE25345,17", "EXEC24576:POKE25345,256"] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            // The RAM callback selects a continuation using the published text
            // pointer, destroys all index registers, and returns either carry.
            let mut alternate = guest_tokens(&mut memory, &mut cpu, ":POKE25345,91");
            alternate.push(0);
            memory.bytes[0x6200..0x6200 + alternate.len()].copy_from_slice(&alternate);
            let mut callback = vec![0x10, 0xff, 0x63, 0x10]; // record the actual public S
            if !source.ends_with("256") {
                callback.extend([0x8e, 0x62, 0, 0x9f, 0xa6]);
            }
            callback.extend([
                0x8e, 0xbe, 0xef, 0x10, 0x8e, 0xde, 0xad, 0xce, 0xca, 0xfe, 0x1c, 0xfe,
            ]);
            if carry {
                callback.extend([0x1a, 1]);
            }
            callback.push(0x39);
            memory.bytes[0x6000..0x6000 + callback.len()].copy_from_slice(&callback);
            let success = execute_direct(&mut memory, &mut cpu, source);
            assert_eq!(success, !source.ends_with("256"), "carry={carry}: {source}");
            assert_eq!(
                memory.bytes[0x6301],
                if success { 91 } else { 0 },
                "carry={carry}: {source}"
            );
            assert_eq!(
                word(&memory, usize::from(symbol("CTL_BASE"))) - word(&memory, 0x6310),
                2
            );
            assert_eq!(cpu.registers.s, 0x7000);
            if !success {
                assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 8);
            }
            assert!(execute_direct(&mut memory, &mut cpu, "POKE25345,77"));
            assert_eq!(memory.bytes[0x6301], 77);
        }
    }
}

#[test]
fn published_statement_entry_retains_direct_machine_return_stack_and_cursor() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    guest_tokens(&mut memory, &mut cpu, "EXEC24576");
    let callback = [
        0x10, 0xff, 0x63, 0x10, 0x8e, 0x62, 0, 0x9f, 0xa6, 0x8e, 0xbe, 0xef, 0x39,
    ];
    memory.bytes[0x6000..0x6000 + callback.len()].copy_from_slice(&callback);
    cpu.registers.x = 0x2dc;
    let mut code = Vec::new();
    call(&mut code, 0x84d6);
    memory.execute(&mut cpu, &code);
    assert_eq!(word(&memory, 0x6310), 0x6ffe);
    assert_eq!(word(&memory, 0xa6), 0x6200);
    assert_eq!(cpu.registers.x, 0xbeef);
    assert_eq!(cpu.registers.s, 0x7000);
}

// Independent arithmetic model for the shared physical byte/mask helper.
// All 256 by 256 byte-valued coordinate pairs are exercised in every mode;
// the varying pen covers all four packed colours at every field position.
#[test]
fn shared_graphics_address_kernel_preserves_every_coordinate_and_register_contract() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let mut code = Vec::new();
    call(&mut code, symbol("GFX_ADDRESS"));
    for mode in 0_u8..=4 {
        let stride = if mode == 1 || mode >= 3 { 32_u16 } else { 16 };
        memory.bytes[0xb6] = mode;
        memory.bytes[0xb9] = u8::try_from(stride).unwrap();
        set_word(&mut memory, 0xba, 0x600);
        for row in 0_u8..=255 {
            for column in 0_u8..=255 {
                let pen = (row ^ column) & 3;
                memory.bytes[0xb4] = pen;
                memory.bytes[0xc4] = column;
                memory.bytes[0xc6] = row;
                cpu.registers.a = 0x93;
                cpu.registers.b = 0x57;
                cpu.registers.x = 0x2468;
                cpu.registers.u = 0x1357;
                cpu.registers.cc = 0xff;
                memory.execute(&mut cpu, &code);
                let x = if mode == 4 { column } else { column / 2 };
                let y = if mode >= 2 { row } else { row / 2 };
                let colour = mode & 1 != 0;
                let divisor = if colour { 4 } else { 8 };
                let mask = if colour {
                    0xc0 >> ((x & 3) * 2)
                } else {
                    0x80 >> (x & 7)
                };
                let address = 0x600 + u16::from(y) * stride + u16::from(x / divisor);
                assert_eq!(cpu.registers.y, address, "mode={mode}, ({column},{row})");
                assert_eq!(word(&memory, 0xbd), u16::from(x));
                assert_eq!(word(&memory, 0xbf), u16::from(y));
                assert_eq!(memory.bytes[0x86], mask);
                assert_eq!(memory.bytes[0xb5], (0x55 * pen) & mask);
                assert_eq!(cpu.registers.d(), 0x9357);
                assert_eq!(cpu.registers.x, 0x2468);
                assert_eq!(cpu.registers.u, 0x1357);
                assert_eq!(cpu.registers.s, 0x7000);
                assert_eq!(cpu.registers.cc & 0x0f, 0);
            }
        }
    }
    // The zero-address case retains the original helper's Z result.
    memory.bytes[0xc4] = 0;
    memory.bytes[0xc6] = 0;
    set_word(&mut memory, 0xba, 0);
    memory.execute(&mut cpu, &code);
    assert_eq!(cpu.registers.y, 0);
    assert_eq!(cpu.registers.cc & 0x0f, 4);
}
#[test]
fn native_expression_power_uses_every_integer_and_fraction_bit_without_losing_caller_state() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    set_word(&mut memory, 0x1d, 0x1e0a);
    set_word(&mut memory, 0x1f, 0x1e0a);
    memory.bytes[0x1e03..0x1e05].copy_from_slice(b"A\0");
    guest_tokens(&mut memory, &mut cpu, "(-1)^A");
    let mut code = vec![0x8e, 2, 0xdc];
    call(&mut code, symbol("EVAL"));
    for exponent in 129u8..=144 {
        for bit in 0..32 {
            for negative in [false, true] {
                let mantissa = 0x8000_0000u32 | (1u32 << bit);
                let magnitude = f64::from(mantissa) * 2f64.powi(i32::from(exponent) - 160);
                let value = if negative { -magnitude } else { magnitude };
                let mut packed = [0u8; 5];
                packed[0] = exponent;
                packed[1..].copy_from_slice(&mantissa.to_be_bytes());
                packed[1] = (packed[1] & 0x7f) | if negative { 0x80 } else { 0 };
                memory.bytes[0x1e05..0x1e0a].copy_from_slice(&packed);
                memory.bytes[usize::from(symbol("ERROR_CODE"))] = 0;
                cpu.registers.a = 0x12;
                cpu.registers.b = 0x34;
                cpu.registers.y = 0x5678;
                cpu.registers.u = 0x4321;
                memory.execute_with_budget(&mut cpu, &code, 1_048_576);
                let integer = value.fract() == 0.0 && (-32768.0..=32767.0).contains(&value);
                assert_eq!(cpu.registers.cc & C == 0, integer, "power exponent {value}");
                if integer {
                    let expected: f64 = if value % 2.0 == 0.0 { 1.0 } else { -1.0 };
                    assert_eq!(
                        unpacked_number(&memory).to_bits(),
                        expected.to_bits(),
                        "power exponent {value}"
                    );
                    assert_eq!(memory.bytes[usize::from(cpu.registers.x)], 0);
                }
                assert_eq!((cpu.registers.a, cpu.registers.b), (0x12, 0x34));
                assert_eq!((cpu.registers.y, cpu.registers.u), (0x5678, 0x4321));
                assert_eq!(cpu.registers.s, 0x7000);
                assert_eq!(word(&memory, 0x0b), 0x1a9);
            }
        }
    }
}

#[test]
fn native_expression_string_relations_share_result_ownership_and_preserve_the_public_caller() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let words = ["", "A", "AA", "AB", "B", "BA", "ZZZ"];
    for left in words {
        for right in words {
            for operator in ["<", "=", ">", "<=", "<>", ">="] {
                empty_programme(&mut memory);
                set_word(&mut memory, 0x27, 0x7ffe);
                set_word(&mut memory, 0x23, 0x7ffe);
                let source = format!(
                    "LEFT$(\"{left}Z\",{}){operator}RIGHT$(\"Z{right}\",{})",
                    left.len(),
                    right.len()
                );
                guest_tokens(&mut memory, &mut cpu, &source);
                let mut code = vec![0x8e, 2, 0xdc];
                call(&mut code, symbol("EVAL"));
                cpu.registers.a = 0x12;
                cpu.registers.b = 0x34;
                cpu.registers.y = 0x5678;
                cpu.registers.u = 0x4321;
                memory.execute_with_budget(&mut cpu, &code, 1_048_576);
                assert_eq!(cpu.registers.cc & C, 0, "{source}");
                let expected = match operator {
                    "<" => left < right,
                    "=" => left == right,
                    ">" => left > right,
                    "<=" => left <= right,
                    "<>" => left != right,
                    _ => left >= right,
                };
                let result: f64 = if expected { -1.0 } else { 0.0 };
                assert_eq!(
                    unpacked_number(&memory).to_bits(),
                    result.to_bits(),
                    "{source}"
                );
                assert_eq!(memory.bytes[0x06], 0);
                assert_eq!(memory.bytes[usize::from(cpu.registers.x)], 0);
                assert_eq!((cpu.registers.a, cpu.registers.b), (0x12, 0x34));
                assert_eq!((cpu.registers.y, cpu.registers.u), (0x5678, 0x4321));
                assert_eq!(cpu.registers.s, 0x7000);
                assert_eq!(word(&memory, 0x0b), 0x1a9);
            }
        }
    }
}

#[test]
fn native_expression_string_result_allocation_unwinds_and_recovers_as_one_scope() {
    for expression in [
        "LEFT$(\"AB\",2)",
        "RIGHT$(\"AB\",2)",
        "MID$(\"AB\",1,2)",
        "STRING$(2,65)",
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        store_line(&mut memory, &mut cpu, 10, &format!("A$={expression}"));
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR 1"));
        assert!(
            !execute_direct(&mut memory, &mut cpu, "RUN"),
            "{expression}"
        );
        assert_eq!(
            memory.bytes[usize::from(symbol("ERROR_CODE"))],
            26,
            "{expression}"
        );
        assert_eq!(word(&memory, 0x0b), 0x1a9);
        assert_eq!(cpu.registers.s, 0x7000);
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR 50"));
        assert!(execute_direct(&mut memory, &mut cpu, "RUN"), "{expression}");
        let descriptor = usize::from(word(&memory, 0x1b)) + 2;
        assert_eq!(memory.bytes[descriptor], 2, "{expression}");
        let chars = usize::from(word(&memory, descriptor + 2));
        assert_eq!(
            &memory.bytes[chars..chars + 2],
            if expression.starts_with("STRING") {
                b"AA"
            } else {
                b"AB"
            }
        );
        assert_eq!(word(&memory, 0x0b), 0x1a9);
    }
}

#[test]
fn using_format_descriptor_and_payload_remain_authoritative_across_argument_callbacks() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/using-cursor-observations.json"
    ))
    .unwrap();
    let cases = facts["cases"].as_array().unwrap();
    assert_eq!(cases.len(), 8);
    for (id, expression, before, mutation) in [
        ("temporary-pointer", "\"#A#\"", "", "8e6320bf01ab"),
        ("temporary-payload", "\"#A#\"", "", "be01ab865aa701"),
        ("borrowed-pointer", "A$", "A$=\"#A#\"", "9e1bcc6320ed04"),
        ("borrowed-payload", "A$", "A$=\"#A#\"", "9e1bae04865aa701"),
        (
            "array-pointer-relocated",
            "A$(1)",
            "DIM A$(1):A$(1)=\"#A#\"",
            "9e1dcc6320ed0e",
        ),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        if !before.is_empty() {
            assert!(execute_direct(&mut memory, &mut cpu, before));
        }
        let mut routine = hex::decode("7c6330").unwrap();
        routine.extend(hex::decode(mutation).unwrap());
        routine.extend(hex::decode("cc0001bd8c3739").unwrap());
        memory.bytes[0x6000..0x6000 + routine.len()].copy_from_slice(&routine);
        memory.bytes[0x6320..0x6323].copy_from_slice(b"#Z#");
        memory.bytes[0x6330] = 0;
        set_word(&mut memory, 0xb0, 0x134);
        set_word(&mut memory, 0x134, 0x6000);
        memory.output.clear();
        assert!(
            execute_direct(
                &mut memory,
                &mut cpu,
                &format!("PRINT#-2,USING{expression};USR0(Z+1);2;")
            ),
            "{expression}/{mutation}"
        );
        let fact = cases.iter().find(|fact| fact["id"] == id).unwrap();
        assert_eq!(
            memory.output,
            fact["output"].as_str().unwrap().as_bytes(),
            "{id}"
        );
        assert_eq!(fact["errors"], serde_json::json!([]));
        assert_eq!(fact["callbackCalled"], true);
        assert_eq!(memory.bytes[0x6330], 1);
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn using_authoritative_format_survives_collection_and_pattern_reuse() {
    for (before, expression) in [
        ("CLEAR50:A$=CHR$(35)+\"A#\":Q$=STRING$(40,65):Q$=\"\"", "A$"),
        (
            "CLEAR50:DIM A$(1):A$(1)=CHR$(35)+\"A#\":Q$=STRING$(40,65):Q$=\"\"",
            "A$(1)",
        ),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert!(execute_direct(&mut memory, &mut cpu, before));
        let old_descriptor = if expression == "A$" {
            usize::from(word(&memory, 0x1b)) + 2
        } else {
            usize::from(word(&memory, 0x1d)) + 12
        };
        let old_payload = word(&memory, old_descriptor + 2);
        memory.output.clear();
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            &format!("PRINT#-2,USING{expression};LEN(STRING$(47,65))-46;Z+2;3;4;")
        ));
        assert_eq!(memory.output, b"1A23A4");
        let descriptor = if expression == "A$" {
            usize::from(word(&memory, 0x1b)) + 2
        } else {
            usize::from(word(&memory, 0x1d)) + 12
        };
        assert_ne!(
            word(&memory, descriptor + 2),
            old_payload,
            "the format payload really moved during collection"
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn using_descriptor_extent_bounds_runs_prefixes_and_exponent_lookahead() {
    for (pattern, after, arguments, expected) in [
        ("#", "###", "1;", "1"),
        ("##", "###", "1;", " 1"),
        ("**", "$##", "1;", "*1"),
        ("$$", "##", "1;", "$1"),
        ("!", "#", "\"Z\";", "Z"),
        ("%%", " %", "\"Z\";", "Z "),
        ("*", "*#", "", "*\r"),
        ("$", "$#", "", "$\r"),
        (".", "#", "", ".\r"),
        ("%", "%", "", "%\r"),
        ("% ", "%", "", "% \r"),
        ("##^^^", "^", "1;", " 1^^^"),
        ("#.", "#", "1;", "1."),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert!(execute_direct(&mut memory, &mut cpu, "A$=\"A\""));
        let descriptor = usize::from(word(&memory, 0x1b)) + 2;
        memory.bytes[descriptor] = u8::try_from(pattern.len()).unwrap();
        set_word(&mut memory, descriptor + 2, 0x6320);
        let payload = format!("{pattern}{after}");
        memory.bytes[0x6320..0x6320 + payload.len()].copy_from_slice(payload.as_bytes());
        memory.output.clear();
        assert!(
            execute_direct(
                &mut memory,
                &mut cpu,
                &format!("PRINT#-2,USING A$;{arguments}")
            ),
            "{pattern:?}"
        );
        assert_eq!(
            memory.output,
            expected.as_bytes(),
            "{pattern:?} with outside bytes {after:?}"
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn using_remaining_cursor_tracks_descriptor_length_changes() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/using-length-observations.json"
    ))
    .unwrap();
    let cases = facts["cases"].as_array().unwrap();
    assert_eq!(cases.len(), 6);
    for fact in cases {
        let length = u8::try_from(fact["replacementLength"].as_u64().unwrap()).unwrap();
        let expected = fact["output"].as_str().unwrap();
        for (expression, before, prefix, suffix) in [
            ("\"#A#\"", "", "86", "b701a98e6342bf01ab"),
            ("A$", "A$=\"#A#\"", "9e1b86", "a702cc6342ed04"),
        ] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            if !before.is_empty() {
                assert!(execute_direct(&mut memory, &mut cpu, before));
            }
            let mut routine = hex::decode("7c6330").unwrap();
            routine.extend(hex::decode(prefix).unwrap());
            routine.push(length);
            routine.extend(hex::decode(suffix).unwrap());
            routine.extend(hex::decode("cc0001bd8c3739").unwrap());
            memory.bytes[0x6000..0x6000 + routine.len()].copy_from_slice(&routine);
            memory.bytes[0x6340..0x634a].copy_from_slice(b"PQ#Z#Q#R#S");
            memory.bytes[0x6330] = 0;
            set_word(&mut memory, 0xb0, 0x134);
            set_word(&mut memory, 0x134, 0x6000);
            memory.output.clear();
            assert!(execute_direct(
                &mut memory,
                &mut cpu,
                &format!("PRINT#-2,USING{expression};USR0(1);2;")
            ));
            assert_eq!(
                memory.output,
                expected.as_bytes(),
                "{expression}, length {length}"
            );
            assert_eq!(memory.bytes[0x6330], 1);
            canonical_assert_empty(&memory);
            assert_eq!(cpu.registers.s, 0x7000);
        }
    }
}

#[test]
fn using_empty_descriptor_mutation_finishes_or_reports_fc_with_more_values() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/using-empty-mutation-observations.json"
    ))
    .unwrap();
    let cases = facts["cases"].as_array().unwrap();
    assert_eq!(cases.len(), 2);
    for (more, fact) in [false, true].into_iter().zip(cases) {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        let routine = hex::decode("7c63308600b701a9cc0001bd8c3739").unwrap();
        memory.bytes[0x6000..0x6000 + routine.len()].copy_from_slice(&routine);
        memory.bytes[0x6330] = 0;
        set_word(&mut memory, 0xb0, 0x134);
        set_word(&mut memory, 0x134, 0x6000);
        memory.output.clear();
        let source = if more {
            "PRINT#-2,USING\"#A#\";USR0(1);2;"
        } else {
            "PRINT#-2,USING\"#A#\";USR0(1);"
        };
        assert_eq!(execute_direct(&mut memory, &mut cpu, source), !more);
        assert_eq!(
            memory.output,
            fact["firstCharacter"].as_str().unwrap().as_bytes()
        );
        assert_eq!(memory.bytes[0x6330], 1);
        if more {
            assert_eq!(fact["errors"], serde_json::json!(["FC"]));
            assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 8);
        }
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
        assert!(execute_direct(&mut memory, &mut cpu, "Z=VAL(\"12\")"));
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_number(12.0));
    }
}

#[test]
fn collection_leaves_static_descriptors_above_memtop_untouched_without_reading_their_payload() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/static-string-span.json"
    ))
    .unwrap();
    let cases = facts["cases"].as_array().unwrap();
    assert_eq!(cases.len(), 6);
    for fact in cases {
        let address = u16::try_from(fact["staticAddress"].as_u64().unwrap()).unwrap();
        let length = u8::try_from(fact["length"].as_u64().unwrap()).unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR50,24000"));
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "Q$=STRING$(40,65):Q$=\"\":A$=CHR$(90):M=VARPTR(A$)"
        ));
        let descriptor = usize::from(word(&memory, 0x1b)) + 7 + 2;
        memory.bytes[descriptor] = length;
        set_word(&mut memory, descriptor + 2, address);
        assert!(
            execute_direct(&mut memory, &mut cpu, "B$=STRING$(49,65)"),
            "{address:04x}"
        );
        assert_eq!(fact["errors"], serde_json::json!([]));
        assert_eq!(
            u64::from(memory.bytes[descriptor]),
            fact["descriptors"]["A"]["length"].as_u64().unwrap()
        );
        assert_eq!(
            u64::from(word(&memory, descriptor + 2)),
            fact["descriptors"]["A"]["pointer"].as_u64().unwrap()
        );
        assert_eq!(
            u64::from(word(&memory, 0x23)),
            fact["fretop"].as_u64().unwrap()
        );
        let result = numeric_scalar(&memory, [b'B', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([result[2], result[3]]));
        assert_eq!(result[0], 49);
        assert_eq!(&memory.bytes[pointer..pointer + 49], &[b'A'; 49]);
        canonical_assert_empty(&memory);
    }
}

#[test]
fn native_macros_latch_payload_pointer_but_observe_later_payload_edits() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/macro-cursor-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let id = fact["id"].as_str().unwrap();
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        m.execute_with_budget(&mut c, &init, 1_000_000);
        let callback = hex::decode(fact["callbackHex"].as_str().unwrap()).unwrap();
        m.bytes[0x6000..0x6000 + callback.len()].copy_from_slice(&callback);
        let payload = hex::decode(fact["payloadHex"].as_str().unwrap()).unwrap();
        m.bytes[0x6500..0x6500 + payload.len()].copy_from_slice(&payload);
        m.bytes[0x6500 + payload.len() - 1] = b'9';
        let macro_text = fact["macro"].as_str().unwrap();
        let expression = format!(
            "\"{}\"",
            macro_text.replace("USR", "\"+CHR$(255)+CHR$(161)+\"")
        );
        assert!(execute_direct(&mut m, &mut c, "DEFUSR0=24576"), "{id}");
        let scalar = fact["owner"].as_str().unwrap() == "scalar";
        if scalar {
            assert!(
                execute_direct(&mut m, &mut c, &format!("M$={expression}")),
                "{id}"
            );
        }
        assert!(execute_direct(&mut m, &mut c, "DIM A(0):A(0)=1"), "{id}");
        let domain = fact["domain"].as_str().unwrap().to_uppercase();
        let argument = if scalar { "M$" } else { &expression };
        let expected_success = fact["errors"].as_array().unwrap().is_empty();
        assert_eq!(
            execute_direct_with_budget(&mut m, &mut c, &format!("{domain}{argument}"), 8_000_000),
            expected_success,
            "{id}: error {}",
            m.bytes[0x3fd]
        );
        if !expected_success {
            assert_eq!(candidate_error_index(&m), 2, "{id}");
        }
        assert_eq!(
            u64::from(m.bytes[0x6340]),
            fact["callbackCount"].as_u64().unwrap(),
            "{id}"
        );
        assert_eq!(
            serde_json::json!([word(&m, 0xc7), word(&m, 0xc9)]),
            fact["cursor"],
            "{id}"
        );
        for (address, wanted) in fact["music"].as_object().unwrap() {
            let address = usize::from_str_radix(address, 16).unwrap();
            assert_eq!(
                u64::from(m.bytes[address]),
                wanted.as_u64().unwrap(),
                "{id}: {address:04x}"
            );
        }
        assert_eq!(word(&m, usize::from(symbol("STR_ROOTS"))), 0, "{id}");
        assert_eq!(c.registers.s, 0x7000, "{id}");
    }
}

#[test]
fn native_macro_extent_bounds_unterminated_payload_without_a_copy() {
    for (domain, payload) in [("DRAW", &b"R2   "[..]), ("PLAY", &b"L2   "[..])] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        m.execute_with_budget(&mut c, &init, 1_000_000);
        assert!(execute_direct(&mut m, &mut c, "M$=\"X\""));
        let value = usize::from(word(&m, 0x1b)) + 2;
        m.bytes[value] = u8::try_from(payload.len()).unwrap();
        set_word(&mut m, value + 2, 0x6500);
        m.bytes[0x6500..0x6600].fill(b'X');
        m.bytes[0x6500..0x6500 + payload.len()].copy_from_slice(payload);
        assert!(
            execute_direct_with_budget(&mut m, &mut c, &format!("{domain}M$"), 8_000_000),
            "{domain}"
        );
        assert_eq!(word(&m, 0xc7), if domain == "DRAW" { 130 } else { 128 });
        assert_eq!(m.bytes[0xe1], if domain == "PLAY" { 2 } else { 4 });
        assert_eq!(&m.bytes[0x6500..0x6500 + payload.len()], payload);
        assert!(
            m.bytes[0x6500 + payload.len()..0x6600]
                .iter()
                .all(|b| *b == b'X')
        );
        assert_eq!(word(&m, usize::from(symbol("STR_ROOTS"))), 0);
        assert_eq!(c.registers.s, 0x7000);
    }
}

#[test]
fn native_macro_variable_scan_publishes_continuation_before_live_evaluation() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/macro-variable-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let id = fact["id"].as_str().unwrap();
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        m.execute_with_budget(&mut c, &init, 1_000_000);
        let code = hex::decode(fact["callbackHex"].as_str().unwrap()).unwrap();
        m.bytes[0x6000..0x6000 + code.len()].copy_from_slice(&code);
        assert!(execute_direct(
            &mut m,
            &mut c,
            "DEFUSR0=24576:M$=\"X\":DIM A(2):A(0)=1:A(1)=3:A(2)=5:Q=4"
        ));
        let payload = hex::decode(fact["payloadHex"].as_str().unwrap()).unwrap();
        m.bytes[0x6500..0x6500 + payload.len()].copy_from_slice(&payload);
        let value = usize::from(word(&m, 0x1b)) + 2;
        m.bytes[value] = u8::try_from(payload.len()).unwrap();
        set_word(&mut m, value + 2, 0x6500);
        let success = fact["errors"].as_array().unwrap().is_empty();
        assert_eq!(
            execute_direct_with_budget(&mut m, &mut c, "DRAW M$", 8_000_000),
            success,
            "{id}"
        );
        if !success {
            assert_eq!(candidate_error_index(&m), 2, "{id}");
        }
        assert_eq!(
            u64::from(m.bytes[0x6340]),
            fact["callbackCount"].as_u64().unwrap(),
            "{id}"
        );
        assert_eq!(
            u64::from(m.bytes[0x6341]),
            fact["remainingAtCallback"].as_u64().unwrap(),
            "{id}"
        );
        if let Some(offset) = fact["sourceOffsetAtCallback"].as_u64() {
            assert_eq!(
                u64::from(word(&m, 0x6342) - word(&m, 0x6344)),
                offset,
                "{id}"
            );
        }
        assert_eq!(
            serde_json::json!([word(&m, 0xc7), word(&m, 0xc9)]),
            fact["cursor"],
            "{id}"
        );
        assert_eq!(word(&m, usize::from(symbol("STR_ROOTS"))), 0, "{id}");
        assert_eq!(c.registers.s, 0x7000, "{id}");
    }
}

#[test]
fn native_bounded_text_contexts_keep_outer_scope_on_nested_failure() {
    for inner_nodes in [0, 1, 2] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        let root = usize::from(symbol("STR_ROOTS"));
        set_word(&mut m, 0x7100, 0);
        set_word(&mut m, 0x7102, 0x6501);
        set_word(&mut m, root, 0x7100);
        // Allocate genuine contexts below the active evaluator boundary,
        // then fail nonlocally from an authored primary-expression hook.
        if inner_nodes != 0 {
            let mut hook = Vec::new();
            for _ in 0..inner_nodes {
                hook.extend_from_slice(&[0x32, 0x7c, 0xfc]);
                hook.extend_from_slice(&symbol("STR_ROOTS").to_be_bytes());
                hook.extend_from_slice(&[0xed, 0xe4, 0xcc, 0x65, 0x01, 0xed, 0x62, 0x10, 0xff]);
                hook.extend_from_slice(&symbol("STR_ROOTS").to_be_bytes());
            }
            hook.push(0x7e);
            hook.extend_from_slice(&symbol("NATIVE_FAIL").to_be_bytes());
            m.bytes[0x6400..0x6400 + hook.len()].copy_from_slice(&hook);
            m.bytes[0x18b..0x18e].copy_from_slice(&[0x7e, 0x64, 0]);
        }
        m.bytes[0x6500..0x6505].copy_from_slice(b"(1)XX");
        c.registers.a = 0xa5;
        c.registers.b = 0x5a;
        c.registers.y = 0x1357;
        c.registers.u = 0x2468;
        let mut code = vec![0x8e, 0x65, 0];
        call(&mut code, symbol("EVAL"));
        m.execute_with_budget(&mut c, &code, 1_000_000);
        assert_ne!(c.registers.cc & C, 0, "{inner_nodes}");
        assert_eq!(word(&m, root), 0x7100, "{inner_nodes}");
        assert_eq!(
            (
                c.registers.a,
                c.registers.b,
                c.registers.y,
                c.registers.u,
                c.registers.s
            ),
            (0xa5, 0x5a, 0x1357, 0x2468, 0x7000)
        );
        m.bytes[0x18b] = 0x39;
        m.bytes[0x6500] = b'9';
        m.execute_with_budget(&mut c, &code, 1_000_000);
        assert_eq!(c.registers.cc & C, 0);
        assert_eq!(word(&m, root), 0x7100);
        assert_eq!(c.registers.x, 0x6501);
    }
    // A value below the live stack is inactive private workspace, even when
    // its following word happens to match the requested text address.
    let mut m = Memory::new();
    let mut c = Cpu::default();
    empty_programme(&mut m);
    set_word(&mut m, usize::from(symbol("STR_ROOTS")), 0x5a5a);
    set_word(&mut m, 0x5a5c, 0x6500);
    m.bytes[0x6500] = b'Q';
    c.registers.b = 0x5a;
    c.registers.y = 0x1357;
    c.registers.u = 0x2468;
    let mut code = vec![0x8e, 0x65, 0];
    call(&mut code, symbol("TEXT_READ"));
    m.execute_with_budget(&mut c, &code, 1_000_000);
    assert_eq!(
        (
            c.registers.a,
            c.registers.b,
            c.registers.x,
            c.registers.y,
            c.registers.u,
            c.registers.s
        ),
        (b'Q', 0x5a, 0x6500, 0x1357, 0x2468, 0x7000)
    );
    assert_eq!(word(&m, usize::from(symbol("STR_ROOTS"))), 0x5a5a);
}

#[test]
fn val_reads_only_the_descriptor_extent_and_restores_an_outer_text_context() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/val-extent-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let text = fact["text"].as_str().unwrap();
        let after = fact["outsideExtent"].as_str().unwrap();
        let expected = hex::decode(fact["packedResult"].as_str().unwrap()).unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        assert!(execute_direct(&mut memory, &mut cpu, "A$=\"A\""));
        let descriptor = usize::from(word(&memory, 0x1b)) + 2;
        memory.bytes[descriptor] = u8::try_from(text.len()).unwrap();
        set_word(&mut memory, descriptor + 2, 0x6320);
        let payload = format!("{text}{after}");
        memory.bytes[0x6320..0x6320 + payload.len()].copy_from_slice(payload.as_bytes());
        set_word(&mut memory, 0x7100, 0);
        set_word(&mut memory, 0x7102, 0x6340);
        set_word(&mut memory, usize::from(symbol("STR_ROOTS")), 0x7100);
        assert!(
            execute_direct(&mut memory, &mut cpu, "Z=VAL(A$)"),
            "{text:?}"
        );
        let actual = numeric_scalar(&memory, [b'Z', 0]);
        // An exponent of zero denotes zero; the reference leaves unspecified
        // mantissa bytes in that case. Nonzero results compare every bit.
        if expected[0] == 0 {
            assert_eq!(actual[0], 0, "{text:?}");
        } else {
            assert_eq!(actual.as_slice(), expected.as_slice(), "{text:?}");
        }
        assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0x7100);
        assert_eq!(word(&memory, 0x7102), 0x6340);
        assert_eq!(word(&memory, 0x0b), 0x01a9);
        assert_eq!(word(&memory, 0x0d), 0x01a4);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn val_restores_text_scope_after_decimal_and_nonlocal_radix_failures() {
    for bad in ["1E128", "&H10000", "&O200000"] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        set_word(&mut memory, 0x7100, 0);
        set_word(&mut memory, 0x7102, 0x6340);
        set_word(&mut memory, usize::from(symbol("STR_ROOTS")), 0x7100);
        assert!(!execute_direct(
            &mut memory,
            &mut cpu,
            &format!("Z=VAL(\"{bad}\")")
        ));
        assert_eq!(
            word(&memory, usize::from(symbol("STR_ROOTS"))),
            0x7100,
            "{bad}"
        );
        assert_eq!(word(&memory, 0x0b), 0x01a9);
        assert_eq!(word(&memory, 0x0d), 0x01a4);
        assert_eq!(cpu.registers.s, 0x7000);
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "Z=VAL(\"12\")+VAL(\"&H3\")"
        ));
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_number(15.0));
        assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0x7100);
        assert_eq!(word(&memory, 0x0b), 0x01a9);
        assert_eq!(word(&memory, 0x0d), 0x01a4);
    }
}

#[test]
fn val_uses_constant_stack_space_for_its_bounded_source() {
    let mut depths = Vec::new();
    for length in [1_u8, 64, 255] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        memory.bytes[0x6400..0x6500].fill(b' ');
        memory.bytes[0x6400] = b'1';
        memory.bytes[0x6400 + usize::from(length)] = b'9';
        let payload = memory.bytes[0x6400..0x6500].to_vec();
        memory.bytes[0x6310] = length;
        set_word(&mut memory, 0x6312, 0x6400);
        set_word(&mut memory, 0x52, 0x6310);
        set_word(&mut memory, 0x50, 0x6400);
        memory.bytes[0x4f] = length;
        memory.bytes[6] = 0xff;
        let mut code = Vec::new();
        call(
            &mut code,
            install_owned_string_probe(&mut memory, "STRING_VAL"),
        );
        code.extend([0x8e, 0x63, 0x00]);
        call(&mut code, symbol("FAC_STORE"));
        memory.bytes[0x2000..0x2000 + code.len()].copy_from_slice(&code);
        cpu.registers.pc = 0x2000;
        cpu.registers.s = 0x7000;
        cpu.registers.u = 0x6543;
        let end = 0x2000 + u16::try_from(code.len()).unwrap();
        let mut lowest = cpu.registers.s;
        for _ in 0..32768 {
            if cpu.registers.pc == end {
                break;
            }
            cpu.step(&mut memory).unwrap();
            lowest = lowest.min(cpu.registers.s);
        }
        assert_eq!(cpu.registers.pc, end);
        assert_eq!(cpu.registers.s, 0x7000);
        assert_eq!(cpu.registers.u, 0x6543);
        assert_eq!(&memory.bytes[0x6300..0x6305], &packed_number(1.0));
        assert_eq!(&memory.bytes[0x6400..0x6500], payload.as_slice());
        canonical_assert_empty(&memory);
        depths.push(lowest);
    }
    assert!(
        depths.iter().all(|depth| *depth == depths[0]),
        "payload length must not allocate stack bytes: {depths:?}"
    );
}

#[test]
fn native_macro_collection_moves_descriptor_but_retains_active_payload_cursor() {
    let mut m = Memory::new();
    let mut c = Cpu::default();
    empty_programme(&mut m);
    let mut init = Vec::new();
    call(&mut init, symbol("SETUP"));
    m.execute_with_budget(&mut c, &init, 1_000_000);
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/macro-collection-observation.json"
    ))
    .unwrap();
    let fact = &facts["cases"][0];
    let callback = hex::decode(fact["callbackHex"].as_str().unwrap()).unwrap();
    m.bytes[0x6000..0x6000 + callback.len()].copy_from_slice(&callback);
    let macro_text = fact["macro"].as_str().unwrap();
    let source = format!(
        "\"{}\"",
        macro_text
            .replace("USR", "\"+CHR$(255)+CHR$(161)+\"")
            .replace("LEN", "\"+CHR$(255)+CHR$(141)+\"")
            .replace("STRING$", "\"+CHR$(255)+CHR$(160)+\"")
    );
    for statement in [
        "DEFUSR0=24576".to_string(),
        "CLEAR180".to_string(),
        "Z$=STRING$(40,\"Z\")".to_string(),
        format!("M$={source}"),
        "Z$=\"\"".to_string(),
        "DIM A(0):A(0)=1".to_string(),
        "P=VARPTR(M$):POKE25410,PEEK(P+2):POKE25411,PEEK(P+3)".to_string(),
    ] {
        assert!(execute_direct(&mut m, &mut c, &statement), "{statement}");
    }
    assert!(execute_direct_with_budget(
        &mut m, &mut c, "PLAY M$", 8_000_000
    ));
    assert_eq!(m.bytes[0x6340], 1);
    let old = word(&m, 0x6342);
    let moved = word(&m, 0x6344);
    let active = word(&m, 0x6346);
    assert_ne!(old, moved, "fixture must trigger actual collection");
    let reference_offset =
        fact["callbackPublicCursor"].as_u64().unwrap() - fact["oldPayload"].as_u64().unwrap();
    assert_eq!(
        u64::from(active - old),
        reference_offset,
        "continuation remains attached to the active payload"
    );
    assert_eq!(
        (word(&m, 0xc7), word(&m, 0xc9), m.bytes[0xe1], m.bytes[0xe2]),
        (128, 96, 1, 1)
    );
    assert_eq!(word(&m, usize::from(symbol("STR_ROOTS"))), 0);
    assert_eq!(c.registers.s, 0x7000);
}

#[test]
fn next_termination_uses_the_sign_of_every_public_step_byte() {
    for step in 0_u8..=255 {
        for comparison in [-1_i8, 0, 1] {
            for initial_cc in [0, 255] {
                let mut memory = Memory::new();
                let mut cpu = Cpu::default();
                memory.bytes[0x6808] = step;
                cpu.registers.pc = symbol("CTL_NEXT_COMPARE");
                cpu.registers.s = 0x7000;
                cpu.registers.u = 0x6800;
                cpu.registers.a = comparison.to_be_bytes()[0];
                cpu.registers.cc = initial_cc;
                let signed_step = i8::from_be_bytes([step]);
                let complete =
                    (signed_step > 0 && comparison > 0) || (signed_step < 0 && comparison < 0);
                let done = symbol("CTL_NEXT_DONE");
                let repeat = symbol("CTL_NEXT_REPEAT");
                for _ in 0..8 {
                    if cpu.registers.pc == done || cpu.registers.pc == repeat {
                        break;
                    }
                    cpu.step(&mut memory).unwrap();
                }
                assert_eq!(
                    cpu.registers.pc,
                    if complete { done } else { repeat },
                    "step={step:02x}, comparison={comparison}, cc={initial_cc:02x}"
                );
                assert_eq!(cpu.registers.s, 0x7000);
                assert_eq!(cpu.registers.u, 0x6800);
            }
        }
    }
}

#[test]
fn native_expression_owner_survives_nested_literals_arrays_and_string_continuations() {
    for (expression, expected) in [
        ("VAL(HEX$(&H1234))+VAL(STR$(2^3))", 1242.0_f64),
        ("VAL(MID$(STR$(&H1234),2,4))+A(VAL(\"2\"))", 4677.0),
        (
            "INSTR(STRING$(3,65)+\"B\",\"B\")+LEN(RIGHT$(\"ZX\",1))",
            5.0,
        ),
        ("LEFT$(\"XYZ\",1)=RIGHT$(\"AX\",1)", -1.0),
        ("(&H8000+&O177777)-65535", 32768.0),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        assert!(execute_direct(&mut memory, &mut cpu, "DIM A(2):A(2)=17"));
        guest_tokens(&mut memory, &mut cpu, expression);
        let mut code = vec![0x8e, 2, 0xdc];
        call(&mut code, symbol("EVAL"));
        cpu.registers.a = 0x12;
        cpu.registers.b = 0x34;
        cpu.registers.y = 0x5678;
        cpu.registers.u = 0x4321;
        memory.execute_with_budget(&mut cpu, &code, 1_048_576);
        assert_eq!(cpu.registers.cc & C, 0, "{expression}");
        assert_eq!(
            unpacked_number(&memory).to_bits(),
            expected.to_bits(),
            "{expression}"
        );
        assert_eq!((cpu.registers.a, cpu.registers.b), (0x12, 0x34));
        assert_eq!((cpu.registers.y, cpu.registers.u), (0x5678, 0x4321));
        assert_eq!(cpu.registers.s, 0x7000);
        assert_eq!(memory.bytes[usize::from(cpu.registers.x)], 0);
        canonical_assert_empty(&memory);
    }
}

#[test]
fn native_expression_owner_unwinds_string_allocation_then_restores_fn_parameter() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/9a9d423970a90526-allocation-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let body = fact["body"].as_str().unwrap();
        let function = fact["function"].as_bool().unwrap();
        assert_eq!(fact["error"], "OS");
        assert_eq!(fact["temporaryCount"], 0);
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        for line in fact["programme"].as_str().unwrap().split_terminator('\r') {
            let (number, source) = line.split_once(' ').unwrap();
            store_line(&mut memory, &mut cpu, number.parse().unwrap(), source);
        }
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR1"));
        assert!(!execute_direct(&mut memory, &mut cpu, "RUN"), "{body}");
        assert_eq!(
            memory.bytes[usize::from(symbol("ERROR_CODE"))],
            26,
            "{body}"
        );
        if function {
            assert_eq!(
                numeric_scalar(&memory, [b'X', 0]),
                packed_integer(9),
                "{body}"
            );
        }
        assert_eq!(cpu.registers.s, 0x7000);
        canonical_assert_empty(&memory);
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR50"));
        assert!(execute_direct(&mut memory, &mut cpu, "RUN"), "{body}");
        if function {
            assert_eq!(
                numeric_scalar(&memory, [b'X', 0]),
                packed_integer(9),
                "{body}"
            );
        }
        assert_eq!(
            numeric_scalar(&memory, [b'Z', 0]),
            packed_integer(2),
            "{body}"
        );
        canonical_assert_empty(&memory);
    }
}

#[test]
fn native_expression_owner_unwinds_direct_copy_and_mid_detach_without_partial_store() {
    for source in ["A$=\"AB\"", "MID$(A$,1,1)=\"Z\""] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        store_line(&mut memory, &mut cpu, 10, "A$=\"AB\":END");
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR1"));
        assert!(execute_direct(&mut memory, &mut cpu, "RUN"));
        let original = numeric_scalar(&memory, [b'A', 0x80]);
        assert!(!execute_direct(&mut memory, &mut cpu, source), "{source}");
        assert_eq!(
            memory.bytes[usize::from(symbol("ERROR_CODE"))],
            26,
            "{source}"
        );
        assert_eq!(numeric_scalar(&memory, [b'A', 0x80]), original, "{source}");
        assert_eq!(cpu.registers.s, 0x7000);
        canonical_assert_empty(&memory);
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR50"));
        assert!(execute_direct(&mut memory, &mut cpu, "RUN"));
        assert!(execute_direct(&mut memory, &mut cpu, source), "{source}");
        let descriptor = numeric_scalar(&memory, [b'A', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([descriptor[2], descriptor[3]]));
        assert_eq!(
            &memory.bytes[pointer..pointer + 2],
            if source.starts_with("MID") {
                b"ZB"
            } else {
                b"AB"
            }
        );
        canonical_assert_empty(&memory);
    }
}

// Independently round the straight segment to the nearest minor-axis pixel.
// Ties belong to the positive major direction, matching the reference canvas.
#[test]
fn shared_major_axis_raster_matches_geometric_rounding_and_public_workspace() {
    let mut m = Memory::new();
    let mut c = Cpu::default();
    let mut code = vec![0x8e, 0x24, 0x68, 0xce, 0x68, 0x08];
    call(&mut code, symbol("GFX_LINE"));
    for mode in 0..=4_u8 {
        let stride = if mode == 1 || mode >= 3 { 32 } else { 16 };
        m.bytes[0xb6] = mode;
        m.bytes[0xb9] = stride;
        m.bytes[0xb4] = 3;
        set_word(&mut m, 0xba, 0x600);
        for (origin_x, origin_y) in [(127, 95), (128, 96)] {
            for sx in [-1_i32, 1] {
                for sy in [-1_i32, 1] {
                    for dx in 0..=16_i32 {
                        for dy in 0..=16_i32 {
                            let target = (origin_x + sx * dx, origin_y + sy * dy);
                            for (offset, value) in
                                [(0, origin_x), (2, origin_y), (4, target.0), (6, target.1)]
                            {
                                set_word(&mut m, 0x6800 + offset, u16::try_from(value).unwrap());
                            }
                            m.bytes[0x600..0x1e00].fill(0);
                            let start = (
                                origin_x / if mode == 4 { 1 } else { 2 },
                                origin_y / if mode >= 2 { 1 } else { 2 },
                            );
                            let end = (
                                target.0 / if mode == 4 { 1 } else { 2 },
                                target.1 / if mode >= 2 { 1 } else { 2 },
                            );
                            let delta = (end.0 - start.0, end.1 - start.1);
                            let x_major = delta.0.abs() >= delta.1.abs();
                            let (major, minor, direction) = if x_major {
                                (delta.0.abs(), delta.1.abs(), delta.0.signum())
                            } else {
                                (delta.1.abs(), delta.0.abs(), delta.1.signum())
                            };
                            let mut expected = [0_u8; 6144];
                            for step in 0..=major {
                                let minor_step = if major == 0 {
                                    0
                                } else {
                                    (2 * step * minor + major - i32::from(direction < 0))
                                        / (2 * major)
                                };
                                let (x, y) = if x_major {
                                    (
                                        start.0 + delta.0.signum() * step,
                                        start.1 + delta.1.signum() * minor_step,
                                    )
                                } else {
                                    (
                                        start.0 + delta.0.signum() * minor_step,
                                        start.1 + delta.1.signum() * step,
                                    )
                                };
                                let colour = mode & 1 != 0;
                                let divisor = if colour { 4 } else { 8 };
                                let mask = if colour {
                                    0xc0 >> ((x & 3) * 2)
                                } else {
                                    0x80 >> (x & 7)
                                };
                                let address =
                                    usize::try_from(y * i32::from(stride) + x / divisor).unwrap();
                                expected[address] |= mask;
                            }
                            m.execute_with_budget(&mut c, &code, 100_000);
                            assert_eq!(
                                &m.bytes[0x600..0x1e00],
                                &expected,
                                "mode{mode},delta({},{})",
                                sx * dx,
                                sy * dy
                            );
                            assert_eq!(
                                (word(&m, 0xc3), word(&m, 0xc5)),
                                (
                                    u16::try_from(end.0 * if mode == 4 { 1 } else { 2 }).unwrap(),
                                    u16::try_from(end.1 * if mode >= 2 { 1 } else { 2 }).unwrap()
                                )
                            );
                            let physical = if delta.0 == 0 || delta.1 == 0 {
                                start
                            } else {
                                end
                            };
                            assert_eq!(
                                (word(&m, 0xbd), word(&m, 0xbf)),
                                (
                                    u16::try_from(physical.0).unwrap(),
                                    u16::try_from(physical.1).unwrap()
                                )
                            );
                            assert_eq!(
                                (
                                    word(&m, 0x6800),
                                    word(&m, 0x6802),
                                    word(&m, 0x6804),
                                    word(&m, 0x6806)
                                ),
                                (
                                    u16::try_from(target.0).unwrap(),
                                    u16::try_from(target.1).unwrap(),
                                    u16::try_from(target.0).unwrap(),
                                    u16::try_from(target.1).unwrap()
                                )
                            );
                            assert_eq!(
                                (c.registers.x, c.registers.u, c.registers.s),
                                (0x2468, 0x6808, 0x7000)
                            );
                        }
                    }
                }
            }
        }
    }
}

// Authored failure injection at our own block writer proves that the shared EOF
// controller does not mistake an output frame for a partial BASIC input load.
#[test]
fn cassette_shared_eof_failure_preserves_programme_and_recovers() {
    for source in [
        "CLOSE",
        "CSAVE\"X\"",
        "CSAVE\"X\",A",
        "CSAVEM\"X\",24576,24576,24576",
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(&mut memory, &mut cpu, 10, "A=7");
        let end = usize::from(word(&memory, 0x1b));
        let programme = memory.bytes[0x1e01..end].to_vec();
        memory.bytes[usize::from(symbol("TAPE_PREP"))] = 0x39;
        let writer = usize::from(symbol("TAPE_BLOCK_OUT"));
        // LDA <$7C; CMPA #$FF; BNE success; ORCC #1; RTS;
        // success: ANDCC #$FE; RTS. No hardware routine is copied or inferred.
        memory.bytes[writer..writer + 12].copy_from_slice(&[
            0x96, 0x7c, 0x81, 0xff, 0x26, 3, 0x1a, 1, 0x39, 0x1c, 0xfe, 0x39,
        ]);
        if source == "CLOSE" {
            memory.bytes[0x78] = 2;
            memory.bytes[0x79] = 0;
            set_word(&mut memory, 0x7a, 0x1da);
        }
        assert!(
            !execute_direct_with_budget(&mut memory, &mut cpu, source, 4_000_000),
            "{source}"
        );
        assert_eq!(
            memory.bytes[usize::from(symbol("ERROR_CODE"))],
            42,
            "{source}"
        );
        assert_eq!(&memory.bytes[0x1e01..end], programme, "{source}");
        assert_eq!(usize::from(word(&memory, 0x1b)), end, "{source}");
        assert_eq!(memory.bytes[0x7c], 255, "{source}");
        assert_eq!(memory.bytes[0xff21] & 8, 0, "{source}");
        assert_eq!(cpu.registers.s, 0x7000, "{source}");
        // Release only the authored I/O failure. The guest must retry using
        // its retained file state, without host repair of cassette workspace.
        memory.bytes[writer..writer + 3].copy_from_slice(&[0x1c, 0xfe, 0x39]);
        assert!(
            execute_direct_with_budget(&mut memory, &mut cpu, source, 4_000_000),
            "retry {source}"
        );
        assert_eq!(memory.bytes[0x78], 0, "retry {source}");
        assert_eq!(memory.bytes[0xff21] & 8, 0, "retry {source}");
        assert_eq!(&memory.bytes[0x1e01..end], programme, "retry {source}");
        assert_eq!(cpu.registers.s, 0x7000, "retry {source}");
        assert!(execute_direct(&mut memory, &mut cpu, "B=17"), "{source}");
        assert_eq!(
            numeric_scalar(&memory, [b'B', 0]),
            packed_integer(17),
            "{source}"
        );
    }
}

#[test]
fn public_integer_zero_with_retained_exponent_remains_printable() {
    for entry in [0x8b2d, 0x8b30] {
        for value in [0.5, 0.000_000_1] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            enable_guest_printer(&mut memory);
            unpack_to(&mut memory, 0x4f, packed_number(value));
            let exponent = memory.bytes[0x4f];
            let mut conversion = Vec::new();
            call(&mut conversion, entry);
            memory.execute(&mut cpu, &conversion);
            assert_ne!(exponent, 0);
            assert_eq!(memory.bytes[0x4f], exponent);
            assert_eq!(&memory.bytes[0x50..0x54], &[0, 0, 0, 0]);
            let mut printing = Vec::new();
            call_guest_number_printer(&mut printing);
            memory.execute_with_budget(&mut cpu, &printing, 100_000);
            assert_eq!(memory.output, b" 0 ", "entry {entry:04X}, value {value}");
            assert_eq!(cpu.registers.s, 0x7000);
        }
    }
}

#[test]
fn packed_word_transfer_preserves_every_mantissa_byte_and_native_extent() {
    let mut seed = 0x19a7_32d5_u32;
    for exponent in [1, 64, 128, 192, 255] {
        for _ in 0..128 {
            seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
            let bits = seed.to_be_bytes();
            let packed = [exponent, bits[0], bits[1], bits[2], bits[3]];
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            memory.bytes[0x6000..0x6005].copy_from_slice(&packed);
            memory.bytes[0x60ff..0x6106].fill(0xa5);
            cpu.registers.y = 0x2345;
            cpu.registers.u = 0x3456;
            let mut code = vec![0x8e, 0x60, 0];
            call(&mut code, symbol("FAC_LOAD"));
            code.extend([0x8e, 0x61, 0]);
            call(&mut code, symbol("FAC_STORE"));
            memory.execute(&mut cpu, &code);
            assert_eq!(&memory.bytes[0x6100..0x6105], &packed);
            assert_eq!((memory.bytes[0x60ff], memory.bytes[0x6105]), (0xa5, 0xa5));
            assert_eq!(
                (
                    cpu.registers.x,
                    cpu.registers.y,
                    cpu.registers.u,
                    cpu.registers.s
                ),
                (0x6105, 0x2345, 0x3456, 0x7000)
            );
        }
    }
}

#[test]
fn using_reverse_buffer_handles_rounding_carries_with_maximum_fraction_and_commas() {
    for (field, digits) in [
        (".################-", "1000000000.0000000000000000"),
        ("#,.##############-", "1,000,000,000.00000000000000"),
    ] {
        for (value, sign) in [("1E9-.25", " "), ("-(1E9-.25)", "-")] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            assert!(execute_direct(
                &mut memory,
                &mut cpu,
                &format!("PRINT USING\"{field}\";{value}")
            ));
            assert_eq!(
                memory.output,
                format!("%{digits}{sign}\r").as_bytes(),
                "{field} {value}"
            );
            assert_eq!(cpu.registers.s, 0x7000);
        }
    }
}

#[test]
fn native_register_owners_keep_expression_state_across_numeric_calls_and_failures() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    set_word(&mut memory, 0x27, 0x7ffe);
    set_word(&mut memory, 0x23, 0x7ffe);
    set_word(&mut memory, 0x7100, 0);
    set_word(&mut memory, 0x7102, 0x6340);
    set_word(&mut memory, usize::from(symbol("STR_ROOTS")), 0x7100);
    for (source, expected) in [
        ("SQR(4)+LOG(1)+EXP(0)", Some(3.0_f64)),
        ("SIN(0)+ATN(0)", Some(0.0)),
        ("VAL(\"12E1\")+RND(1)", Some(121.0)),
        ("VAL(\"&H10\")+SQR(9)", Some(19.0)),
        ("LOG(-1)", None),
        ("SQR(-1)", None),
        ("EXP(90)", None),
        ("VAL(\"1E128\")", None),
        ("2+3", Some(5.0)),
    ] {
        for (y, u) in [(0, 0), (0x1357, 0x2468), (0xffff, 0xffff)] {
            guest_tokens(&mut memory, &mut cpu, source);
            let mut code = vec![0x8e, 2, 0xdc];
            call(&mut code, symbol("EVAL"));
            cpu.registers.a = 0x93;
            cpu.registers.b = 0x57;
            cpu.registers.y = y;
            cpu.registers.u = u;
            memory.execute_with_budget(&mut cpu, &code, 1_048_576);
            assert_eq!(cpu.registers.cc & C == 0, expected.is_some(), "{source}");
            if let Some(expected) = expected {
                assert_eq!(
                    unpacked_number(&memory).to_bits(),
                    expected.to_bits(),
                    "{source}"
                );
                assert_eq!(memory.bytes[usize::from(cpu.registers.x)], 0, "{source}");
            }
            assert_eq!(cpu.registers.d(), 0x9357, "{source}");
            assert_eq!(
                (cpu.registers.y, cpu.registers.u, cpu.registers.s),
                (y, u, 0x7000),
                "{source}"
            );
            assert_eq!(
                word(&memory, usize::from(symbol("STR_ROOTS"))),
                0x7100,
                "{source}"
            );
            assert_eq!(word(&memory, 0x7102), 0x6340, "{source}");
            assert_eq!(word(&memory, 0x0b), 0x1a9, "{source}");
            assert_eq!(word(&memory, 0x0d), 0x1a4, "{source}");
        }
    }
}

#[test]
fn native_register_owners_keep_arithmetic_stream_continuations_on_success_and_failure() {
    for (stream, success) in [
        (vec![224, 199, 200, 0], true),
        (vec![224, 199, 201, 202, 0], true),
        (vec![224, 199, 199, 224, 0], false),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        let mut code = Vec::new();
        call(&mut code, symbol("FP_RUN"));
        code.extend(&stream);
        cpu.registers.x = 0x4567;
        cpu.registers.y = 0x5678;
        cpu.registers.u = 0x6789;
        memory.execute_with_budget(&mut cpu, &code, 1_048_576);
        assert_eq!(cpu.registers.cc & C == 0, success, "{stream:?}");
        assert_eq!(
            (cpu.registers.x, cpu.registers.u, cpu.registers.s),
            (0x4567, 0x6789, 0x7000)
        );
        assert_eq!(cpu.registers.y, 0x2000 + u16::try_from(code.len()).unwrap());
        if success {
            assert!((unpacked_number(&memory) - 1.0).abs() <= 2e-8);
        }
    }
}

#[test]
fn native_register_owners_keep_public_statement_state_and_failure_atomicity() {
    for source in [
        "PCOPY1,2",
        "PCOPY1,0",
        "PCOPY1,2,3",
        "CLS0",
        "CLS8",
        "CLS5,7",
        "TRON",
        "TROFF",
        "TRON0",
        "TROFF0",
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        memory.bytes[0xbc] = 6;
        memory.bytes[0xaf] = 0xa5;
        memory.bytes[0x400..0x600].fill(0x5a);
        for (index, byte) in memory.bytes[0x600..0xc00].iter_mut().enumerate() {
            *byte = u8::try_from(index & 255).unwrap();
        }
        memory.bytes[0xc00..0x1200].fill(0xa5);
        let screen = memory.bytes[0x400..0x600].to_vec();
        let source_page = memory.bytes[0x600..0xc00].to_vec();
        let target_page = memory.bytes[0xc00..0x1200].to_vec();
        guest_tokens(&mut memory, &mut cpu, source);
        let mut code = vec![0x8e, 2, 0xdc];
        call(&mut code, 0x84d6);
        cpu.registers.a = 0x93;
        cpu.registers.b = 0x57;
        cpu.registers.y = 0x4567;
        cpu.registers.u = 0x5678;
        memory.execute_with_budget(&mut cpu, &code, 1_048_576);
        let success = matches!(source, "PCOPY1,2" | "CLS0" | "CLS8" | "TRON" | "TROFF");
        assert_eq!(cpu.registers.cc & C == 0, success, "{source}");
        assert_eq!(cpu.registers.d(), 0x9357, "{source}");
        assert_eq!(
            (cpu.registers.y, cpu.registers.u, cpu.registers.s),
            (0x4567, 0x5678, 0x7000),
            "{source}"
        );
        if source == "PCOPY1,2" {
            assert_eq!(&memory.bytes[0xc00..0x1200], source_page.as_slice());
        } else {
            assert_eq!(&memory.bytes[0xc00..0x1200], target_page.as_slice());
        }
        assert_eq!(&memory.bytes[0x600..0xc00], source_page.as_slice());
        match source {
            "CLS0" => assert!(memory.bytes[0x400..0x600].iter().all(|&byte| byte == 0x80)),
            "CLS8" => assert!(memory.bytes[0x400..0x600].iter().all(|&byte| byte == 0xff)),
            _ => assert_eq!(&memory.bytes[0x400..0x600], screen.as_slice()),
        }
        assert_eq!(
            memory.bytes[0xaf],
            match source {
                "TRON" => 1,
                "TROFF" => 0,
                _ => 0xa5,
            },
            "{source}"
        );
        canonical_assert_empty(&memory);
    }
}

// Authored mixed-source journey: the array destination remains live while file
// records refill, and subsequent LINE INPUT retains the published CSV cursor.
#[test]
fn input_continuations_keep_array_destinations_and_separate_reply_sources() {
    for block_size in [1, 2, 255] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        for (line, source) in [
            (10, "OPEN\"I\",-1,\"OWNDATA\":DIM A$(1),B(1)"),
            (20, "INPUT\"P\";X$,Y"),
            (30, "INPUT#-1,A$(1),B(1)"),
            (40, "LINE INPUT Z$"),
            (50, "LINE INPUT#-1,W$"),
            (60, "R$=X$+A$(1)+Z$+W$:R=Y+B(1):CLOSE"),
        ] {
            store_line(&mut memory, &mut cpu, line, source);
        }
        supply_original_keyboard(&mut memory, b"K,7\rL\r");
        synthetic_tape(&mut memory, &own_data_cassette(b"F\r9\rT\r", block_size));
        memory.tape_clock = Some(memory.cycles);
        assert!(execute_direct_with_budget(
            &mut memory,
            &mut cpu,
            "RUN",
            64_000_000
        ));
        let value = numeric_scalar(&memory, [b'R', 128]);
        let start = usize::from(u16::from_be_bytes([value[2], value[3]]));
        assert_eq!(&memory.bytes[start..start + usize::from(value[0])], b"KFLT");
        assert_eq!(numeric_scalar(&memory, [b'R', 0]), packed_integer(16));
        assert_eq!(word(&memory, 0x35), 0x02de);
        assert_eq!(memory.bytes[0x78], 0);
        assert_eq!(memory.bytes[0xff21] & 8, 0);
        assert_eq!(cpu.registers.s, 0x7000);
        assert!(execute_direct(&mut memory, &mut cpu, "Q=19"));
        assert_eq!(numeric_scalar(&memory, [b'Q', 0]), packed_integer(19));
    }
}

#[test]
fn native_programme_owners_keep_data_retry_restore_and_cross_line_cursors() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    set_word(&mut memory, 0x27, 0x7ffe);
    set_word(&mut memory, 0x23, 0x7ffe);
    for (line, source) in [
        (10, "DATA 1,2:DATA \"X\""),
        (20, "REM DATA 99"),
        (30, "A$=\"DATA 88\":DATA 3"),
    ] {
        store_line(&mut memory, &mut cpu, line, source);
    }
    assert!(execute_direct(&mut memory, &mut cpu, "RESTORE:READ A,B"));
    assert_eq!(numeric_scalar(&memory, [b'A', 0]), packed_integer(1));
    assert_eq!(numeric_scalar(&memory, [b'B', 0]), packed_integer(2));
    assert_eq!(word(&memory, 0x31), 10);
    let before_failed_field = word(&memory, 0x33);
    assert!(!execute_direct(&mut memory, &mut cpu, "READ C"));
    assert_eq!(word(&memory, 0x33), before_failed_field);
    assert!(execute_direct(&mut memory, &mut cpu, "READ C$,D"));
    let descriptor = numeric_scalar(&memory, [b'C', 0x80]);
    assert_eq!(descriptor[0], 1);
    let text = usize::from(u16::from_be_bytes([descriptor[2], descriptor[3]]));
    assert_eq!(memory.bytes[text], b'X');
    assert_eq!(numeric_scalar(&memory, [b'D', 0]), packed_integer(3));
    assert_eq!(word(&memory, 0x31), 30);
    let end = word(&memory, 0x33);
    for _ in 0..2 {
        assert!(!execute_direct(&mut memory, &mut cpu, "READ E"));
        assert_eq!(word(&memory, 0x31), 30);
        assert_eq!(word(&memory, 0x33), end);
        assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 6);
    }
    assert!(execute_direct(&mut memory, &mut cpu, "RESTORE"));
    assert_eq!(word(&memory, 0x31), 30);
    assert_eq!(word(&memory, 0x33), word(&memory, 0x19) - 1);
    assert!(execute_direct(&mut memory, &mut cpu, "READ Z"));
    assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(1));
    assert_eq!(cpu.registers.s, 0x7000);
}

#[test]
fn native_programme_owners_publish_control_records_only_after_room_checks() {
    for (headroom, success) in [(135_u16, false), (136, true)] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        store_line(&mut memory, &mut cpu, 100, "RETURN");
        // The original caller's saved return/Y/U and sentinel leave CTL_SP here.
        let live_end = 0x6ff8 - headroom;
        set_word(&mut memory, 0x1f, live_end);
        let protected = 0x6f00..usize::from(live_end);
        memory.bytes[protected.clone()].fill(0xa5);
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, "GOSUB100"),
            success,
            "headroom={headroom}"
        );
        assert!(memory.bytes[protected].iter().all(|byte| *byte == 0xa5));
        assert_eq!(cpu.registers.s, 0x7000);
        assert_eq!(
            word(&memory, usize::from(symbol("CTL_SP"))),
            word(&memory, usize::from(symbol("CTL_BASE")))
        );
        if !success {
            assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 12);
        }
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR"));
        assert!(execute_direct(&mut memory, &mut cpu, "Z=42"));
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(42));
    }

    // The cold prompt retains ownership of S across STOP and CONT. The direct
    // library-call helper deliberately supplies a fresh caller stack each time.
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let key = usize::from(symbol("KEYIN"));
    memory.bytes[key..key + 3].copy_from_slice(&[0x7e, 0x65, 0]);
    memory.bytes[0x6500..0x650d].copy_from_slice(&[
        0x34, 0x10, 0xbe, 0x66, 0, 0xa6, 0x80, 0xbf, 0x66, 0, 0x4d, 0x35, 0x90,
    ]);
    set_word(&mut memory, 0x6600, 0x6800);
    let text = concat!(
        "10 T=0:FOR I=1 TO 3\r20 FOR J=1 TO 2\r30 GOSUB100\r",
        "40 NEXT J,I\r50 POKE25345,85:END\r",
        "100 T=T+1:IF T=2 THEN STOP\r110 RETURN\rRUN\rCONT\r"
    );
    memory.bytes[0x6800..0x6800 + text.len()].copy_from_slice(text.as_bytes());
    cpu.reset(&mut memory);
    let mut stopped = false;
    let mut finished = false;
    for _ in 0..8_388_608 {
        if !stopped && memory.bytes[usize::from(symbol("CONT_VALID"))] == 1 {
            stopped = true;
            assert_eq!(numeric_scalar(&memory, [b'T', 0]), packed_integer(2));
            let frame = usize::from(word(&memory, usize::from(symbol("CONT_SP"))));
            assert_eq!(memory.bytes[frame], 0xbd);
            assert_eq!(word(&memory, frame + 1), 30);
            assert_eq!(word(&memory, frame + 5), symbol("EXEC_AFTER_STATEMENT"));
            assert_eq!(memory.bytes[frame + 7], 0x80);
            assert_eq!(memory.bytes[frame + 25], 0x80);
        }
        if memory.bytes[25345] == 85 {
            finished = true;
            break;
        }
        cpu.step(&mut memory).unwrap();
    }
    assert!(stopped && finished);
    assert_eq!(numeric_scalar(&memory, [b'T', 0]), packed_integer(6));
    assert_eq!(
        word(&memory, usize::from(symbol("CTL_SP"))),
        word(&memory, usize::from(symbol("CTL_BASE")))
    );
}

// The rounding oracle uses exact integer division, independent of the guest's
// restoring quotient loop and without a host floating-point approximation.
#[test]
fn native_division_keeps_32_bits_and_one_rounding_decision_across_all_exponents() {
    fn quotient(left: [u8; 5], right: [u8; 5]) -> Option<[u8; 5]> {
        if right[0] == 0 {
            return None;
        }
        if left[0] == 0 {
            return Some([0; 5]);
        }
        let magnitude = |value: [u8; 5]| {
            u64::from(u32::from_be_bytes([
                value[1] | 128,
                value[2],
                value[3],
                value[4],
            ]))
        };
        let (left_mantissa, right_mantissa) = (magnitude(left), magnitude(right));
        let below_one = left_mantissa < right_mantissa;
        let mut exponent = i32::from(left[0]) - i32::from(right[0]) + 129 - i32::from(below_one);
        // The established arithmetic flushes underflow before final rounding.
        if exponent <= 0 {
            return Some([0; 5]);
        }
        if exponent > 255 {
            return None;
        }
        let numerator = left_mantissa << if below_one { 32 } else { 31 };
        let mut rounded = numerator / right_mantissa
            + u64::from((numerator % right_mantissa) * 2 >= right_mantissa);
        if rounded == 1_u64 << 32 {
            rounded >>= 1;
            exponent += 1;
        }
        let bytes = u32::try_from(rounded).unwrap().to_be_bytes();
        Some([
            u8::try_from(exponent).ok()?,
            (bytes[0] & 127) | ((left[1] ^ right[1]) & 128),
            bytes[1],
            bytes[2],
            bytes[3],
        ])
    }
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let mut state = 0x16ea_309b_u32;
    let mut total_cycles = 0_u64;
    let mut max_cycles = 0_u64;
    let mut cases = 0_u64;
    for index in 0..8192_u32 {
        state = state.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
        let mut left = state.to_be_bytes();
        state = state.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
        let mut right = state.to_be_bytes();
        match index % 8 {
            0 => right = left,
            1 => {
                left = [0, 0, 0, 1];
                right = [64, 0, 0, 0];
            }
            2 => {
                left = [127, 255, 255, 255];
                right = [0, 0, 0, 0];
            }
            3 => {
                left = [127, 255, 255, 254];
                right = [127, 255, 255, 255];
            }
            4 => {
                left = [0, 0, 0, 0];
                right = [127, 255, 255, 255];
            }
            _ => {}
        }
        let exponent = u8::try_from(1 + (index / 8) % 255).unwrap();
        let (left_exponent, right_exponent) = match index % 9 {
            0 => (exponent, 129),
            1 => (1, exponent),
            2 => (exponent, 255),
            3 => (255, exponent),
            4 => (128, exponent),
            5 => (exponent, 1),
            6 => (0, exponent),
            7 => (exponent, 0),
            _ => (exponent, exponent),
        };
        let left = [left_exponent, left[0], left[1], left[2], left[3]];
        let right = [right_exponent, right[0], right[1], right[2], right[3]];
        unpack_to(&mut memory, 0x4f, left);
        unpack_to(&mut memory, 0x5c, right);
        memory.bytes[0xd8..0xea].fill(0xa5);
        memory.bytes[0x3d9..0x400].fill(0x5a);
        let mut code = Vec::new();
        call(&mut code, symbol("F_DIV"));
        let before = memory.cycles;
        memory.execute(&mut cpu, &code);
        let cycles = memory.cycles - before;
        total_cycles += cycles;
        max_cycles = max_cycles.max(cycles);
        cases += 1;
        match quotient(left, right) {
            Some(expected) => {
                assert_eq!(cpu.registers.cc & C, 0, "{left:?}/{right:?}");
                let mut pack = vec![0x8e, 0x60, 0];
                call(&mut pack, symbol("FAC_STORE"));
                memory.execute(&mut cpu, &pack);
                assert_eq!(
                    &memory.bytes[0x6000..0x6005],
                    &expected,
                    "{left:?}/{right:?}"
                );
            }
            None => assert_ne!(cpu.registers.cc & C, 0, "range {left:?}/{right:?}"),
        }
        assert_eq!(cpu.registers.s, 0x7000);
        assert_eq!(&memory.bytes[0xd8..0xea], &[0xa5; 18]);
        assert_eq!(&memory.bytes[0x3d9..0x400], &[0x5a; 39]);
    }
    eprintln!("exact division: {cases} cases; {total_cycles} total cycles; {max_cycles} maximum");
}

#[test]
fn native_format_owner_shared_width_keeps_extent_and_reuse() {
    for width in [2_usize, 3, 16, 17, 127, 254, 255] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert!(execute_direct(&mut memory, &mut cpu, "A$=\"A\""));
        let descriptor = usize::from(word(&memory, 0x1b)) + 2;
        memory.bytes[descriptor] = u8::try_from(width).unwrap();
        set_word(&mut memory, descriptor + 2, 0x6320);
        memory.bytes[0x6320..0x6320 + width].fill(b' ');
        memory.bytes[0x6320] = b'%';
        memory.bytes[0x631f + width] = b'%';
        memory.bytes[0x6320 + width] = b'#';
        memory.output.clear();
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "PRINT#-2,USING A$;\"ABC\";\"Z\";"
        ));
        let mut expected = b"ABC"[..width.min(3)].to_vec();
        expected.resize(width, b' ');
        expected.push(b'Z');
        expected.resize(width * 2, b' ');
        assert_eq!(memory.output, expected, "width {width}");
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        "PRINT#-2,USING\"!#%  %#\";\"ABC\";1;\"XY\";2;\"Z\";3;\"\";4;"
    ));
    assert_eq!(memory.output, b"A1XY  2Z3    4");
    canonical_assert_empty(&memory);
    assert_eq!(cpu.registers.s, 0x7000);
}

#[test]
fn native_format_owner_trailing_sign_keeps_distinct_zero_room() {
    // These exact baseline cases distinguish a leading sign from a trailing
    // positive sign before the reverse renderer decides whether zero fits.
    for (pattern, number, expected) in [
        ("#.##+", "0", "0.00+"),
        ("#.##+", ".25", "0.25+"),
        ("$$.##+", "0", "$0.00+"),
        ("$$.##+", ".25", "$0.25+"),
        ("#.##^^^^+", "0", "0.00E+00+"),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            &format!("PRINT#-2,USING\"{pattern}\";{number};")
        ));
        assert_eq!(memory.output, expected.as_bytes(), "{pattern}/{number}");
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn native_format_owner_span_keeps_collision_boundary_and_silent_hooks() {
    for gap in 1_u16..=205 {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        set_word(&mut memory, 0x1f, 0x6800 - gap);
        memory.bytes[0x6700..0x6720].fill(0xa5);
        unpack_to(&mut memory, 0x4f, packed_integer(42));
        memory.bytes[0x6000..0x6004].copy_from_slice(&[0x7c, 0x63, 0x30, 0x39]);
        memory.bytes[0x167..0x16a].copy_from_slice(&[0x7e, 0x60, 0]);
        set_word(&mut memory, usize::from(symbol("STATEMENT_SP")), 0x7000);
        set_word(&mut memory, 0x7004, 0x1a9);
        set_word(&mut memory, 0x700c, 0x6100);
        set_word(&mut memory, 0x6800, 0x6102);
        cpu.registers.pc = symbol("VALUE_STR");
        cpu.registers.s = 0x6800;
        cpu.registers.x = 0x3456;
        cpu.registers.y = 0x4567;
        cpu.registers.u = 0x5678;
        for _ in 0..1_048_576 {
            if matches!(cpu.registers.pc, 0x6100 | 0x6102) {
                break;
            }
            cpu.step(&mut memory).unwrap();
        }
        assert_eq!(
            cpu.registers.pc,
            if gap <= 204 { 0x6100 } else { 0x6102 },
            "gap {gap}"
        );
        assert_eq!(&memory.bytes[0x6700..0x6720], &[0xa5; 32], "gap {gap}");
        assert_eq!(
            memory.bytes[0x6330], 0,
            "STR$ must not call the output hook"
        );
        assert!(memory.output.is_empty());
        if gap <= 204 {
            assert_ne!(cpu.registers.cc & C, 0);
            assert_eq!(cpu.registers.s, 0x700e);
        } else {
            assert_eq!(cpu.registers.s, 0x6802);
            assert_eq!(memory.bytes[6], 255);
            let descriptor = usize::from(word(&memory, 0x52));
            assert_eq!(memory.bytes[descriptor], 3);
            let text = usize::from(word(&memory, descriptor + 2));
            assert_eq!(&memory.bytes[text..text + 3], b" 42");
        }
    }
}

#[test]
fn native_format_owner_span_survives_collection_failure_and_recovery() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    set_word(&mut memory, 0x27, 0x7ffe);
    set_word(&mut memory, 0x23, 0x7ffe);
    enable_guest_printer(&mut memory);
    install_character_hook(&mut memory, 0x167);
    assert!(execute_direct(&mut memory, &mut cpu, "CLEAR1"));
    assert!(!execute_direct(&mut memory, &mut cpu, "A$=STR$(42)"));
    assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 26);
    assert!(character_hook_trace(&memory).is_empty());
    canonical_assert_empty(&memory);
    assert_eq!(cpu.registers.s, 0x7000);
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        "CLEAR8:Q$=STRING$(7,65):Q$=\"\""
    ));
    let old_free = word(&memory, 0x23);
    assert!(execute_direct(&mut memory, &mut cpu, "A$=STR$(42)"));
    assert!(
        word(&memory, 0x23) > old_free,
        "allocation really collected the discarded string"
    );
    assert!(character_hook_trace(&memory).is_empty());
    assert!(execute_direct(&mut memory, &mut cpu, "PRINT#-2,A$;"));
    assert_eq!(character_hook_trace(&memory), b" 42");
    assert_eq!(memory.output, b" 42");
    canonical_assert_empty(&memory);
    assert_eq!(cpu.registers.s, 0x7000);
}

#[test]
fn keyboard_limit_keeps_programme_input_and_line_input_in_sync() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    // Authored keyboard supplier; the cold guest owns tokenisation, storage,
    // RUN, both input statements and all string allocation.
    let key = usize::from(symbol("KEYIN"));
    memory.bytes[key..key + 3].copy_from_slice(&[0x7e, 0x65, 0]);
    set_word(&mut memory, 0x6600, 0x6800);
    let text = format!(
        "5 REM{}\r10 INPUT A$\r20 LINE INPUT B$\r30 POKE25345,85:END\rCLEAR1024\rRUN\r{}QQ\r{}ZZ\u{8}A\r",
        "R".repeat(300),
        "Z".repeat(249),
        "Y".repeat(249)
    );
    memory.bytes[0x6800..0x6800 + text.len()].copy_from_slice(text.as_bytes());
    let end = u16::try_from(0x6800 + text.len()).unwrap().to_be_bytes();
    let keyboard = [
        0x34, 0x10, 0xbe, 0x66, 0, 0x8c, end[0], end[1], 0x24, 8, 0xa6, 0x80, 0xbf, 0x66, 0, 0x4d,
        0x35, 0x90, 0x4f, 0x35, 0x90,
    ];
    memory.bytes[0x6500..0x6500 + keyboard.len()].copy_from_slice(&keyboard);
    cpu.reset(&mut memory);
    for _ in 0..8_388_608 {
        if memory.bytes[25345] == 85 && cpu.registers.pc == symbol("READ_CHARACTER_WAIT") {
            break;
        }
        cpu.step(&mut memory).unwrap();
    }
    assert_eq!(
        memory.bytes[25345],
        85,
        "PC={:04X}, error={}, keyboard={:04X}, end={:04X}, screen={:?}",
        cpu.registers.pc,
        memory.bytes[usize::from(symbol("ERROR_CODE"))],
        word(&memory, 0x6600),
        0x6800 + text.len(),
        &memory.bytes[0x5a0..0x600]
    );
    assert_eq!(cpu.registers.pc, symbol("READ_CHARACTER_WAIT"));
    assert_eq!(word(&memory, 0x6600), u16::from_be_bytes(end));
    assert_eq!(word(&memory, 0x68), 0xffff);
    let first_line = usize::from(word(&memory, 0x19));
    assert_eq!(word(&memory, first_line + 2), 5);
    assert_eq!(memory.bytes[first_line + 4], 0x82);
    assert_eq!(
        &memory.bytes[first_line + 5..first_line + 249],
        &[b'R'; 244]
    );
    assert_eq!(memory.bytes[first_line + 249], 0);
    for (name, fill, last) in [(b'A', b'Z', b'Z'), (b'B', b'Y', b'A')] {
        let descriptor = numeric_scalar(&memory, [name, 0x80]);
        assert_eq!(descriptor[0], 249);
        let start = usize::from(u16::from_be_bytes([descriptor[2], descriptor[3]]));
        assert_eq!(&memory.bytes[start..start + 248], &[fill; 248]);
        assert_eq!(memory.bytes[start + 248], last);
    }
    assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0);
}

// Original guest probes, compared with retained non-copyrightable observations
// of the exact lawful profile. No reference implementation or ROM bytes.
fn public_output_hook(memory: &mut Memory, device: Option<u8>) {
    let mut code = vec![0x34, 2, 0x7c, 0x63, 0xa0]; // preserve A; count callback
    if let Some(device) = device {
        code.extend([0x86, device, 0x97, 0x6f]);
    }
    code.extend([0x35, 0x82]);
    memory.bytes[0x6800..0x6800 + code.len()].copy_from_slice(&code);
    memory.bytes[0x167..0x16a].copy_from_slice(&[0x7e, 0x68, 0]);
}
fn public_output_file(memory: &mut Memory, mode: u8, count: u8) {
    memory.bytes[0x78] = mode;
    memory.bytes[0x79] = count;
    set_word(memory, 0x7a, 0x1da + u16::from(count));
    set_word(memory, 0x7e, 0x1da);
    memory.bytes[0x1da..0x2d9].fill(b'A');
}
fn public_output_z(memory: &mut Memory, cpu: &mut Cpu) {
    cpu.registers.b = 0x43;
    cpu.registers.x = 0x3456;
    cpu.registers.y = 0x4567;
    cpu.registers.u = 0x5678;
    let mut code = vec![0x86, b'Z'];
    call(&mut code, 0xb54a);
    memory.execute_with_budget(cpu, &code, 4_000_000);
    assert_eq!(
        (
            cpu.registers.a,
            cpu.registers.b,
            cpu.registers.x,
            cpu.registers.y,
            cpu.registers.u,
            cpu.registers.s
        ),
        (b'Z', 0x43, 0x3456, 0x4567, 0x5678, 0x7000)
    );
}
#[test]
fn public_output_selects_all_device_bytes_after_the_hook() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/fd029fd64f2f9aef-output-selector-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let dev = u8::try_from(fact["device"].as_u64().unwrap()).unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        enable_guest_printer(&mut memory);
        public_output_file(&mut memory, 2, 0);
        memory.bytes[0x6f] = dev;
        set_word(&mut memory, 0x88, 0x400);
        public_output_hook(&mut memory, None);
        public_output_z(&mut memory, &mut cpu);
        for (address, key) in [
            (0x79, "count"),
            (0x9c, "column"),
            (0x400, "cell"),
            (0x89, "cursorLow"),
            (0x6f, "retainedDevice"),
        ] {
            assert_eq!(
                u64::from(memory.bytes[address]),
                fact[key].as_u64().unwrap(),
                "device {dev}, {key}"
            );
        }
        assert_eq!(memory.bytes[0x63a0], 1);
    }
    for (initial, target) in [(0, 255), (255, 0), (255, 254), (254, 255), (255, 253)] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        enable_guest_printer(&mut memory);
        public_output_file(&mut memory, 2, 0);
        memory.bytes[0x6f] = initial;
        set_word(&mut memory, 0x88, 0x400);
        public_output_hook(&mut memory, Some(target));
        public_output_z(&mut memory, &mut cpu);
        assert_eq!(memory.bytes[0x6f], target);
        assert_eq!(memory.bytes[0x79], u8::from(target == 255));
        assert_eq!(memory.bytes[0x400], if target == 0 { b'Z' } else { 0 });
        assert_eq!(
            memory.output,
            if target == 254 { b"Z".to_vec() } else { vec![] }
        );
    }
}
#[test]
fn public_output_keeps_private_formatting_ahead_of_device_selection() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    enable_guest_printer(&mut memory);
    public_output_file(&mut memory, 2, 0);
    memory.bytes[0x6f] = 255;
    public_output_hook(&mut memory, Some(254));
    memory.bytes[usize::from(symbol("FORMAT_BUFFER"))] = 1;
    set_word(&mut memory, usize::from(symbol("FORMAT_TARGET")), 0x6200);
    memory.bytes[usize::from(symbol("FORMAT_LENGTH"))] = 1;
    public_output_z(&mut memory, &mut cpu);
    public_output_z(&mut memory, &mut cpu);
    assert_eq!(memory.bytes[0x6200], b'Z');
    assert_eq!(memory.bytes[0x6201], 0);
    assert_eq!(memory.bytes[0x63a0], 0);
    assert_eq!(memory.bytes[0x79], 0);
    assert!(memory.output.is_empty());
    assert_eq!(memory.bytes[0x6f], 255);
}
#[test]
fn public_output_cassette_mode_and_pending_full_buffer_match_reference() {
    for mode in [0, 1, 2, 3, 4, 127, 128, 254, 255] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        enable_guest_printer(&mut memory);
        public_output_file(&mut memory, mode, 0);
        memory.bytes[0x6f] = 255;
        public_output_z(&mut memory, &mut cpu);
        assert_eq!(memory.bytes[0x79], u8::from(mode != 1), "mode {mode}");
        assert_eq!(memory.bytes[0x78], mode);
    }
    for count in [1, 253, 254, 255] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        enable_guest_printer(&mut memory);
        public_output_file(&mut memory, 2, count);
        memory.bytes[0x6f] = 255;
        memory.bytes[usize::from(symbol("TAPE_PREP"))] = 0x39;
        let writer = usize::from(symbol("TAPE_BLOCK_OUT"));
        // Observe the complete pending block before accepting the new byte.
        let callback = [
            0x7c, 0x63, 0xa1, 0xdc, 0x7c, 0xfd, 0x63, 0xa2, 0xdc, 0x7a, 0xfd, 0x63, 0xa4, 0xb6,
            0x02, 0xd8, 0xb7, 0x63, 0xa6, 0x1c, 0xfe, 0x39,
        ];
        memory.bytes[writer..writer + callback.len()].copy_from_slice(&callback);
        public_output_z(&mut memory, &mut cpu);
        let expected = if count == 255 { 1 } else { count + 1 };
        assert_eq!(memory.bytes[0x79], expected, "count {count}");
        assert_eq!(word(&memory, 0x7a), 0x1da + u16::from(expected));
        assert_eq!(memory.bytes[0x1da + usize::from(expected) - 1], b'Z');
        assert_eq!(memory.bytes[0x63a1], u8::from(count == 255));
        if count == 255 {
            assert_eq!(&memory.bytes[0x63a2..0x63a7], &[1, 255, 2, 0xd9, b'A']);
        }
        assert_eq!(memory.bytes[0xff21] & 8, 0);
    }
}
#[test]
fn public_output_full_buffer_failure_keeps_pending_bytes_for_guest_retry() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    public_output_file(&mut memory, 2, 255);
    memory.bytes[0x6f] = 255;
    memory.bytes[0x2d9..0x2dc].fill(0xa5);
    // PRINT retains its normal native failure frame around the public output.
    memory.bytes[usize::from(symbol("TAPE_PREP"))] = 0x39;
    let writer = usize::from(symbol("TAPE_BLOCK_OUT"));
    memory.bytes[writer..writer + 3].copy_from_slice(&[0x1a, 1, 0x39]);
    assert!(!execute_direct_with_budget(
        &mut memory,
        &mut cpu,
        "PRINT#-1,\"Z\";",
        4_000_000
    ));
    assert_eq!(memory.bytes[0x79], 255);
    assert_eq!(word(&memory, 0x7a), 0x2d9);
    assert!(memory.bytes[0x1da..0x2d9].iter().all(|b| *b == b'A'));
    assert_eq!(&memory.bytes[0x2d9..0x2dc], &[0xa5; 3]);
    assert_eq!(memory.bytes[0xff21] & 8, 0);
    assert_eq!(memory.bytes[0x78], 2);
    // Only release the authored writer failure; no host repair of cursor/count.
    memory.bytes[writer..writer + 3].copy_from_slice(&[0x1c, 0xfe, 0x39]);
    assert!(execute_direct_with_budget(
        &mut memory,
        &mut cpu,
        "PRINT#-1,\"Z\";",
        4_000_000
    ));
    assert_eq!(memory.bytes[0x79], 2);
    assert_eq!(word(&memory, 0x7a), 0x1dc);
    assert_eq!(memory.bytes[0x1da], b'Z');
    assert_eq!(memory.bytes[0xff21] & 8, 0);
    assert!(execute_direct(&mut memory, &mut cpu, "B=17"));
    assert_eq!(numeric_scalar(&memory, [b'B', 0]), packed_integer(17));
}
#[test]
fn public_output_print_uses_live_device_and_shared_format_grammar() {
    for source in [
        include_str!("fixtures/complete-basic/22a6d85d6c55984d-output-print-observations.json"),
        include_str!(
            "fixtures/complete-basic/f822a7a3c6ca94eb-output-print-record-observations.json"
        ),
        include_str!(
            "fixtures/complete-basic/4a5587fe6c4f2984-output-print-column-observations.json"
        ),
        include_str!(
            "fixtures/complete-basic/63910de69e540ded-output-print-comma-observations.json"
        ),
        include_str!(
            "fixtures/complete-basic/42d8f83b1653d418-output-print-transition-observations.json"
        ),
    ] {
        let facts: serde_json::Value = serde_json::from_str(source).unwrap();
        for fact in facts["cases"].as_array().unwrap() {
            let text = fact["source"].as_str().unwrap();
            let target = u8::try_from(fact["hookDevice"].as_u64().unwrap()).unwrap();
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            public_output_file(&mut memory, 2, 0);
            memory.bytes[0x6f] = 255;
            set_word(&mut memory, 0x88, 0x400);
            public_output_hook(&mut memory, Some(target));
            if let Some(at) = fact["changeAt"].as_u64() {
                let code = [
                    0x34,
                    2,
                    0x7c,
                    0x63,
                    0xa0,
                    0xb6,
                    0x63,
                    0xa0,
                    0x81,
                    u8::try_from(at).unwrap(),
                    0x26,
                    4,
                    0x86,
                    target,
                    0x97,
                    0x6f,
                    0x35,
                    0x82,
                ];
                memory.bytes[0x6800..0x6800 + code.len()].copy_from_slice(&code);
            }
            assert_eq!(
                execute_direct_with_budget(&mut memory, &mut cpu, text, 500_000),
                fact["phase"].as_u64().unwrap() == 1,
                "{text} -> {target}"
            );
            if fact["phase"].as_u64().unwrap() != 1 {
                continue;
            }
            let count = usize::try_from(fact["bufferCount"].as_u64().unwrap()).unwrap();
            let data: Vec<u8> = fact["bufferBytes"]
                .as_array()
                .unwrap()
                .iter()
                .take(count)
                .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                .collect();
            let printer: Vec<u8> = fact["printer"]
                .as_array()
                .unwrap()
                .iter()
                .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                .collect();
            assert_eq!(usize::from(memory.bytes[0x79]), count, "{text} -> {target}");
            assert_eq!(
                &memory.bytes[0x1da..0x1da + count],
                data,
                "{text} -> {target}"
            );
            assert_eq!(memory.output, printer, "{text} -> {target}");
            assert_eq!(
                u64::from(memory.bytes[0x63a0]),
                fact["hookCalls"].as_u64().unwrap(),
                "{text} -> {target}"
            );
            assert_eq!(memory.bytes[0x6f], 0);
            assert_eq!(memory.bytes[0x78], 2);
            assert_eq!(memory.bytes[0xff21] & 8, 0);
        }
    }
}

#[test]
fn public_output_pending_full_block_uses_unchanged_physical_waveforms() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    enable_guest_printer(&mut memory);
    public_output_file(&mut memory, 2, 255);
    memory.bytes[0x6f] = 255;
    set_word(&mut memory, 0x90, 128);
    memory.signal_limit = 32768;
    public_output_z(&mut memory, &mut cpu);
    let tape = recorded_gapped_cassette(&memory);
    assert_eq!(original_cassette_blocks(&tape), vec![(1, vec![b'A'; 255])]);
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/c56008ed32a6d21b-output-boundary-observations.json"
    ))
    .unwrap();
    let fact = facts["cases"]
        .as_array()
        .unwrap()
        .iter()
        .find(|row| row["id"] == "count-255")
        .unwrap();
    let reference: Vec<u8> = fact["syntheticTape"]
        .as_array()
        .unwrap()
        .iter()
        .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
        .collect();
    // XRoar appends its own CUE metadata after the completed CAS block.
    // Compare only the authored 255-byte block and its framing/checksum.
    let sync = reference.iter().position(|b| *b == 0x3c).unwrap();
    let end = sync + 5 + usize::from(reference[sync + 2]);
    assert_eq!(
        original_cassette_blocks(&reference[..end]),
        original_cassette_blocks(&tape)
    );
    assert_eq!(memory.bytes[0x79], 1);
    assert_eq!(memory.bytes[0x1da], b'Z');
    assert_eq!(memory.bytes[0xff21] & 8, 0);
}

#[test]
fn public_output_print_columns_are_distinct_from_sink_selection() {
    for (source, custom) in [
        (
            include_str!(
                "fixtures/complete-basic/43547d4a6e27b91b-output-print-selector-column-observations.json"
            ),
            false,
        ),
        (
            include_str!(
                "fixtures/complete-basic/04bbd433308ff750-output-print-custom-column-observations.json"
            ),
            true,
        ),
    ] {
        let facts: serde_json::Value = serde_json::from_str(source).unwrap();
        for fact in facts["cases"].as_array().unwrap() {
            let text = fact["source"].as_str().unwrap();
            let device = u8::try_from(fact["device"].as_u64().unwrap()).unwrap();
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            public_output_file(&mut memory, 2, 0);
            memory.bytes[0x6f] = device;
            set_word(&mut memory, 0x88, 0x405);
            memory.bytes[0x9c] = 11;
            if custom {
                memory.bytes[0x99..0x9c].copy_from_slice(&[7, 21, 28]);
            }
            public_output_hook(&mut memory, None);
            assert!(
                execute_direct(&mut memory, &mut cpu, text),
                "{device}: {text}"
            );
            for (address, key) in [
                (0x63a0, "hookCalls"),
                (0x6c, "columnCache"),
                (0x9c, "printerColumn"),
                (0x79, "bufferCount"),
            ] {
                assert_eq!(
                    u64::from(memory.bytes[address]),
                    fact[key].as_u64().unwrap(),
                    "device {device}, custom {custom}, {text}, {key}"
                );
            }
            assert_eq!(
                u64::from(word(&memory, 0x88)),
                fact["cursor"].as_u64().unwrap()
            );
            let expected: Vec<u8> = fact["printer"]
                .as_array()
                .unwrap()
                .iter()
                .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                .collect();
            assert_eq!(memory.output, expected, "{device}: {text}");
        }
    }
}

#[test]
fn public_output_ascii_save_uses_live_device_and_closes_only_cassette() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/03bad6794a294c40-output-ascii-hook-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(&mut memory, &mut cpu, 10, "PRINT\"Q\"");
        memory.bytes[0x1da..0x2d9].fill(b'A');
        memory.bytes[0x6f] = 0;
        memory.signal_limit = 131_072;
        let mut hook = vec![
            0x34, 0x16, 0xf6, 0x63, 0xa0, 0x8e, 0x64, 0, 0x96, 0x6f, 0xa7, 0x85, 0x8e, 0x65, 0,
            0xa6, 0xe4, 0xa7, 0x85, 0x7c, 0x63, 0xa0,
        ];
        if let Some(target) = fact["hookDevice"].as_u64() {
            hook.extend([0x86, u8::try_from(target).unwrap(), 0x97, 0x6f]);
        }
        hook.extend([0x35, 0x96]);
        memory.bytes[0x6800..0x6800 + hook.len()].copy_from_slice(&hook);
        memory.bytes[0x167..0x16a].copy_from_slice(&[0x7e, 0x68, 0]);
        assert!(execute_direct_with_budget(
            &mut memory,
            &mut cpu,
            "CSAVE\"X\",A",
            4_000_000
        ));
        let count = usize::try_from(fact["hookCalls"].as_u64().unwrap()).unwrap();
        assert_eq!(usize::from(memory.bytes[0x63a0]), count, "{}", fact["id"]);
        for (address, key) in [(0x6400, "hookDevices"), (0x6500, "hookBytes")] {
            let expected: Vec<u8> = fact[key]
                .as_array()
                .unwrap()
                .iter()
                .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                .collect();
            assert_eq!(
                &memory.bytes[address..address + count],
                expected,
                "{} {key}",
                fact["id"]
            );
        }
        let printer: Vec<u8> = fact["printer"]
            .as_array()
            .unwrap()
            .iter()
            .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
            .collect();
        assert_eq!(memory.output, printer, "{}", fact["id"]);
        for (address, index) in [(0x78, 0), (0x79, 1), (0x7a, 2), (0x7b, 3)] {
            assert_eq!(
                u64::from(memory.bytes[address]),
                fact["workspace"][index].as_u64().unwrap(),
                "{} workspace {address:04X}",
                fact["id"]
            );
        }
        assert_eq!(memory.bytes[0x6f], 0);
        assert_eq!(memory.bytes[0xff21] & 8, 0);
        let reference: Vec<u8> = fact["syntheticTape"]
            .as_array()
            .unwrap()
            .iter()
            .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
            .collect();
        let end = reference
            .windows(4)
            .position(|w| w == b"[CUE")
            .unwrap_or(reference.len());
        assert_eq!(
            original_cassette_blocks(&recorded_gapped_cassette(&memory)),
            original_cassette_blocks(&reference[..end]),
            "{}",
            fact["id"]
        );
    }
}
#[test]
fn public_output_ascii_save_stops_execution_while_binary_save_continues() {
    let observations: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/2f7a246590c9a832-output-ascii-continuation-observations.json"
    ))
    .unwrap();
    for (ascii, running, suffix) in [
        (true, false, true),
        (false, false, true),
        (true, true, true),
        (true, true, false),
        (false, true, true),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        memory.bytes[0x6f] = 0;
        memory.signal_limit = 131_072;
        let save = if ascii { "CSAVE\"X\",A" } else { "CSAVE\"X\"" };
        let source = if running {
            store_line(
                &mut memory,
                &mut cpu,
                10,
                &format!("{save}{}", if suffix { ":POKE25424,1" } else { "" }),
            );
            store_line(&mut memory, &mut cpu, 20, "POKE25425,2");
            "RUN".to_owned()
        } else {
            store_line(&mut memory, &mut cpu, 10, "PRINT\"Q\"");
            format!("{save}:POKE25424,1")
        };
        assert!(execute_direct_with_budget(
            &mut memory,
            &mut cpu,
            &source,
            4_000_000
        ));
        assert_eq!(
            &memory.bytes[0x6350..0x6352],
            if ascii {
                &[0, 0]
            } else if running {
                &[1, 2]
            } else {
                &[1, 0]
            },
            "{source}, running {running}"
        );
        let id = match (ascii, running, suffix) {
            (true, false, _) => "ascii-direct-suffix",
            (false, false, _) => "binary-direct-suffix",
            (true, true, true) => "ascii-programme-suffix",
            (true, true, false) => "ascii-programme-next",
            (false, true, _) => "binary-programme-suffix",
        };
        let observed = observations["cases"]
            .as_array()
            .unwrap()
            .iter()
            .find(|case| case["id"].as_str() == Some(id))
            .unwrap();
        for (index, byte) in memory.bytes[0x6350..0x6352].iter().enumerate() {
            assert_eq!(
                u64::from(*byte),
                observed["markers"][index].as_u64().unwrap(),
                "{id}"
            );
        }
        assert_eq!(memory.bytes[0x78], 0);
        assert_eq!(memory.bytes[0xff21] & 8, 0);
        assert!(execute_direct(&mut memory, &mut cpu, "B=17"));
        assert_eq!(numeric_scalar(&memory, [b'B', 0]), packed_integer(17));
    }
    for running in [false, true] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        if running {
            store_line(&mut memory, &mut cpu, 10, "CSAVE1,A:POKE25424,1");
            store_line(&mut memory, &mut cpu, 20, "POKE25425,2");
        }
        assert!(!execute_direct(
            &mut memory,
            &mut cpu,
            if running {
                "RUN"
            } else {
                "CSAVE1,A:POKE25424,1"
            }
        ));
        assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 24);
        assert_eq!(&memory.bytes[0x6350..0x6352], &[0, 0]);
        assert!(execute_direct(&mut memory, &mut cpu, "B=17"));
    }
}

