        for scalar in case["scalars"].as_array().unwrap() {
            let name = [
                u8::try_from(scalar["name"][0].as_u64().unwrap()).unwrap(),
                0,
            ];
            let expected: Vec<u8> = scalar["value"]["packed"]
                .as_array()
                .unwrap()
                .iter()
                .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
