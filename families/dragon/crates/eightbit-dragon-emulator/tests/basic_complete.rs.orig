}

// Exact signed integers cover both input orders, equal-exponent cancellation,
// alignment ties, every exponent, and overflow/underflow without host floats.
#[test]
fn native_magnitude_order_preserves_signed_results_at_every_exponent() {
    fn result(left: [u8; 5], right: [u8; 5], subtract: bool) -> Option<[u8; 5]> {
        let base = match (left[0], right[0]) {
            (0, exponent) | (exponent, 0) => exponent,
            (left, right) => left.min(right),
        };
        let integer = |value: [u8; 5]| {
            if value[0] == 0 {
                return 0_i128;
            }
            let magnitude = i128::from(u32::from_be_bytes([
                value[1] | 128,
                value[2],
                value[3],
                value[4],
            ])) << (value[0] - base);
            if value[1] & 128 == 0 {
                magnitude
            } else {
                -magnitude
            }
        };
        let sum = integer(left)
            + if subtract {
                -integer(right)
            } else {
                integer(right)
            };
        if sum == 0 {
            return Some([0; 5]);
        }
        let magnitude = sum.unsigned_abs();
        let bits = 128 - magnitude.leading_zeros();
        let mut exponent = i32::from(base) + i32::try_from(bits).unwrap() - 32;
        let mut mantissa = if bits > 32 {
            let shift = bits - 32;
            (magnitude >> shift)
                + u128::from(magnitude & ((1_u128 << shift) - 1) >= 1_u128 << (shift - 1))
        } else {
            magnitude << (32 - bits)
        };
        if mantissa == 1_u128 << 32 {
            mantissa >>= 1;
            exponent += 1;
        }
        if exponent <= 0 {
            return Some([0; 5]);
        }
        let exponent = u8::try_from(exponent).ok()?;
        let bytes = u32::try_from(mantissa).unwrap().to_be_bytes();
        Some([
            exponent,
            (bytes[0] & 127) | if sum < 0 { 128 } else { 0 },
            bytes[1],
            bytes[2],
            bytes[3],
        ])
    }
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let mantissas = [
        (0x8000_0000_u32, 0xffff_ffff_u32),
        (0x8000_0000, 0x8000_0001),
        (0x8000_0100, 0x8000_00ff),
        (0xffff_ffff, 0xffff_ffff),
        (0x9234_5678, 0x9234_5678),
        (0x8000_0000, 0x8000_0000),
        (0xffff_fffe, 0xffff_ffff),
        (0x8123_4567, 0xfedc_ba98),
    ];
    let distances = [0_u8, 1, 31, 32, 33, 34, 40, 65];
    let packed = |exponent: u8, mantissa: u32, negative: bool| {
        let bytes = mantissa.to_be_bytes();
        [
            exponent,
            (bytes[0] & 127) | if negative { 128 } else { 0 },
            bytes[1],
            bytes[2],
            bytes[3],
        ]
    };
    let mut total_cycles = 0_u64;
    let mut max_cycles = 0_u64;
    let mut cases = 0_u64;
    for exponent in 1..=255_u8 {
        for (index, (left_mantissa, right_mantissa)) in mantissas.iter().copied().enumerate() {
            let distance = distances[(index + usize::from(exponent)) % distances.len()];
            let right_exponent = exponent.saturating_sub(distance).max(1);
            for signs in 0..4_u8 {
                let left = packed(exponent, left_mantissa, signs & 1 != 0);
                let right = packed(right_exponent, right_mantissa, signs & 2 != 0);
                for (left, right) in [(left, right), (right, left), ([0; 5], left), (left, [0; 5])]
                {
                    for (name, subtract) in [("F_ADD", false), ("F_SUB", true)] {
                        unpack_to(&mut memory, 0x4f, left);
                        unpack_to(&mut memory, 0x5c, right);
                        memory.bytes[0xd8..0xea].fill(0xa5);
                        memory.bytes[0x3d9..0x400].fill(0x5a);
                        let mut code = Vec::new();
                        call(&mut code, symbol(name));
                        let before = memory.cycles;
                        memory.execute(&mut cpu, &code);
                        let cycles = memory.cycles - before;
                        total_cycles += cycles;
                        max_cycles = max_cycles.max(cycles);
                        cases += 1;
                        match result(left, right, subtract) {
                            Some(expected) => {
                                assert_eq!(cpu.registers.cc & C, 0, "{name} {left:?} {right:?}");
                                let mut pack = vec![0x8e, 0x60, 0];
                                call(&mut pack, symbol("FAC_STORE"));
                                memory.execute(&mut cpu, &pack);
                                assert_eq!(
                                    &memory.bytes[0x6000..0x6005],
                                    &expected,
                                    "{name} {left:?} {right:?}"
                                );
                            }
                            None => assert_ne!(
                                cpu.registers.cc & C,
                                0,
                                "range {name} {left:?} {right:?}"
                            ),
                        }
                        assert_eq!(cpu.registers.s, 0x7000);
                        assert_eq!(&memory.bytes[0xd8..0xea], &[0xa5; 18]);
                        assert_eq!(&memory.bytes[0x3d9..0x400], &[0x5a; 39]);
                    }
                }
            }
        }
    }
    eprintln!(
        "ordered magnitudes: {cases} cases; {total_cycles} total cycles; {max_cycles} maximum"
    );
}

// These authored adapters are test-fixture bytes outside the candidate image,
// guest RAM, I/O and vectors. Keeping the original three-byte JSR probe matters:
// recursive FN deliberately lets the guest stack cross the probe at $2000.
// There is no host language execution or production runtime allocation here.
const GUEST_EXECUTOR_PROBE: u16 = 0xf100;
const GUEST_NUMBER_PRINTER_PROBE: u16 = 0xf120;
fn install_guest_adapters(bytes: &mut [u8], candidate_end: usize) {
    let mut executor = vec![0x7f]; // CLR private origin; PSHS Y,U; STS caller.
    executor.extend(symbol("EXEC_ORIGIN").to_be_bytes());
    executor.extend([0x34, 0x60, 0x10, 0xff]);
    executor.extend(symbol("EXEC_SAVED").to_be_bytes());
    executor.push(0x7e);
    executor.extend(symbol("EXEC_START").to_be_bytes());
    let mut printer = vec![0x34, 0x76, 0xc6, 32, 0x7e]; // Save D/X/Y/U; UF_PLUS.
    printer.extend(symbol("FORMAT_ENTRY").to_be_bytes());
    for (address, body) in [
        (GUEST_EXECUTOR_PROBE, executor),
        (GUEST_NUMBER_PRINTER_PROBE, printer),
    ] {
        let start = usize::from(address);
        assert!(start >= candidate_end);
        assert!(start + body.len() < 0xff00);
        assert!(
            bytes[start..start + body.len()]
                .iter()
                .all(|byte| *byte == 0)
        );
        bytes[start..start + body.len()].copy_from_slice(&body);
    }
}
fn call_guest_executor(code: &mut Vec<u8>) {
    call(code, GUEST_EXECUTOR_PROBE);
}
fn call_guest_number_printer(code: &mut Vec<u8>) {
    call(code, GUEST_NUMBER_PRINTER_PROBE);
}

#[test]
fn shared_compiler_cassette_and_complete_guest_features_round_trip_together() {
    use eightbit_dragon_basic_core::{Dialect, analyse, tokenise};
    // This is the shared authoring compiler and media encoder used by the web
    // and desktop build paths. Execution stays in the guest, on this test bus.
    let read_string = |memory: &Memory, name: u8| {
        let descriptor = numeric_scalar(memory, [name, 128]);
        let start = usize::from(u16::from_be_bytes([descriptor[2], descriptor[3]]));
        memory.bytes[start..start + usize::from(descriptor[0])].to_vec()
    };
    let source = concat!(
        "10 CLEAR1024\n",
        "20 DIM A(3),S(20):DATA 2,4,6,8\n",
        "30 FOR I=0 TO 3:READ A(I):NEXT I\n",
        "40 GOSUB500\n",
        "50 PMODE4,1:PCLS0:SCREEN1,1\n",
        "60 LINE(10,10)-(30,30),PSET,BF:GET(10,10)-(15,15),S\n",
        "70 PUT(50,50)-(55,55),S,PSET:DRAW\"BM80,80;R10D10L10U10\"\n",
        "80 CIRCLE(100,90),8:PAINT(20,20),1,1\n",
        "90 PLAY\"O2T255L255C\":SOUND128,1\n",
        "100 PRINT#-2,USING\"### %%\";V;A$\n",
        "110 STOP\n",
        "120 OPEN\"O\",#-1,\"OWNDATA\"\n",
        "130 PRINT#-1,V;B$\n",
        "140 CLOSE#-1\n",
        "150 POKE25345,85:STOP\n",
        "160 OPEN\"I\",#-1,\"OWNDATA\":INPUT#-1,N,C$:CLOSE#-1\n",
        "170 POKE25346,86:END\n",
        "500 DEF FNF(X)=X*X+1:V=FNF(A(2)):A$=\"ROM\":B$=A$+STR$(V):RETURN\n",
    );
    let dialect = Dialect::dragon32().unwrap();
    let analysis = analyse(source, &dialect);
    assert!(!analysis.has_errors(), "{:?}", analysis.diagnostics);
    let compiled = tokenise(&analysis.program, &dialect).unwrap();
    let mut tape =
        eightbit_dragon_media::create_tokenised_basic("JOURNEY", &compiled.bytes).unwrap();
    tape.extend([0x55; 16]);
    let mut memory = Memory::new();
    memory.probe_address = 0x6000;
    memory.signal_limit = 131_072;
    let mut cpu = Cpu::default();
    let mut setup = Vec::new();
    call(&mut setup, symbol("SETUP"));
    memory.execute_with_budget(&mut cpu, &setup, 1_000_000);
    enable_guest_printer(&mut memory);
    synthetic_tape(&mut memory, &tape);
    assert!(execute_direct_with_budget(
        &mut memory,
        &mut cpu,
        "CLOAD\"JOURNEY\"",
        32_000_000
    ));
    let start = usize::from(word(&memory, 0x19));
    let end = usize::from(word(&memory, 0x1b));
    assert_eq!(&memory.bytes[start..end], compiled.bytes);
    memory.input_signal.clear();
    memory.signals.clear();
    memory.output.clear();
    memory.next_frame = Some(memory.cycles + 17745);
    cpu.registers.cc &= 0xaf;
    assert!(execute_direct_with_budget(
        &mut memory,
        &mut cpu,
        "RUN",
        16_000_000
    ));
    assert_eq!(numeric_scalar(&memory, [b'V', 0]), packed_integer(37));
    assert_eq!(read_string(&memory, b'B'), b"ROM 37");
    assert_eq!(memory.output, b" 37 RO\r");
    assert_eq!(memory.bytes[0x6301], 0, "STOP precedes file recording");
    assert_eq!(word(&memory, 0x29), 110);
    assert_ne!(memory.bytes[usize::from(symbol("CONT_VALID"))], 0);
    for (x, y, set) in [(52usize, 52usize, true), (49, 52, false), (80, 80, true)] {
        let byte = memory.bytes[0x600 + y * 32 + x / 8];
        assert_eq!(byte & (0x80 >> (x % 8)) != 0, set, "pixel {x},{y}");
    }
    assert!(
        memory
            .signals
            .iter()
            .filter(|s| s.1 == 0xff20 && s.2 >> 2 > 32)
            .count()
            > 20,
        "PLAY and SOUND emit guest DAC samples"
    );
    assert_eq!(memory.bytes[0xff23] & 8, 0, "audio gate closes before STOP");
    assert_eq!(word(&memory, 0xe3), 0);
    memory.signals.clear();
    assert!(execute_direct_with_budget(
        &mut memory,
        &mut cpu,
        "CONT",
        8_000_000
    ));
    assert_eq!(memory.bytes[0x6301], 85);
    assert_eq!(memory.bytes[0x78], 0);
    assert_eq!(memory.bytes[0xff21] & 8, 0);
    let mut recorded = recorded_gapped_cassette(&memory);
    let blocks = original_cassette_blocks(&recorded);
    assert_eq!(blocks.len(), 3);
    assert_eq!(&blocks[0].1[..11], b"OWNDATA \x01\xff\xff");
    assert_eq!(blocks[1], (1, b" 37\rROM 37\r".to_vec()));
    assert_eq!(blocks[2], (255, vec![]));
    recorded.extend([0x55; 16]);
    synthetic_tape(&mut memory, &recorded);
    // INPUT is programme-only. Resume the compiled programme after mounting
    // the guest's own recording; a direct INPUT invocation must still report ID.
    let reloaded = execute_direct_with_budget(&mut memory, &mut cpu, "CONT", 8_000_000);
    assert!(
        reloaded,
        "error {}, cassette {}, mode {}, count {}, cursor {:04x}, text {:04x}",
        memory.bytes[usize::from(symbol("ERROR_CODE"))],
        memory.bytes[0x81],
        memory.bytes[0x78],
        memory.bytes[0x79],
        word(&memory, 0x7a),
        word(&memory, 0xa6)
    );
    assert_eq!(memory.bytes[0x6302], 86);
    assert_eq!(numeric_scalar(&memory, [b'N', 0]), packed_integer(37));
    assert_eq!(read_string(&memory, b'C'), b"ROM 37");
    assert_eq!(&memory.bytes[start..end], compiled.bytes);
    assert_eq!(memory.bytes[0x78], 0);
    assert_eq!(memory.bytes[0xff21] & 8, 0);
    assert_eq!(cpu.registers.s, 0x7000);
    canonical_assert_empty(&memory);
    assert!(execute_direct(&mut memory, &mut cpu, "Z=17"));
    assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(17));
}
