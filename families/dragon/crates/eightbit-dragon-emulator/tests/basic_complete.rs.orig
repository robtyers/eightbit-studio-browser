#[test]
fn complete_candidate_bounds_temporary_strings_but_not_variable_references() {
    for atom in ["\"A\"", "\"\"", "CHR$(65)", "LEFT$(\"A\",1)", "A$"] {
        for additions in [6, 7, 8, 9] {
            let mut expression = atom.to_owned();
            for _ in 0..additions {
                expression = format!("{atom}+({expression})");
            }
            let source = format!("B$={expression}");
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            assert!(
                execute_direct(&mut memory, &mut cpu, "A$=\"A\""),
                "initial error={} roots={} s={:x}",
                candidate_error_index(&memory),
                word(&memory, usize::from(symbol("STR_ROOTS"))),
                cpu.registers.s
            );
            let expected = atom == "A$" || additions < 8;
            assert_eq!(
                execute_direct(&mut memory, &mut cpu, &source),
                expected,
                "{source}"
            );
            if !expected {
                assert_eq!(candidate_error_index(&memory), 24, "{source}");
            }
            assert_eq!(
                word(&memory, usize::from(symbol("STR_ROOTS"))),
                0,
                "{source}"
            );
            assert!(
                execute_direct(&mut memory, &mut cpu, "Z=85"),
                "recovery {source}"
            );
            assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
        }
    }
    let mut nested = "\"A\"".to_owned();
    for _ in 0..8 {
        nested = format!("LEFT$({nested},1)");
    }
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        &format!("A$={nested}")
    ));
}

#[test]
fn complete_candidate_ascii_language_errors_keep_the_valid_prefix() {
    for (source, expected, bytes) in [
        ("BAD\r", Some(25), 2),
        ("PRINT\"A\"\r", Some(25), 2),
        ("10 A=7\rPRINT\"A\"\r", Some(25), 10),
        ("  PRINT\"A\"\r", Some(25), 2),
        ("\r", None, 2),
        ("   \r", None, 2),
        ("64000 END\r", Some(0), 2),
        ("10 A=\r", None, 9),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(&mut memory, &mut cpu, 99, "POKE25344,99");
        synthetic_tape(&mut memory, &synthetic_ascii_cassette(source.as_bytes(), 7));
        assert_eq!(
            execute_direct_with_budget(&mut memory, &mut cpu, "CLOAD\"TEXT\"", 32_000_000),
            expected.is_none(),
            "{source:?} error={} status={} mode={} output={:?}",
            candidate_error_index(&memory),
            memory.bytes[0x81],
            memory.bytes[usize::from(symbol("EXEC_MODE"))],
            memory.output
        );
        if let Some(error) = expected {
            assert_eq!(candidate_error_index(&memory), error, "{source:?}");
        }
        assert_eq!(memory.bytes[0x6300], 0, "previous programme is never run");
        assert_eq!(memory.bytes[0x81], 0, "{source:?}");
        assert_eq!(memory.bytes[0xff21] & 8, 0, "motor stops: {source:?}");
        assert_eq!(
            word(&memory, 0x1b) - word(&memory, 0x19),
            bytes,
            "{source:?}"
        );
        assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0);
        assert!(execute_direct(&mut memory, &mut cpu, "Z=85"));
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
    }
}

#[test]
fn complete_candidate_matches_all_recorded_direct_diagnostic_observations() {
    let observations: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/ace9ab93d5fab117-observations.json"
    ))
    .unwrap();
    let mut differences = Vec::new();
    for case in observations["cases"].as_array().unwrap() {
        let source = case["source"].as_str().unwrap();
        let expected = case["error"].as_str();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        let succeeded = execute_direct(&mut memory, &mut cpu, source);
        let position = usize::from(symbol("ERROR_CODES"))
            + usize::from(memory.bytes[usize::from(symbol("ERROR_CODE"))]);
        let actual = if succeeded {
            None
        } else {
            Some(String::from_utf8_lossy(&memory.bytes[position..position + 2]).into_owned())
        };
        if actual.as_deref() != expected {
            differences.push(format!("{source}: expected {expected:?}, got {actual:?}"));
        }
        assert!(
            execute_direct(&mut memory, &mut cpu, "Z=85"),
            "recovery {source}"
        );
    }
    assert!(differences.is_empty(), "{}", differences.join("\n"));
}

#[test]
fn complete_candidate_graphics_boundaries_match_pixels_pins_and_public_workspace() {
    use sha2::{Digest, Sha256};
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/c7a6285ee55a9a76-graphics-boundary-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        memory.execute_with_budget(&mut cpu, &init, 1_000_000);
        let success = execute_direct_with_budget(&mut memory, &mut cpu, source, 4_194_304);
        assert_eq!(success, fact["error"].is_null(), "{source}");
        if !success {
            assert_eq!(candidate_error_index(&memory), 2, "{source}");
        }
        let bytes = usize::try_from(fact["canvasBytes"].as_u64().unwrap()).unwrap();
        assert_eq!(
            format!("{:x}", Sha256::digest(&memory.bytes[0x600..0x600 + bytes])),
            fact["syntheticCanvasSha256"].as_str().unwrap(),
            "{source} canvas"
        );
        for address in [0xb2, 0xb3, 0xb4, 0xc1] {
            assert_eq!(
                memory.bytes[address],
                u8::try_from(
                    fact["workspace"][format!("{address:04x}")]
                        .as_u64()
                        .unwrap()
                )
                .unwrap(),
                "{source}: {address:04x}"
            );
        }
        if success && source.contains("SCREEN") {
            assert_eq!(
                memory.bytes[0xff22] & 0xf8,
                u8::try_from(fact["screenPins"].as_u64().unwrap()).unwrap() & 0xf8,
                "{source} output pins"
            );
        }
        assert_eq!(cpu.registers.s, 0x7000);
        assert!(execute_direct(&mut memory, &mut cpu, "Z=85"));
    }
}

#[test]
fn candidate_printer_workspace_matches_exact_profile_observations() {
    let observations: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/d1c130f7388a6a15-printer-observations.json"
    ))
    .unwrap();
    assert_eq!(
        observations["referenceSha256"],
        "fc0e900bfec6b52f0f80ba1e65a4712808d2a411b5b00496639ef1a2152351f1"
    );
    for case in observations["cases"].as_array().unwrap() {
        let name = case["id"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        memory.execute(&mut cpu, &init);
        enable_guest_printer(&mut memory);
        if let Some(setup) = case["setup"].as_str() {
            for statement in setup.split(':') {
                let (address, value) = statement
                    .strip_prefix("POKE")
                    .unwrap()
                    .split_once(',')
                    .unwrap();
                memory.bytes[address.parse::<usize>().unwrap()] = value.parse().unwrap();
            }
        }
        if let Some(raw) = case["raw"].as_array() {
            let mut code = vec![
                0xc6, 0x5a, 0x8e, 0x12, 0x34, 0x10, 0x8e, 0x56, 0x78, 0xce, 0x32, 0x10,
            ];
            for byte in raw {
                code.extend([0x86, u8::try_from(byte.as_u64().unwrap()).unwrap()]);
                call(&mut code, 0x800f);
            }
            memory.execute_with_budget(&mut cpu, &code, 1_048_576);
            assert_eq!(cpu.registers.b, 0x5a, "B {name}");
            assert_eq!(
                (
                    cpu.registers.x,
                    cpu.registers.y,
                    cpu.registers.u,
                    cpu.registers.s
                ),
                (0x1234, 0x5678, 0x3210, 0x7000),
                "registers {name}"
            );
        } else if let Some(source) = case["source"].as_str() {
            guest_tokens(&mut memory, &mut cpu, source);
            let mut code = vec![0x8e, 2, 0xdc];
            call_guest_executor(&mut code);
            memory.execute_with_budget(&mut cpu, &code, 1_048_576);
            assert_eq!(cpu.registers.cc & C, 0, "{name}");
        }
        let expected: Vec<u8> = case["printerBytes"]
            .as_array()
            .unwrap()
            .iter()
            .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
            .collect();
        assert_eq!(memory.output, expected, "output {name}");
        assert_eq!(
            u64::from(memory.bytes[0x9c]),
            case["column"].as_u64().unwrap(),
            "column {name}"
        );
        for address in [0x99, 0x9a, 0x9b, 0x9c, 0x148, 0x149, 0x14a, 0x14b, 0x14c] {
            assert_eq!(
                u64::from(memory.bytes[address]),
                case["workspace"][format!("{address:04x}")]
                    .as_u64()
                    .unwrap(),
                "workspace {address:04x} {name}"
            );
        }
    }
}

#[test]
fn candidate_printer_setup_and_busy_strobe_preserve_public_contract() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    memory.bytes[0x99..0x9d].fill(0xa5);
    memory.bytes[0x148..0x14d].fill(0xa5);
    let mut init = Vec::new();
    call(&mut init, symbol("SETUP"));
    memory.execute(&mut cpu, &init);
    assert_eq!(&memory.bytes[0x99..0x9d], &[16, 116, 132, 0]);
    assert_eq!(&memory.bytes[0x148..0x14d], &[255, 255, 1, 13, 10]);
    memory.bytes[0xff22] = 1;
    memory.bytes[0xff20] = 0xa6;
    memory.bytes[0x9c] = 7;
    memory.output.clear();
    memory.signals.clear();
    let mut code = vec![
        0xcc, b'Z', 0x5a, 0x8e, 0x12, 0x34, 0x10, 0x8e, 0x56, 0x78, 0xce, 0x32, 0x10,
    ];
    call(&mut code, 0x800f);
    memory.bytes[0x2000..0x2000 + code.len()].copy_from_slice(&code);
    cpu.registers.pc = 0x2000;
    cpu.registers.s = 0x7000;
    for _ in 0..500 {
        cpu.step(&mut memory).unwrap();
    }
    assert_eq!(memory.bytes[0x9c], 7);
    assert!(memory.output.is_empty());
    assert!(memory.signals.is_empty());
    memory.bytes[0xff22] = 0;
    for _ in 0..1000 {
        if usize::from(cpu.registers.pc) == 0x2000 + code.len() {
            break;
        }
        cpu.step(&mut memory).unwrap();
    }
    assert_eq!(usize::from(cpu.registers.pc), 0x2000 + code.len());
    assert_eq!(memory.output, b"Z");
    assert_eq!(memory.bytes[0x9c], 8);
    assert_eq!(
        (
            cpu.registers.a,
            cpu.registers.b,
            cpu.registers.x,
            cpu.registers.y,
            cpu.registers.u,
            cpu.registers.s
        ),
        (b'Z', 0x5a, 0x1234, 0x5678, 0x3210, 0x7000)
    );
    assert_eq!(memory.signals.len(), 2);
    assert_eq!(memory.signals[0].1, 0xff20);
    assert_eq!(memory.signals[0].2, 0xa4);
    assert_eq!(memory.signals[1].2, 0xa6);
    assert_eq!(
        memory.signals[1].0 - memory.signals[0].0,
        9,
        "unchanged native strobe pulse width"
    );
}

fn execute_input_programme(memory: &mut Memory, cpu: &mut Cpu, source: &str) -> bool {
    store_line(memory, cpu, 10, source);
    execute_direct(memory, cpu, "RUN")
}

#[test]
fn complete_candidate_input_matches_observed_replies_and_recovery() {
    let fixtures: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/46ccabcb224a8961-observations.json"
    ))
    .unwrap();
    for fact in fixtures["cases"].as_array().unwrap() {
        let id = fact["id"].as_str().unwrap();
        if fact["breakCount"].as_u64().unwrap_or(0) != 0 {
            continue;
        }
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        supply_original_keyboard(&mut memory, fact["replies"].as_str().unwrap().as_bytes());
        if fact["direct"] == true {
            assert!(!execute_direct(&mut memory, &mut cpu, source), "{id}");
            assert_eq!(candidate_error_index(&memory), 11, "{id}");
        } else {
            assert!(
                execute_input_programme(&mut memory, &mut cpu, source),
                "{id}"
            );
            for (name, expected) in fact["values"].as_object().unwrap() {
                let key = [
                    name.as_bytes()[0],
                    if name.ends_with('$') { 128 } else { 0 },
                ];
                let value = numeric_scalar(&memory, key);
                let actual = if name.ends_with('$') {
                    let start = usize::from(u16::from_be_bytes([value[2], value[3]]));
                    serde_json::json!(
                        std::str::from_utf8(&memory.bytes[start..start + usize::from(value[0])])
                            .unwrap()
                    )
                } else {
                    serde_json::json!(value)
                };
                assert_eq!(&actual, expected, "{id}: {name}");
            }
            for (message, count) in [
                (b"?REDO".as_slice(), "redoCount"),
                (b"?EXTRA IGNORED".as_slice(), "extraIgnoredCount"),
            ] {
                let actual = memory
                    .output
                    .windows(message.len())
                    .filter(|v| *v == message)
                    .count();
                assert_eq!(
                    actual as u64,
                    fact[count].as_u64().unwrap(),
                    "{id}: {count}"
                );
            }
        }
        assert!(
            execute_direct(&mut memory, &mut cpu, "C=85"),
            "{id} recovery"
        );
        assert_eq!(
            numeric_scalar(&memory, [b'C', 0]),
            packed_integer(85),
            "{id} recovery"
        );
    }
}

#[test]
fn complete_candidate_input_break_restarts_the_statement_without_allocating() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let key = usize::from(symbol("KEYIN"));
    memory.bytes[key..key + 3].copy_from_slice(&[0x7e, 0x65, 0]);
    memory.bytes[0x6500..0x650d].copy_from_slice(&[
        0x34, 0x10, 0xbe, 0x66, 0, 0xa6, 0x80, 0xbf, 0x66, 0, 0x4d, 0x35, 0x90,
    ]);
    set_word(&mut memory, 0x6600, 0x6800);
    let text = b"10 INPUT A:B=9\r20 POKE25345,85:END\rRUN\r\x03\rCONT\r42\r";
    memory.bytes[0x6800..0x6800 + text.len()].copy_from_slice(text);
    cpu.reset(&mut memory);
    let mut stopped = false;
    for _ in 0..4_194_304 {
        cpu.step(&mut memory).unwrap();
        if !stopped && memory.bytes[usize::from(symbol("CONT_VALID"))] != 0 {
            assert_eq!(word(&memory, 0x29), 10);
            assert_eq!(
                word(&memory, 0x1b),
                word(&memory, 0x1d),
                "Break before a reply must not allocate A"
            );
            stopped = true;
        }
        if memory.bytes[25345] == 85 {
            break;
        }
    }
    assert!(stopped);
    assert_eq!(memory.bytes[25345], 85);
    assert_eq!(numeric_scalar(&memory, [b'A', 0]), packed_integer(42));
    assert_eq!(numeric_scalar(&memory, [b'B', 0]), packed_integer(9));
}

#[test]
fn complete_candidate_run_prefix_matches_observed_line_selection() {
    let fixture: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/df1560978c3d5f91-observations.json"
    ))
    .unwrap();
    for fact in fixture["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let line = u16::try_from(fact["line"].as_u64().unwrap()).unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(&mut memory, &mut cpu, line, "POKE25346,99:END");
        let expected = fact["errors"].as_array().unwrap();
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, source),
            expected.is_empty(),
            "line {line}: {source}"
        );
        if !expected.is_empty() {
            assert_eq!(candidate_error_index(&memory), 16, "line {line}: {source}");
        }
        assert_eq!(
            memory.bytes[25346],
            u8::try_from(fact["programmeMarker"].as_u64().unwrap()).unwrap(),
            "line {line}: {source}"
        );
        assert_eq!(
            memory.bytes[0xff21] & 8,
            0,
            "RUN must not start the cassette motor"
        );
    }
}

fn candidate_error_index(memory: &Memory) -> u8 {
    const SELECTORS: [u8; 26] = [
        2, 24, 8, 10, 20, 40, 46, 44, 38, 48, 36, 22, 42, 0, 4, 6, 14, 32, 18, 16, 26, 12, 34, 28,
        30, 50,
    ];
    SELECTORS
        .iter()
        .position(|v| *v == memory.bytes[usize::from(symbol("ERROR_CODE"))])
        .map_or(255, |v| u8::try_from(v).unwrap())
}

fn install_legacy_hook_probe(memory: &mut Memory, hooks: &[u16]) {
    install_legacy_hook_programme(
        memory,
        hooks,
        include_str!("fixtures/complete-basic/11d895481c444f2c-callback-programme.json"),
    );
}
fn install_legacy_hook_programme(memory: &mut Memory, hooks: &[u16], text: &str) {
    let programme: serde_json::Value = serde_json::from_str(text).unwrap();
    let data: Vec<u8> = programme["bytes"]
        .as_array()
        .unwrap()
        .iter()
        .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
        .collect();
    memory.bytes[0x6800..0x6800 + data.len()].copy_from_slice(&data);
    for (i, hook) in [0x18b, 0x18e, 0x194, 0x19a, 0x1a3, 0x1a6]
        .into_iter()
        .enumerate()
    {
        if hooks.contains(&hook) {
            let address =
                u16::try_from(programme["symbols"][format!("HOOK{i}")].as_u64().unwrap()).unwrap();
            memory.bytes[usize::from(hook)] = 0x7e;
            set_word(memory, usize::from(hook) + 1, address);
        }
    }
    memory.bytes[0x637e] = 0;
    memory.bytes[0x637f] = 1;
}

#[test]
fn candidate_expression_run_and_statement_hooks_match_reference_positions() {
    let observations: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/7a6dd387707c1d8d-observations.json"
    ))
    .unwrap();
    let mut differences = Vec::new();
    for case in observations["cases"].as_array().unwrap() {
        let id = case["id"].as_str().unwrap();
        if case.get("tape").is_some()
            || case.get("replaceError").is_some()
            || case.get("skipFirstOperandByte").is_some()
            || case.get("skipBreak").is_some()
        {
            continue;
        } // Separate existing RUN range diagnostic discrepancy.
        let source = case["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        memory.execute(&mut cpu, &init);
        if let Some(programme) = case["programme"].as_str() {
            for line in programme.split('\r').filter(|s| !s.is_empty()) {
                let (number, body) = line.split_once(' ').unwrap();
                store_line(&mut memory, &mut cpu, number.parse().unwrap(), body);
            }
        }
        let mode = symbol("EXEC_MODE").to_be_bytes();
        memory.bytes[25000..25010].copy_from_slice(&[
            0x86, 0xff, 0xb7, mode[0], mode[1], 0xb7, 0x63, 0x01, 0x39, 0x12,
        ]);
        install_legacy_hook_probe(&mut memory, &[0x18b, 0x194, 0x19a]);
        let initial = if source.is_empty() {
            "EXEC25000".to_string()
        } else {
            format!("{source}:EXEC25000")
        };
        let success = execute_direct_with_budget(&mut memory, &mut cpu, &initial, 8_388_608);
        assert_eq!(success, case["error"].is_null(), "{id}");
        if memory.bytes[0x6301] == 0 {
            assert!(
                execute_direct(&mut memory, &mut cpu, "EXEC25000"),
                "recovery {id}"
            );
        }
        let mut expected: Vec<(u16, Vec<u8>)> = case["events"]
            .as_array()
            .unwrap()
            .iter()
            .filter_map(|event| {
                let hook = u16::from_str_radix(event["hook"].as_str().unwrap(), 16).unwrap();
                if ![0x18b, 0x194, 0x19a].contains(&hook) {
                    return None;
                }
                Some((
                    hook,
                    event["textBytes"]
                        .as_array()
                        .unwrap()
                        .iter()
                        .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                        .collect(),
                ))
            })
            .collect();
        assert_eq!(
            expected.remove(0).0,
            0x19a,
            "arming statement boundary {id}"
        );
        let mut actual = Vec::new();
        for offset in (0..usize::from(memory.bytes[0x637e])).step_by(8) {
            let bytes = &memory.bytes[0x6400 + offset..0x6408 + offset];
            actual.push((
                [0x18b, 0x18e, 0x194, 0x19a, 0x1a3, 0x1a6][usize::from(bytes[0])],
                bytes[6..8].to_vec(),
            ));
        }
        if actual != expected {
            differences.push(format!("{id}: expected{expected:?}, actual{actual:?}"));
        }
        assert_eq!(cpu.registers.s, 0x7000, "{id}");
        assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0, "{id}");
    }
    assert!(differences.is_empty(), "{}", differences.join("\n"));
}

#[test]
fn candidate_error_hook_selectors_match_all_observed_legacy_errors() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/7a6dd387707c1d8d-observations.json"
    ))
    .unwrap();
    let mut observed = std::collections::BTreeSet::new();
    for case in facts["cases"].as_array().unwrap() {
        if case.get("replaceError").is_some() {
            continue;
        }
        let Some(error) = case["error"].as_str() else {
            continue;
        };
        if !observed.insert(error.to_string()) {
            continue;
        }
        let events: Vec<_> = case["events"]
            .as_array()
            .unwrap()
            .iter()
            .filter(|e| e["hook"] == "018e")
            .collect();
        assert_eq!(events.len(), 1);
        let selector = u8::try_from(events[0]["b"].as_u64().unwrap()).unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        let table = usize::from(symbol("ERROR_CODES"));
        let code = (0..26)
            .find(|n| &memory.bytes[table + 2 * n..table + 2 * n + 2] == error.as_bytes())
            .unwrap();
        memory.bytes[usize::from(symbol("ERROR_CODE"))] = u8::try_from(code * 2).unwrap();
        set_word(&mut memory, 0x68, 0xffff);
        install_legacy_hook_probe(&mut memory, &[0x18e]);
        let mut probe = vec![0x8e, 0x02, 0xdd];
        call(&mut probe, symbol("BASIC_ERROR"));
        memory.execute(&mut cpu, &probe);
        assert_eq!(memory.bytes[0x637e], 8, "one error hook {error}");
        assert_eq!(memory.bytes[0x6402], selector, "legacy selector {error}");
        assert_eq!(
            memory.bytes[usize::from(symbol("ERROR_CODE"))],
            u8::try_from(code * 2).unwrap(),
            "private enum {error}"
        );
        assert_eq!(memory.output, format!("?{error} ERROR\r").as_bytes());
        assert_eq!(cpu.registers.s, 0x7000);
    }
    assert_eq!(
        observed.len(),
        26,
        "every implemented error selector is observed"
    );
}

#[test]
fn candidate_hooks_accept_public_cursor_error_and_saved_return_changes() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    install_legacy_hook_programme(
        &mut memory,
        &[0x18b],
        include_str!(
            "fixtures/complete-basic/17dc3ef5780cffae-callback-operand-cursor-change.json"
        ),
    );
    assert!(execute_direct(&mut memory, &mut cpu, "A=123"));
    assert_eq!(numeric_scalar(&memory, [b'A', 0]), packed_integer(23));
    assert_eq!(cpu.registers.s, 0x7000);

    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    install_legacy_hook_programme(
        &mut memory,
        &[0x18e],
        include_str!("fixtures/complete-basic/188859b4de18f847-callback-replace-SN-with-FC.json"),
    );
    memory.bytes[usize::from(symbol("ERROR_CODE"))] = 2;
    set_word(&mut memory, 0x68, 0xffff);
    let mut probe = Vec::new();
    call(&mut probe, symbol("BASIC_ERROR"));
    memory.execute(&mut cpu, &probe);
    assert_eq!(memory.output, b"?FC ERROR\r");
    assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 8);
    assert_eq!(cpu.registers.s, 0x7000);

    for bypass in [false, true] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        if bypass {
            install_legacy_hook_programme(
                &mut memory,
                &[0x19a],
                include_str!(
                    "fixtures/complete-basic/05eca8d73ed9d073-callback-statement-skip-break.json"
                ),
            );
        }
        let mut keys = [0; 8];
        keys[2] = 64;
        memory.key_matrix = Some(keys);
        assert!(execute_direct(&mut memory, &mut cpu, "A=1:A=A+2"));
        assert_eq!(
            numeric_scalar(&memory, [b'A', 0]),
            packed_integer(if bypass { 3 } else { 1 }),
            "bypass={bypass}"
        );
        assert_eq!(cpu.registers.s, 0x7000);
        assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0);
    }
}

#[test]
fn console_keyboard_rewrite_preserves_pairs_rollover_registers_and_bus_writes() {
    let previous = include_bytes!("fixtures/complete-basic/54430833aa400298-candidate.bin");
    let previous_symbols = include_str!("fixtures/complete-basic/de34a16480ee3120-candidate.sym");
    let previous_entry = previous_symbols
        .lines()
        .find(|s| s.starts_with("KEYIN EQU $"))
        .unwrap();
    let previous_entry =
        u16::from_str_radix(previous_entry.split('$').nth(1).unwrap(), 16).unwrap();
    for first in 0..56 {
        for second in first..56 {
            for shift in [false, true] {
                for lock in [0, 1, 255] {
                    let mut old = Memory::new();
                    old.bytes[0x8000..0x8000 + previous.len()].copy_from_slice(previous);
                    let mut new = Memory::new();
                    let mut old_cpu = Cpu::default();
                    let mut new_cpu = Cpu::default();
                    let mut keys = [0; 8];
                    for index in [first, second] {
                        keys[index % 8] |= 1 << (index / 8);
                    }
                    if shift {
                        keys[7] |= 64;
                    }
                    for memory in [&mut old, &mut new] {
                        memory.bytes[0x149] = lock;
                        memory.bytes[0x150..0x15a].fill(255);
                    }
                    for matrix in [keys, keys, [0; 8], keys] {
                        old.key_matrix = Some(matrix);
                        new.key_matrix = Some(matrix);
                        for cpu in [&mut old_cpu, &mut new_cpu] {
                            cpu.registers = Registers {
                                a: 0xa5,
                                b: 0x5a,
                                x: 0x4567,
                                y: 0x5678,
                                u: 0x6789,
                                cc: u8::try_from((first * 4 + second) & 0xff).unwrap(),
                                ..Registers::default()
                            };
                        }
                        let old_start = old.cycles;
                        let new_start = new.cycles;
                        old.signals.clear();
                        new.signals.clear();
                        let mut call_old = Vec::new();
                        call(&mut call_old, previous_entry);
                        let mut call_new = Vec::new();
                        call(&mut call_new, symbol("KEYIN"));
                        old.execute(&mut old_cpu, &call_old);
                        new.execute(&mut new_cpu, &call_new);
                        assert_eq!(
                            (
                                new_cpu.registers.a,
                                new_cpu.registers.b,
                                new_cpu.registers.x,
                                new_cpu.registers.y,
                                new_cpu.registers.u,
                                new_cpu.registers.s,
                                new_cpu.registers.cc
                            ),
                            (
                                old_cpu.registers.a,
                                old_cpu.registers.b,
                                old_cpu.registers.x,
                                old_cpu.registers.y,
                                old_cpu.registers.u,
                                old_cpu.registers.s,
                                old_cpu.registers.cc
                            ),
                            "keys {first}/{second} shift {shift} lock {lock}"
                        );
                        assert_eq!(&new.bytes[..0x400], &old.bytes[..0x400]);
                        assert_eq!(new.bytes[0xff02], old.bytes[0xff02]);
                        let old_bus: Vec<_> = old
                            .signals
                            .iter()
                            .map(|(cycle, a, v)| (cycle - old_start, *a, *v))
                            .collect();
                        let new_bus: Vec<_> = new
                            .signals
                            .iter()
                            .map(|(cycle, a, v)| (cycle - new_start, *a, *v))
                            .collect();
                        assert_eq!(new_bus, old_bus);
                    }
                }
            }
        }
    }
}

fn install_authored_extensions(memory: &mut Memory, chain: bool) {
    memory.bytes[0x6000..0x6006].copy_from_slice(b"ZA\xd0ZO\xd4");
    memory.bytes[0x6020..0x6028].copy_from_slice(b"ZIN\xc7ZON\xc7");
    memory.bytes[0x12a..0x13e].fill(0);
    memory.bytes[0x12a..0x134].copy_from_slice(&[2, 0x60, 0, 0x61, 0, 2, 0x60, 0x20, 0x61, 0x40]);
    for (address, function) in [(0x6100, false), (0x6140, true)] {
        // Retain only authored entry registers/public cursor and continue.
        let mut code = vec![
            0xfd, 0x63, 0, 0xbf, 0x63, 8, 0xdc, 0xa6, 0xfd, 0x63, 2, 0x7c, 0x63, 4,
        ];
        for _ in 0..if function { 3 } else { 1 } {
            call(&mut code, 0x009f);
        }
        if function {
            code.extend([0xcc, 0, 123, 0x7e, 0x8c, 0x37]);
        } else {
            code.push(0x39);
        }
        memory.bytes[address..address + code.len()].copy_from_slice(&code);
    }
    if chain {
        memory.bytes[0x6010..0x6013].copy_from_slice(b"ZU\xd0");
        memory.bytes[0x6030..0x6034].copy_from_slice(b"ZUN\xc7");
        memory.bytes[0x134..0x13e]
            .copy_from_slice(&[1, 0x60, 0x10, 0x61, 0x80, 1, 0x60, 0x30, 0x61, 0xc0]);
        memory.bytes[0x13e..0x148].fill(0);
        // These must never be used: all extension execution routes to STUB1.
        memory.bytes[0x6180..0x6184].copy_from_slice(&[0x7c, 0x63, 7, 0x39]);
        memory.bytes[0x61c0..0x61c4].copy_from_slice(&[0x7c, 0x63, 7, 0x39]);
    }
}
#[test]
fn public_token_descriptors_chain_rebind_and_stop_each_kind_independently() {
    let mut m = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut m);
    install_authored_extensions(&mut m, true);
    for (text, tokens) in [
        ("ZAP", vec![0xce]),
        ("ZOT", vec![0xcf]),
        ("ZUP", vec![0xd0]),
        ("ZING(7)", vec![0xff, 0xa2, b'(', b'7', b')']),
        ("ZUNG(7)", vec![0xff, 0xa4, b'(', b'7', b')']),
    ] {
        assert_eq!(guest_tokens(&mut m, &mut cpu, text), tokens, "{text}");
    }
    m.bytes[0x12a] = 0;
    assert_eq!(guest_tokens(&mut m, &mut cpu, "ZUP"), b"ZUP");
    assert_eq!(
        guest_tokens(&mut m, &mut cpu, "ZUNG(7)"),
        [0xff, 0xa4, b'(', b'7', b')']
    );
    m.bytes[0x12f] = 0;
    assert_eq!(guest_tokens(&mut m, &mut cpu, "ZUNG(7)"), b"ZUNG(7)");
    install_authored_extensions(&mut m, false);
    store_line(&mut m, &mut cpu, 10, "ZAP");
    store_line(&mut m, &mut cpu, 20, "A=ZING(7)");
    m.bytes[0x6000..0x6003].copy_from_slice(b"ZI\xd0");
    m.bytes[0x6020..0x6024].copy_from_slice(b"ZAN\xc7");
    enable_guest_printer(&mut m);
    assert!(execute_direct(&mut m, &mut cpu, "LIST"));
    let output = String::from_utf8_lossy(&m.output);
    assert!(output.contains("10 ZIP"), "{output}");
    assert!(output.contains("20 A=ZANG(7)"), "{output}");
}
#[test]
fn extension_dispatch_uses_legacy_tokens_arguments_and_public_cursor() {
    for (text, entry_a, entry_b, cursor) in [
        ("ZAP:POKE25349,85", 0xce, None, 0x2dc),
        ("ZOT:POKE25349,85", 0xcf, None, 0x2dc),
        ("A=ZING(7):POKE25349,85", b'(', Some(68), 0x2e0),
        ("A=ZONG(7):POKE25349,85", b'(', Some(70), 0x2e0),
        ("ZUP:POKE25349,85", 0xd0, None, 0x2dc),
        ("A=ZUNG(7):POKE25349,85", b'(', Some(72), 0x2e0),
    ] {
        let mut m = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut m);
        install_authored_extensions(&mut m, true);
        assert!(execute_direct(&mut m, &mut cpu, text), "{text}");
        assert_eq!(m.bytes[0x6300], entry_a, "{text}");
        if let Some(b) = entry_b {
            assert_eq!(m.bytes[0x6301], b, "{text}");
        }
        assert_eq!(word(&m, 0x6302), cursor, "{text}");
        assert_eq!(m.bytes[0x6304], 1, "{text}");
        assert_eq!(m.bytes[0x6305], 85, "{text}");
        assert_eq!(m.bytes[0x6307], 0, "{text}");
        if text.starts_with("A=") {
            assert_eq!(&m.bytes[0x1e05..0x1e0a], &packed_integer(123), "{text}");
        }
    }
}
#[test]
fn primary_rebound_table_receives_native_table_entry_and_parsed_value() {
    for function in [false, true] {
        let mut m = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut m);
        install_authored_extensions(&mut m, false);
        let field = if function { 0x125 } else { 0x120 };
        let words = if function { 0x6020 } else { 0x6000 };
        m.bytes[field] = 1;
        set_word(&mut m, field + 1, words);
        set_word(&mut m, field + 3, 0x6050);
        set_word(&mut m, 0x6050, 0x6100);
        let callback = [
            0xfd, 0x63, 0, 0xbf, 0x63, 8, 0xdc, 0xa6, 0xfd, 0x63, 2, 0x7c, 0x63, 4, 0x39,
        ];
        m.bytes[0x6100..0x6100 + callback.len()].copy_from_slice(&callback);
        let text = if function { "A=ZING(7)" } else { "ZAP" };
        assert!(execute_direct(&mut m, &mut cpu, text), "{text}");
        assert_eq!(m.bytes[0x6300], 0);
        assert_eq!(m.bytes[0x6301], 0);
        assert_eq!(word(&m, 0x6308), 0x6050);
        assert_eq!(word(&m, 0x6302), if function { 0x2e3 } else { 0x2dd });
        assert_eq!(m.bytes[0x6304], 1);
        if function {
            assert_eq!(&m.bytes[0x1e05..0x1e0a], &packed_integer(7));
        }
    }
}
#[test]
fn rebound_primary_function_honours_returning_public_cursor() {
    let mut m = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut m);
    install_authored_extensions(&mut m, false);
    m.bytes[0x125] = 1;
    set_word(&mut m, 0x126, 0x6020);
    set_word(&mut m, 0x128, 0x6050);
    set_word(&mut m, 0x6050, 0x6100);
    let callback = [
        0xfd, 0x63, 0, 0xbf, 0x63, 8, 0xdc, 0xa6, 0xfd, 0x63, 2, 0xc3, 0, 2, 0xdd, 0xa6, 0xcc, 0,
        123, 0x7e, 0x8c, 0x37,
    ];
    m.bytes[0x6100..0x6100 + callback.len()].copy_from_slice(&callback);
    assert!(execute_direct(&mut m, &mut cpu, "A=ZING(7)+5:POKE25349,85"));
    assert_eq!(m.bytes[0x6300], 0xc3);
    assert_eq!(m.bytes[0x6301], 0);
    assert_eq!(word(&m, 0x6308), 0x6050);
    assert_eq!(word(&m, 0x6302), 0x2e3);
    assert_eq!(&m.bytes[0x1e05..0x1e0a], &packed_integer(123));
    assert_eq!(m.bytes[0x6305], 85);
}
#[test]
fn tokeniser_crunch_hook_sees_raw_input_then_tokens_use_previous_byte() {
    let mut m = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut m);
    install_authored_extensions(&mut m, false);
    m.bytes[0x2dd..0x2e1].copy_from_slice(b"ZAP\0");
    let callback = [
        0xfd, 0x63, 0, 0xbf, 0x63, 8, 0xdc, 0xa6, 0xfd, 0x63, 2, 0x39,
    ];
    m.bytes[0x6100..0x6100 + callback.len()].copy_from_slice(&callback);
    m.bytes[0x1a3..0x1a6].copy_from_slice(&[0x7e, 0x61, 0]);
    let mut code = vec![0x8e, 2, 0xdd];
    call(&mut code, symbol("TOKENISE"));
    m.execute_with_budget(&mut cpu, &code, 1_048_576);
    assert_eq!(cpu.registers.cc & C, 0);
    assert_eq!(m.bytes[0x6300], b'Z');
    assert_eq!(word(&m, 0x6308), 0x2dc);
    assert_eq!(word(&m, 0x6302), 0x2dd);
    assert_eq!(&m.bytes[0x2dc..0x2de], &[0xce, 0]);
}
#[test]
fn rebound_statement_table_preserves_legacy_command_cutoff() {
    for ordinal in [58usize, 59, 77] {
        let mut m = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut m);
        for index in 0..78 {
            m.bytes[0x6600 + index * 3..0x6603 + index * 3].copy_from_slice(if index == ordinal {
                b"ZA\xd0"
            } else {
                b"QQ\xd1"
            });
            set_word(&mut m, 0x6700 + index * 2, 0x6100);
        }
        set_word(&mut m, 0x121, 0x6600);
        set_word(&mut m, 0x123, 0x6700);
        let callback = [
            0xfd, 0x63, 0, 0xbf, 0x63, 8, 0xdc, 0xa6, 0xfd, 0x63, 2, 0x7c, 0x63, 4, 0x39,
        ];
        m.bytes[0x6100..0x6100 + callback.len()].copy_from_slice(&callback);
        let ok = execute_direct(&mut m, &mut cpu, "ZAP");
        assert_eq!(ok, ordinal == 58);
        assert_eq!(m.bytes[0x6304], u8::from(ordinal == 58));
        if ordinal == 58 {
            assert_eq!(m.bytes[0x6300], 0);
            assert_eq!(m.bytes[0x6301], 116);
            assert_eq!(word(&m, 0x6308), 0x6774);
            assert_eq!(word(&m, 0x6302), 0x2dd);
        }
    }
}

#[test]
fn published_input_pointer_addresses_real_reply_bytes_and_line_input_preserves_it() {
    for (source, replies, retained, cursor) in [
        ("INPUT A", b"7\r".as_slice(), b"7\0".as_slice(), 0x02de),
        (
            "INPUT A,B",
            b"7,9\r".as_slice(),
            b"7,9\0".as_slice(),
            0x02e0,
        ),
        (
            "INPUT A,B",
            b"X\r7,9\r".as_slice(),
            b"7,9\0".as_slice(),
            0x02e0,
        ),
        (
            "LINE INPUT A$",
            b"ABC\r".as_slice(),
            b"ABC\0".as_slice(),
            0x5555,
        ),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        set_word(&mut memory, 0x35, 0x5555);
        memory.bytes[0x70] = 0xaa;
        supply_original_keyboard(&mut memory, replies);
        assert!(execute_input_programme(&mut memory, &mut cpu, source));
        assert_eq!(word(&memory, 0x35), cursor, "{source}");
        assert_eq!(
            &memory.bytes[0x2dd..0x2dd + retained.len()],
            retained,
            "{source}"
        );
        assert_eq!(memory.bytes[0x70], 0, "the keyboard supplied characters");
    }
}

#[test]
fn published_eof_flag_reports_reads_and_preserves_open_and_peek_state() {
    for (body, flag, pointer, success) in [
        ("POKE112,170", 170, 0x5555, true),
        ("POKE112,170:OPEN\"I\",#-1,\"OWNDATA\"", 170, 0x5555, true),
        (
            "OPEN\"I\",#-1,\"OWNDATA\":POKE112,170:B=EOF(-1)",
            170,
            0x5555,
            true,
        ),
        (
            "OPEN\"I\",#-1,\"OWNDATA\":POKE112,170:INPUT#-1,A",
            0,
            0x02de,
            true,
        ),
        (
            "OPEN\"I\",#-1,\"OWNDATA\":INPUT#-1,A:POKE112,170:B=EOF(-1)",
            170,
            0x02de,
            true,
        ),
        (
            "OPEN\"I\",#-1,\"OWNDATA\":INPUT#-1,A:INPUT#-1,B",
            255,
            0x02dc,
            false,
        ),
        (
            "OPEN\"I\",#-1,\"OWNDATA\":LINE INPUT#-1,A$",
            0,
            0x5555,
            true,
        ),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(&mut memory, &mut cpu, 10, body);
        set_word(&mut memory, 0x35, 0x5555);
        memory.bytes[0x70] = 0xaa;
        synthetic_tape(&mut memory, &own_data_cassette(b"7\r", 255));
        memory.tape_clock = Some(memory.cycles);
        assert_eq!(
            execute_direct_with_budget(&mut memory, &mut cpu, "RUN", 64_000_000),
            success,
            "{body}"
        );
        assert_eq!(word(&memory, 0x35), pointer, "{body}");
        assert_eq!(memory.bytes[0x70], flag, "{body}");
        if pointer == 0x02de {
            assert_eq!(&memory.bytes[0x2dd..0x2df], b"7\0", "{body}");
        }
        if !success {
            assert_eq!(candidate_error_index(&memory), 9);
            supply_original_keyboard(&mut memory, b"9\r");
            assert!(execute_input_programme(&mut memory, &mut cpu, "INPUT C"));
            assert_eq!(memory.bytes[0x70], 0);
            assert_eq!(word(&memory, 0x35), 0x02de);
            assert_eq!(numeric_scalar(&memory, [b'C', 0]), packed_integer(9));
        }
    }
}

#[test]
fn published_motor_delay_has_cold_default_wrapping_count_and_fixed_pulse_payload() {
    let cold = cold_boot_to_probe("EXEC25000\r");
    assert_eq!(word(&cold, 0x95), 0xda5c);
    assert_eq!(word(&cold, 0x35), 0);
    assert_eq!(cold.bytes[0x70], 0);
    for entry in [0x8015, 0x8018, 0x801b] {
        let mut clocks = Vec::new();
        for delay in [1_u16, 2, 100, 65535, 0] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            memory.bytes[0xff21] = 0x34;
            set_word(&mut memory, 0x95, delay);
            set_word(&mut memory, 0x90, 1);
            cpu.registers.x = 0x4567;
            cpu.registers.cc = C;
            let mut code = Vec::new();
            call(&mut code, entry);
            memory.execute_with_budget(&mut cpu, &code, 1_048_576);
            assert_eq!(word(&memory, 0x95), delay);
            assert_eq!(cpu.registers.x, 0x4567);
            assert_eq!(memory.bytes[0xff21] & 8 != 0, entry != 0x8018);
            if entry != 0x801b {
                assert_ne!(cpu.registers.cc & C, 0);
            }
            clocks.push(memory.cycles);
        }
        let multiplier = if entry == 0x8018 { 0 } else { 8 };
        for (index, difference) in [(1, 1_u64), (2, 99), (3, 65534), (4, 65535)] {
            assert_eq!(
                clocks[index] - clocks[0],
                multiplier * difference,
                "entry {entry:04x}"
            );
        }
    }
}

#[test]
fn public_input_buffer_keeps_run_suffix_and_nested_stop_continuation_valid() {
    let memory = cold_boot_to_probe(concat!(
        "10 FOR I=1 TO 2\r20 GOSUB100\r30 NEXT I\r40 EXEC25000\r",
        "100 INPUT A:STOP:B=B+A:RETURN\r",
        "RUN:POKE25350,99\r7\rCONT\r9\rCONT\r"
    ));
    assert_eq!(numeric_scalar(&memory, [b'I', 0]), packed_integer(3));
    assert_eq!(numeric_scalar(&memory, [b'A', 0]), packed_integer(9));
    assert_eq!(numeric_scalar(&memory, [b'B', 0]), packed_integer(16));
    assert_eq!(
        memory.bytes[25350], 0,
        "RUN transfers to the programme before its direct suffix"
    );
}

#[test]
fn public_input_strings_survive_following_replies_and_garbage_collection() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    supply_original_keyboard(&mut memory, b"Mixed,Reply\rOther reply\r");
    assert!(execute_input_programme(
        &mut memory,
        &mut cpu,
        "CLEAR100:DIM B$(1):INPUT A$:B$(1)=A$:LINE INPUT C$:FOR I=1 TO 80:D$=A$+C$:NEXT I:PRINT A$;B$(1);C$"
    ));
    assert!(memory.output.ends_with(b"MixedMixedOther reply\r"));
    assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0);
    assert!(execute_direct(&mut memory, &mut cpu, "PRINT A$;B$(1);C$"));
    assert!(memory.output.ends_with(b"MixedMixedOther reply\r"));
}

struct PublicJoystickBus {
    memory: Memory,
    axes: [u8; 4],
    buttons: bool,
}
impl Bus for PublicJoystickBus {
    fn read(&mut self, address: u16) -> u8 {
        if address == 0xff00 {
            // Match the current Board comparator and independent mux pins.
            let selected = usize::from((self.memory.bytes[0xff01] >> 3) & 1)
                | (usize::from((self.memory.bytes[0xff03] >> 3) & 1) << 1);
            let mut value = if self.buttons { 0xfc } else { 0xff };
            if self.axes[selected] <= self.memory.bytes[0xff20] >> 2 {
                value &= 0x7f;
            }
            value
        } else {
            self.memory.read(address)
        }
    }
    fn write(&mut self, address: u16, value: u8) {
        self.memory.write(address, value);
    }
    fn tick(&mut self, clocks: u32) {
        self.memory.tick(clocks);
    }
}

#[test]
fn published_joystick_entries_match_thresholds_four_axes_and_final_mux() {
    for (axes, expected) in [
        ([0, 17, 42, 63], [0, 16, 41, 62]),
        ([63, 0, 32, 1], [62, 0, 31, 0]),
        ([0; 4], [0; 4]),
        ([63; 4], [62; 4]),
        ([32; 4], [31; 4]),
        ([1, 2, 3, 4], [0, 1, 2, 3]),
        ([30, 31, 32, 33], [29, 30, 31, 32]),
        ([60, 61, 62, 63], [59, 60, 61, 62]),
        // An overrange comparator threshold proves the ADC's 63 saturation.
        // This does not extend the host joystick API beyond its 0–63 contract.
        ([64; 4], [63; 4]),
    ] {
        for indirect in [false, true] {
            for buttons in [false, true] {
                let mut bus = PublicJoystickBus {
                    memory: Memory::new(),
                    axes,
                    buttons,
                };
                bus.memory.bytes[0xff01] = 0x34;
                bus.memory.bytes[0xff03] = 0x34;
                bus.memory.bytes[0xff20] = 2;
                let code: &[u8] = if indirect {
                    &[0xad, 0x9f, 0xa0, 0x0a]
                } else {
                    &[0xbd, 0x80, 0x12]
                };
                bus.memory.bytes[0x6100..0x6100 + code.len()].copy_from_slice(code);
                let mut cpu = Cpu::default();
                cpu.registers = Registers {
                    pc: 0x6100,
                    s: 0x7000,
                    y: 0x3456,
                    u: 0x4567,
                    ..Registers::default()
                };
                for _ in 0..16384 {
                    if usize::from(cpu.registers.pc) == 0x6100 + code.len() {
                        break;
                    }
                    cpu.step(&mut bus).unwrap();
                }
                assert_eq!(usize::from(cpu.registers.pc), 0x6100 + code.len());
                assert_eq!(
                    &bus.memory.bytes[0x15a..0x15e],
                    &expected,
                    "{axes:?}, indirect {indirect}"
                );
                assert_eq!(
                    (bus.memory.bytes[0xff01], bus.memory.bytes[0xff03]),
                    (0x34, 0x34)
                );
                assert_eq!(
                    (cpu.registers.y, cpu.registers.u, cpu.registers.s),
                    (0x3456, 0x4567, 0x7000)
                );
            }
        }
    }
}

#[test]
fn published_blink_reloads_fifty_and_only_toggles_the_cursor_cell() {
    for (count, repetitions, expected_count, toggles) in [
        (0, 1, 255, false),
        (0, 2, 254, false),
        (0, 256, 50, true),
        (1, 1, 50, true),
        (1, 2, 49, true),
        (1, 256, 45, false),
        (2, 1, 1, false),
        (2, 2, 50, true),
        (2, 256, 46, false),
        (255, 1, 254, false),
        (255, 2, 253, false),
        (255, 256, 49, true),
    ] {
        for cell in [0, 0x20, 0x40, 0x60, 0x80, 0xff] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            set_word(&mut memory, 0x88, 0x0407);
            memory.bytes[0x8f] = count;
            memory.bytes[0x406..0x409].copy_from_slice(&[0x55, cell, 0xaa]);
            cpu.registers = Registers {
                a: 0x11,
                b: 0x22,
                x: 0x3344,
                y: 0x5566,
                u: 0x7788,
                ..Registers::default()
            };
            for _ in 0..repetitions {
                memory.execute(&mut cpu, &[0xbd, 0x80, 0x09]);
            }
            assert_eq!(
                memory.bytes[0x8f], expected_count,
                "count {count}, repeats {repetitions}"
            );
            assert_eq!(
                &memory.bytes[0x406..0x409],
                &[0x55, cell ^ if toggles { 0x40 } else { 0 }, 0xaa]
            );
            assert_eq!(word(&memory, 0x88), 0x0407);
            assert_eq!(
                (
                    cpu.registers.a,
                    cpu.registers.b,
                    cpu.registers.x,
                    cpu.registers.y,
                    cpu.registers.u
                ),
                (0x11, 0x22, 0x3344, 0x5566, 0x7788)
            );
        }
    }
}

#[test]
fn storage_domain_segment_collection_matches_canonical_alias_compaction() {
    // Original generated intervals. Their order deliberately lets a late root
    // join intervals which an earlier scan passed, without a closure rescan.
    let mut sets: Vec<Vec<(u16, u8)>> = vec![
        vec![(0x6100, 5), (0x6120, 16), (0x6103, 34)],
        vec![(0x6130, 8), (0x6100, 8), (0x6107, 42)],
        vec![(0x6100, 64), (0x613f, 1), (0x6120, 32), (0x6100, 64)],
    ];
    let mut random = 6809_u32;
    for _ in 0..256 {
        let mut roots = Vec::new();
        for _ in 0..16 {
            random = random.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
            let start = 0x6100 + u16::try_from((random >> 16) & 127).unwrap();
            random = random.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
            let length = 1 + u8::try_from((random >> 16) & 63).unwrap();
            roots.push((start, length));
        }
        sets.push(roots);
    }
    let mut peak_cycles = 0;
    for (case, roots) in sets.iter().enumerate() {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        let table = 0x3000;
        let end = table + roots.len() * 7;
        set_word(&mut memory, 0x1b, u16::try_from(table).unwrap());
        set_word(&mut memory, 0x1d, u16::try_from(end).unwrap());
        set_word(&mut memory, 0x1f, u16::try_from(end).unwrap());
        set_word(&mut memory, 0x21, 0x6000);
        set_word(&mut memory, 0x23, 0x6000);
        for a in 0x6100..0x6200 {
            memory.bytes[a] = u8::try_from((a * 73 + 11) & 255).unwrap();
        }
        let mut live = std::collections::BTreeSet::new();
        for (index, &(start, length)) in roots.iter().enumerate() {
            let record = table + index * 7;
            memory.bytes[record..record + 7]
                .copy_from_slice(&[b'A', 128, length, 0x5a, 0, 0, 0xa5]);
            set_word(&mut memory, record + 4, start);
            for address in start..start + u16::from(length) {
                live.insert(address);
            }
        }
        let live: Vec<_> = live.into_iter().collect();
        let expected: Vec<_> = live.iter().map(|&a| memory.bytes[usize::from(a)]).collect();
        let first = 0x7fff - live.len();
        let pointer =
            |start: u16| u16::try_from(first + live.binary_search(&start).unwrap()).unwrap();
        let mut code = Vec::new();
        call(&mut code, symbol("STRING_COLLECT"));
        memory.execute_with_budget(&mut cpu, &code, 1_048_576);
        assert_eq!(cpu.registers.cc & C, 0, "case {case}");
        assert_eq!(
            word(&memory, 0x23),
            u16::try_from(first - 1).unwrap(),
            "case {case}"
        );
        assert_eq!(&memory.bytes[first..0x7fff], &expected, "case {case}");
        for (index, &(start, length)) in roots.iter().enumerate() {
            let record = table + index * 7;
            assert_eq!(
                word(&memory, record + 4),
                pointer(start),
                "case {case}, root {index}"
            );
            assert_eq!(memory.bytes[record + 2], length);
            assert_eq!(memory.bytes[record + 3], 0x5a);
            assert_eq!(memory.bytes[record + 6], 0xa5);
        }
        assert_eq!(cpu.registers.s, 0x7000);
        peak_cycles = peak_cycles.max(memory.cycles);
    }
    eprintln!(
        "segment collector: {} canonical cases, peak {peak_cycles} guest cycles",
        sets.len()
    );
}

#[test]
fn published_fixed_aliases_and_all_pointer_words_route_to_the_qualified_implementations() {
    let memory = Memory::new();
    for (address, target) in [
        (0x8000, "HW_INIT"),
        (0x8003, "SETUP"),
        (0x8006, "KEYIN"),
        (0x8009, "BLINK"),
        (0x800c, "SCREENOUT"),
        (0x800f, "PRINTEROUT"),
        (0x8012, "JOYIN"),
        (0x8015, "MOTORON"),
        (0x8018, "MOTOROFF"),
        (0x801b, "TAPE_PREP"),
        (0x801e, "TAPE_BYTE_OUT"),
        (0x8021, "TAPE_SYNC"),
        (0x8024, "TAPE_BYTE_IN"),
        (0x8027, "TAPE_BIT_IN"),
        (0x84d6, "EXECUTE_STATEMENT"),
        (0x8b2d, "PUBLIC_FAC_TO_INT"),
        (0x8b30, "PUBLIC_FAC_WORD"),
        (0x8c37, "INT_TO_FAC"),
        (0xb3b4, "BOOT"),
        (0xb54a, "CHROUT"),
        (0xb93e, "TAPE_BLOCK_IN"),
        (0xb999, "TAPE_BLOCK_OUT"),
        (0xbb40, "HW_INIT"),
        (0xbbb5, "BLINK"),
        (0xbbbb, "SETUP"),
        (0xbbe5, "KEYIN"),
        (0xbd52, "JOYIN"),
        (0xbda5, "TAPE_BIT_IN"),
        (0xbdad, "TAPE_BYTE_IN"),
        (0xbe12, "TAPE_BYTE_OUT"),
        (0xbe6a, "TAPE_PREP"),
    ] {
        assert_eq!(memory.bytes[address], 0x7e, "fixed JMP {address:04x}");
        assert_eq!(
            word(&memory, address + 1),
            symbol(target),
            "fixed target {address:04x}"
        );
    }
    for (index, target) in [
        "KEYIN",
        "CHROUT",
        "TAPE_SYNC",
        "TAPE_BLOCK_IN",
        "TAPE_BLOCK_OUT",
        "JOYIN",
        "TAPE_PREP",
    ]
    .into_iter()
    .enumerate()
    {
        assert_eq!(
            word(&memory, 0xa000 + 2 * index),
            symbol(target),
            "pointer table {target}"
        );
    }
}

#[test]
fn published_pointer_call_forms_match_direct_public_results() {
    for (entry, target) in [
        (0xa000, "KEYIN"),
        (0xa002, "CHROUT"),
        (0xa004, "TAPE_SYNC"),
        (0xa006, "TAPE_BLOCK_IN"),
        (0xa008, "TAPE_BLOCK_OUT"),
        (0xa00a, "JOYIN"),
        (0xa00c, "TAPE_PREP"),
    ] {
        let mut outputs = Vec::new();
        for indirect in [false, true] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            memory.key_matrix = Some([0; 8]);
            memory.bytes[0x150..0x15a].fill(0xff);
            enable_guest_printer(&mut memory);
            memory.bytes[0x7c] = 1;
            memory.bytes[0x7d] = 3;
            set_word(&mut memory, 0x7e, 0x6400);
            memory.bytes[0x6400..0x6403].copy_from_slice(&[0x12, 0x34, 0x56]);
            set_word(&mut memory, 0x90, 1);
            set_word(&mut memory, 0x95, 1);
            let mut tape = Vec::new();
            append_synthetic_cassette_block(&mut tape, 1, &[0x12, 0x34, 0x56]);
            synthetic_tape(&mut memory, &tape);
            let mut code = Vec::new();
            if target == "TAPE_BLOCK_IN" {
                call(&mut code, 0x8021);
            }
            code.extend([0x86, b'Z']);
            if indirect {
                code.extend([
                    0xad,
                    0x9f,
                    u8::try_from(entry >> 8).unwrap(),
                    u8::try_from(entry & 0xff).unwrap(),
                ]);
            } else {
                call(&mut code, symbol(target));
            }
            memory.execute_with_budget(&mut cpu, &code, 2_097_152);
            assert_eq!(cpu.registers.s, 0x7000, "{target}");
            let r = cpu.registers;
            outputs.push((
                memory.bytes[..0x600].to_vec(),
                memory.bytes[0x6400..0x6403].to_vec(),
                memory.output,
                (r.a, r.b, r.x, r.y, r.u, r.s, r.dp, r.cc),
            ));
        }
        assert_eq!(
            outputs[0], outputs[1],
            "public pointer {entry:04x} {target}"
        );
    }
}

struct PublicInterruptBus {
    memory: Memory,
    lines: InterruptLines,
}
impl Bus for PublicInterruptBus {
    fn read(&mut self, address: u16) -> u8 {
        self.memory.read(address)
    }
    fn write(&mut self, address: u16, value: u8) {
        if address == 0x6300 {
            self.lines = InterruptLines::default();
        }
        self.memory.write(address, value);
    }
    fn tick(&mut self, cycles: u32) {
        self.memory.tick(cycles);
    }
    fn interrupts(&self) -> InterruptLines {
        self.lines
    }
}
#[test]
fn published_cpu_vectors_execute_each_patchable_ram_slot_and_return() {
    for (kind, slot, vector, opcode) in [
        (0, 0x100, 0xfff2, vec![0x11, 0x3f]),
        (1, 0x103, 0xfff4, vec![0x10, 0x3f]),
        (2, 0x106, 0xfffa, vec![0x3f]),
        (3, 0x109, 0xfffc, vec![]),
        (4, 0x10c, 0xfff8, vec![]),
        (5, 0x10f, 0xfff6, vec![]),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        let mut setup = Vec::new();
        call(&mut setup, 0x8003);
        memory.execute(&mut cpu, &setup);
        assert_eq!(word(&memory, vector), u16::try_from(slot).unwrap());
        assert_eq!(memory.bytes[slot], 0x7e);
        set_word(&mut memory, slot + 1, 0x6200);
        // Authored marker acknowledges the injected request before RTI.
        memory.bytes[0x6200..0x6204].copy_from_slice(&[0x7c, 0x63, 0, 0x3b]);
        memory.bytes[0x6100..0x6104].copy_from_slice(&[0x10, 0xce, 0x70, 0]);
        cpu.registers.pc = 0x6100;
        cpu.step(&mut memory).unwrap();
        memory.bytes[0x6104..0x6104 + opcode.len()].copy_from_slice(&opcode);
        let initial = Registers {
            a: 0x12,
            b: 0x34,
            x: 0x4567,
            y: 0x5678,
            u: 0x6789,
            s: 0x7000,
            pc: 0x6104,
            dp: 0x55,
            cc: C,
        };
        cpu.registers = initial;
        let mut bus = PublicInterruptBus {
            memory,
            lines: InterruptLines {
                irq: kind == 4,
                firq: kind == 5,
                nmi: kind == 3,
            },
        };
        let return_pc = 0x6104 + u16::try_from(opcode.len()).unwrap();
        cpu.step(&mut bus).unwrap();
        for _ in 0..16 {
            if cpu.registers.pc == return_pc && bus.memory.bytes[0x6300] == 1 {
                break;
            }
            cpu.step(&mut bus).unwrap();
        }
        assert_eq!(bus.memory.bytes[0x6300], 1, "route {slot:04x}");
        assert_eq!(
            cpu.registers,
            Registers {
                pc: return_pc,
                cc: if kind == 5 {
                    C
                } else {
                    C | eightbit_m6809_core::E
                },
                ..initial
            }
        );
    }
}

#[test]
fn published_timer_irq_carries_wraps_acknowledges_and_restores_registers() {
    for before in [0_u32, 0xfe, 0xff, 0xfffe, 0xffff, 0x00ff_fffe, 0x00ff_ffff] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        let mut setup = Vec::new();
        call(&mut setup, 0x8003);
        memory.execute(&mut cpu, &setup);
        memory.bytes[0x112..0x115].copy_from_slice(&before.to_be_bytes()[1..]);
        memory.bytes[0x111] = 0xa5;
        memory.bytes[0x115] = 0x5a;
        let initial = Registers {
            a: 0x12,
            b: 0x34,
            x: 0x4567,
            y: 0x5678,
            u: 0x6789,
            s: 0x7000,
            pc: 0x6100,
            dp: 0,
            cc: C,
        };
        cpu.registers = initial;
        memory.frame_pending = true;
        cpu.step(&mut memory).unwrap();
        for _ in 0..32 {
            if cpu.registers.pc == initial.pc {
                break;
            }
            cpu.step(&mut memory).unwrap();
        }
        assert_eq!(
            &memory.bytes[0x112..0x115],
            &((before + 1) & 0x00ff_ffff).to_be_bytes()[1..]
        );
        assert!(!memory.frame_pending);
        assert_eq!((memory.bytes[0x111], memory.bytes[0x115]), (0xa5, 0x5a));
        assert_eq!(
            cpu.registers,
            Registers {
                cc: C | eightbit_m6809_core::E,
                ..initial
            }
        );
    }
}

#[test]
fn published_reset_requires_fifty_five_and_a_nop_at_the_user_vector() {
    for flag in [0_u8, 1, 0x12, 0x54, 0x55, 0xff] {
        for nop in [false, true] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            let mut setup = Vec::new();
            call(&mut setup, 0x8003);
            memory.execute(&mut cpu, &setup);
            memory.bytes[0x6100..0x6106].copy_from_slice(&[
                if nop { 0x12 } else { 0x4f },
                0x7c,
                0x63,
                0,
                0x20,
                0xfe,
            ]);
            memory.bytes[0x71] = flag;
            set_word(&mut memory, 0x72, 0x6100);
            memory.bytes[0x99] = 90;
            cpu.reset(&mut memory);
            let mut ready = false;
            let keyboard = symbol("KEYIN");
            for _ in 0..100_000 {
                if memory.bytes[0x6300] == 1 || cpu.registers.pc == keyboard {
                    ready = true;
                    break;
                }
                cpu.step(&mut memory).unwrap();
            }
            assert!(ready, "reset flag={flag:02x} nop={nop}");
            let custom = flag == 0x55 && nop;
            assert_eq!(memory.bytes[0x6300], u8::from(custom));
            assert_eq!(memory.bytes[0x99], if custom { 90 } else { 16 });
            assert_eq!(memory.bytes[0x71], 0x55);
            assert_eq!(word(&memory, 0x19), 0x1e01);
        }
    }
}

#[test]
fn published_default_firq_filters_cart_and_enters_authored_cartridge_with_reset_disabled() {
    for cartridge in [false, true] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        let mut setup = Vec::new();
        call(&mut setup, symbol("BASIC_HW_INIT"));
        call(&mut setup, 0x8003);
        memory.execute(&mut cpu, &setup);
        assert_eq!(memory.bytes[0xff23], 0x37);
        assert_eq!(word(&memory, 0x110), symbol("CARTRIDGE_FIRQ"));
        memory.bytes[0xff23] = if cartridge { 0xb7 } else { 0x37 };
        memory.bytes[0xff21] = 0xb5; // An independent printer CA1 source remains pending.
        let initial = Registers {
            a: 0x12,
            b: 0x34,
            x: 0x4567,
            y: 0x5678,
            u: 0x6789,
            s: 0x7000,
            pc: 0x6100,
            dp: 0,
            cc: C,
        };
        cpu.registers = initial;
        let mut bus = PublicInterruptBus {
            memory,
            lines: InterruptLines {
                firq: true,
                ..InterruptLines::default()
            },
        };
        let start = bus.memory.cycles;
        cpu.step(&mut bus).unwrap();
        for _ in 0..500_000 {
            if cpu.registers.pc == if cartridge { 0xc000 } else { initial.pc } {
                break;
            }
            cpu.step(&mut bus).unwrap();
        }
        assert_eq!(bus.memory.bytes[0xff21], 0xb5, "non-CART source ownership");
        assert!(bus.lines.firq, "handler must not clear an unrelated source");
        if cartridge {
            assert_eq!(cpu.registers.pc, 0xc000);
            assert_eq!(bus.memory.bytes[0x71], 0);
            assert_eq!(bus.memory.bytes[0xff23], 0x34);
            assert_eq!(cpu.registers.s, 0x6ffd);
            assert_eq!(cpu.registers.cc & 0x50, 0x50);
            assert!(
                (1_048_576..1_049_000).contains(&(bus.memory.cycles - start)),
                "bounded independent settling interval"
            );
            // Install an authored marker only after the overflow candidate has
            // handed control to the public cartridge entry.
            bus.memory.bytes[0xc000..0xc00e].copy_from_slice(&[
                0x1f, 0xa8, 0xb7, 0x62, 1, 0x10, 0xff, 0x62, 2, 0x7c, 0x62, 0, 0x20, 0xfe,
            ]);
            for _ in 0..4 {
                cpu.step(&mut bus).unwrap();
            }
            assert_eq!(bus.memory.bytes[0x6200], 1);
            assert_eq!(bus.memory.bytes[0x6201] & 0x50, 0x50);
            assert_eq!(word(&bus.memory, 0x6202), 0x6ffd);
        } else {
            assert_eq!(cpu.registers, initial);
            assert_eq!(bus.memory.bytes[0x71], 0x55);
            assert_eq!(bus.memory.bytes[0xff23], 0x37);
        }
    }
}

// Authored solely from Inside the Dragon section 9.1 p224 and the retained
// exact-profile input/output observations; no implementation trace is used.
struct PublishedHardwareInitBus {
    memory: Memory,
    ram_reads: usize,
    ram_writes: usize,
}
impl Bus for PublishedHardwareInitBus {
    fn read(&mut self, address: u16) -> u8 {
        if address < 0x8000 {
            self.ram_reads += 1;
        }
        self.memory.read(address)
    }
    fn write(&mut self, address: u16, value: u8) {
        if address < 0x8000 {
            self.ram_writes += 1;
        }
        self.memory.write(address, value);
    }
    fn tick(&mut self, cycles: u32) {
        self.memory.tick(cycles);
    }
    fn interrupts(&self) -> InterruptLines {
        self.memory.interrupts()
    }
}
#[test]
fn published_hardware_initialisation_returns_through_y_without_stack_or_ram() {
    for entry in [0x8000, 0xbb40] {
        for stack in [0, 0x7000] {
            let mut bus = PublishedHardwareInitBus {
                memory: Memory::new(),
                ram_reads: 0,
                ram_writes: 0,
            };
            let mut cpu = Cpu::default();
            cpu.registers = Registers {
                a: 0x12,
                b: 0x34,
                x: 0x4567,
                y: 0x6100,
                u: 0x5678,
                s: stack,
                pc: entry,
                dp: 0x5a,
                cc: 0x50,
            };
            for _ in 0..5_000 {
                if cpu.registers.pc == 0x6100 {
                    break;
                }
                cpu.step(&mut bus).unwrap();
            }
            assert_eq!(
                cpu.registers.pc, 0x6100,
                "published Y continuation {entry:04x}"
            );
            assert_eq!(cpu.registers.s, stack);
            assert_eq!((bus.ram_reads, bus.ram_writes), (0, 0));
            assert_eq!(
                [
                    bus.memory.bytes[0xff01],
                    bus.memory.bytes[0xff03],
                    bus.memory.bytes[0xff21],
                    bus.memory.bytes[0xff23]
                ],
                [0x34; 4]
            );
        }
    }
}

#[test]
fn parameter_dispatch_preserves_native_comparison_registers_flags_and_first_match() {
    let mut memory = Memory::new();
    let profiles = [
        vec![0],
        vec![
            13, b'Q', b'A', b'L', 8, 32, b'D', b'C', b'I', b'X', b'H', b'S', b'K',
        ],
        vec![0xff, 0x80, 0x00, 0x7f, 0xff],
        (0..255).collect(),
    ];
    for keys in profiles {
        let mut template = Vec::new();
        call(&mut template, symbol("BYTE_EQUAL_DISPATCH"));
        template.push(u8::try_from(keys.len()).unwrap());
        let mut native = Vec::new();
        for (index, key) in keys.iter().enumerate() {
            let destination = 0x4000 + u16::try_from(index).unwrap();
            template.push(*key);
            template.extend(destination.to_be_bytes());
            native.extend([0x81, *key, 0x10, 0x27]); // CMPA #key; LBEQ target.
            let after_branch = 0x3000 + u16::try_from(native.len() + 2).unwrap();
            native.extend(destination.wrapping_sub(after_branch).to_be_bytes());
        }
        // A default path also uses an ordinary flag-preserving native JMP.
        template.extend([0x7e, 0x41, 0x00]);
        native.extend([0x7e, 0x41, 0x00]);
        memory.bytes[0x2000..0x2000 + template.len()].copy_from_slice(&template);
        memory.bytes[0x3000..0x3000 + native.len()].copy_from_slice(&native);
        for a in 0..=u8::MAX {
            // The short profiles exercise every incoming CC bit combination.
            // The maximal table also covers all 256 inputs and both states of
            // H/E/F/I, which CMPA preserves, without redundant low-bit cases.
            let flags: Vec<u8> = if keys.len() == 255 {
                vec![0, 0xff]
            } else {
                (0..=u8::MAX).collect()
            };
            for cc in flags {
                let initial = Registers {
                    a,
                    b: 0x5a,
                    x: 0x1234,
                    y: 0x5678,
                    u: 0x9abc,
                    s: 0x7000,
                    dp: 0x42,
                    cc,
                    pc: 0x2000,
                };
                let run = |memory: &mut Memory, pc| {
                    let mut cpu = Cpu::default();
                    cpu.registers = Registers { pc, ..initial };
                    for _ in 0..4096 {
                        if (0x4000..=0x4100).contains(&cpu.registers.pc) {
                            return cpu.registers;
                        }
                        cpu.step(memory).unwrap();
                    }
                    panic!("bounded dispatch did not finish");
                };
                let expected = run(&mut memory, 0x3000);
                let actual = run(&mut memory, 0x2000);
                assert_eq!(
                    actual,
                    expected,
                    "count {}, A {a:02x}, CC {cc:02x}",
                    keys.len()
                );
            }
        }
    }
}

// These probes check the callee contracts that permit removing caller saves.
// They include malformed programme records, which must preserve U on failure.
#[test]
fn liveness_callee_contracts_preserve_control_and_graphics_cursors() {
    for damaged in [false, true] {
        for target in [10_u16, 20, 15, 0xffff] {
            for u in [0_u16, 0x3456, 0x6fed, 0xffff] {
                let mut memory = Memory::new();
                let mut cpu = Cpu::default();
                empty_programme(&mut memory);
                set_word(&mut memory, 0x27, 0x7f36);
                store_line(&mut memory, &mut cpu, 10, "REM FIRST");
                store_line(&mut memory, &mut cpu, 20, "END");
                if damaged {
                    set_word(&mut memory, 0x1e01, 0xffff);
                }
                cpu.registers.u = u;
                cpu.registers.a = (target >> 8) as u8;
                cpu.registers.b = target.to_le_bytes()[0];
                let mut code = Vec::new();
                call(&mut code, symbol("CTL_RESTORE_LINE"));
                memory.execute(&mut cpu, &code);
                assert_eq!(cpu.registers.u, u, "target={target}, damaged={damaged}");
                assert_eq!(cpu.registers.s, 0x7000);
                if target != 0xffff {
                    assert_eq!(cpu.registers.cc & C != 0, damaged || target == 15);
                }
            }
        }
    }
    for origin in [0, 1, 255] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        memory.bytes[usize::from(symbol("EXEC_ORIGIN"))] = origin;
        cpu.registers.y = 0x2468;
        let mut code = Vec::new();
        call(&mut code, symbol("CMD_CLEAR_VARIABLES"));
        memory.execute(&mut cpu, &code);
        assert_eq!(cpu.registers.y, 0x2468);
    }
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let mut code = Vec::new();
    call(&mut code, symbol("SG_ADDRESS"));
    for row in 0..=u8::MAX {
        for column in 0..=u8::MAX {
            memory.bytes[0xc4] = column;
            memory.bytes[0xc6] = row;
            cpu.registers.x = 0x2468;
            memory.execute(&mut cpu, &code);
            assert_eq!(cpu.registers.x, 0x2468);
            assert_eq!(cpu.registers.s, 0x7000);
            assert_eq!(cpu.registers.cc & C != 0, column > 63 || row > 31);
            if column <= 63 && row <= 31 {
                assert_eq!(
                    cpu.registers.y,
                    0x400 + u16::from(row / 2) * 32 + u16::from(column / 2)
                );
                assert_eq!(cpu.registers.b, 8 >> ((row % 2) * 2 + column % 2));
            }
        }
    }
}

#[test]
fn native_text_context_exhaustively_preserves_the_lexical_state_contract() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let mut code = Vec::new();
    call(&mut code, symbol("TEXT_CONTEXT"));
    for context in 0_u8..=255 {
        for byte in 0_u8..=255 {
            let (next, literal) = match context {
                0 => match byte {
                    0xff => (5, false),
                    b'"' => (1, true),
                    0x82 | 0x83 => (4, false),
                    0x86 => (2, false),
                    _ => (0, false),
                },
                5 => (0, true),
                4 => (4, true),
                _ if byte == b'"' => (context ^ 1, true),
                2 if byte == b':' => (0, true),
                _ => (context, true),
            };
            cpu.registers = Registers {
                a: byte,
                b: context,
                x: 0x6123,
                y: 0x4567,
                u: 0x4321,
                cc: 0xf0,
                ..Registers::default()
            };
            memory.execute(&mut cpu, &code);
            assert_eq!(cpu.registers.a, byte, "byte {byte:02x}, context {context}");
            assert_eq!(cpu.registers.b, next, "byte {byte:02x}, context {context}");
            assert_eq!(
                cpu.registers.cc & C != 0,
                literal,
                "byte {byte:02x}, context {context}"
            );
            assert_eq!(
                (
                    cpu.registers.x,
                    cpu.registers.y,
                    cpu.registers.u,
                    cpu.registers.s
                ),
                (0x6123, 0x4567, 0x4321, 0x7000)
            );
        }
    }
}

#[test]
fn private_fac_exchange_keeps_all_six_bytes_and_live_call_contracts() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let fac = usize::from(symbol("FAC"));
    let arg = usize::from(symbol("ARG"));
    let mut code = Vec::new();
    call(&mut code, symbol("F_SWAP"));
    for seed in 0..=u8::MAX {
        let left = [
            seed,
            seed.wrapping_add(1),
            seed ^ 0x55,
            !seed,
            seed.wrapping_mul(17),
            seed ^ 0xa5,
        ];
        let right = [
            !seed,
            seed ^ 0x80,
            seed.wrapping_mul(3),
            seed ^ 0xaa,
            seed.wrapping_add(79),
            seed ^ 0x5a,
        ];
        for cc in 0..=u8::MAX {
            memory.bytes[fac..fac + 6].copy_from_slice(&left);
            memory.bytes[arg..arg + 6].copy_from_slice(&right);
            cpu.registers.u = 0x5678;
            cpu.registers.cc = cc;
            memory.execute(&mut cpu, &code);
            assert_eq!(&memory.bytes[fac..fac + 6], &right);
            assert_eq!(&memory.bytes[arg..arg + 6], &left);
            assert_eq!(cpu.registers.x, u16::try_from(fac + 6).unwrap());
            assert_eq!(cpu.registers.y, u16::try_from(arg + 6).unwrap());
            assert_eq!(cpu.registers.u, 0x5678);
            assert_eq!(cpu.registers.s, 0x7000);
            assert_eq!(cpu.registers.cc, (cc & 0xf0) | 4);
        }
    }
}

fn install_owned_string_probe(memory: &mut Memory, entry: &str) -> u16 {
    let start = 0x6140_u16;
    let inner = start + 7;
    let body = start + 16;
    // The private allocator raises through its caller's native owner. This
    // authored owner preserves the probe's X plus the normal D/Y/U frame.
    let mut code = vec![0x34, 0x10];
    call(&mut code, inner);
    code.extend([0x35, 0x90, 0x34, 0x66, 0x10, 0x8e]);
    code.extend(body.to_be_bytes());
    code.push(0x7e);
    code.extend(symbol("NATIVE_FRAME").to_be_bytes());
    call(&mut code, symbol(entry));
    code.push(0x39);
    memory.bytes[usize::from(start)..usize::from(start) + code.len()].copy_from_slice(&code);
    start
}

#[test]
fn compact_caller_preservation_keeps_page_counts_and_one_byte_string_cursors() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    let mut guard = Vec::new();
    call(&mut guard, symbol("CMD_REQUIRE_END"));
    for text in [
        &b"\0"[..],
        &b":\0"[..],
        &b"   \0"[..],
        &b"  :\0"[..],
        &[0x84, 0],
    ] {
        memory.bytes[0x3000..0x3000 + text.len()].copy_from_slice(text);
        for b in 0..=u8::MAX {
            cpu.registers.b = b;
            cpu.registers.x = 0x3000;
            memory.execute(&mut cpu, &guard);
            assert_eq!(cpu.registers.b, b);
            assert_eq!(cpu.registers.cc & C, 0);
            assert_eq!(cpu.registers.s, 0x7000);
        }
    }
    let mut string = Vec::new();
    call(
        &mut string,
        install_owned_string_probe(&mut memory, "STRING_BYTE"),
    );
    for exhausted in [false, true] {
        for byte in 0..=u8::MAX {
            empty_programme(&mut memory);
            set_word(&mut memory, 0x27, if exhausted { 0x7f36 } else { 0x7ffe });
            set_word(&mut memory, 0x23, if exhausted { 0x7f36 } else { 0x7ffe });
            cpu.registers.b = byte;
            cpu.registers.x = 0x3456;
            memory.execute(&mut cpu, &string);
            assert_eq!(cpu.registers.x, 0x3456);
            assert_eq!(cpu.registers.b, byte);
            assert_eq!(cpu.registers.s, 0x7000);
            assert_eq!(cpu.registers.cc & C != 0, exhausted);
            if !exhausted {
                assert_eq!(memory.bytes[0x4f], 1);
                let descriptor = usize::from(word(&memory, 0x52));
                assert_eq!(memory.bytes[descriptor], 1);
                assert_eq!(
                    memory.bytes[usize::from(word(&memory, descriptor + 2))],
                    byte
                );
            }
        }
    }
}

#[test]
fn using_descriptor_frame_checks_collision_before_metadata_writes() {
    // The descriptor controller must reject every insufficient gap before
    // writing any of its private frame metadata below the active stack.
    for gap in 1u16..=163 {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        let end = 0x6800 - gap;
        set_word(&mut memory, 0x1f, end);
        let guard = usize::from(end - 32)..usize::from(end);
        memory.bytes[guard.clone()].fill(0xa5);
        set_word(&mut memory, 0x52, 0x1a9);
        set_word(&mut memory, 0xb, 0x1ae);
        set_word(&mut memory, 0xd, 0x1a9);
        memory.bytes[6] = 255;
        // An authored enclosing native boundary, with a finite return marker.
        set_word(&mut memory, usize::from(symbol("STATEMENT_SP")), 0x7000);
        set_word(&mut memory, 0x7004, 0x1a9);
        set_word(&mut memory, 0x700c, 0x6100);
        cpu.registers.pc = symbol("USING_FRAME_READY");
        cpu.registers.s = 0x6800;
        cpu.registers.u = 0x6900;
        cpu.registers.x = 0x3500;
        cpu.registers.y = 0x6810;
        let expected = if gap <= 162 {
            0x6100
        } else {
            symbol("USING_NEXT")
        };
        for _ in 0..64 {
            if cpu.registers.pc == expected {
                break;
            }
            cpu.step(&mut memory).unwrap();
        }
        assert_eq!(cpu.registers.pc, expected, "gap {gap}");
        assert_eq!(&memory.bytes[guard], &[0xa5; 32], "gap {gap}");
        if gap <= 162 {
            assert_ne!(cpu.registers.cc & C, 0);
            assert_eq!(cpu.registers.s, 0x700e);
        } else {
            assert_eq!(cpu.registers.s, 0x67f0);
            assert_eq!(cpu.registers.u, 0x67f0);
            assert_eq!(word(&memory, 0x67f0), 0x1a9);
            assert_eq!(word(&memory, 0x67f2), 0x3500);
            assert_eq!(word(&memory, 0x67f4), 0xff00);
            assert_eq!(memory.bytes[0x67f6], 0);
            assert_eq!(memory.bytes[0x67f7], 0xa9);
        }
    }
}

// Independently authored observations of public metadata and synthetic text.
// Reference: dragon-temporary-string-abi-20261018/observations.json.
fn canonical_install_observer(memory: &mut Memory, numeric_return: bool) {
    let bytes = include_bytes!("fixtures/complete-basic/ceb9bca88aea60fc-observer.bin");
    memory.bytes[0x6400..0x6400 + bytes.len()].copy_from_slice(bytes);
    if !numeric_return {
        memory.bytes[0x6400 + bytes.len() - 7] = 0x39;
    }
    set_word(memory, 0xb0, 0x134);
    set_word(memory, 0x134, 0x6400);
    memory.bytes[0x6300..0x6348].fill(0);
}
fn canonical_assert_empty(memory: &Memory) {
    assert_eq!(word(memory, 0xb), 0x1a9);
    assert_eq!(word(memory, 0xd), 0x1a4);
    assert_eq!(word(memory, usize::from(symbol("STR_ROOTS"))), 0);
}
#[test]
fn canonical_public_temporary_counts_contents_and_limits_match_observations() {
    for atom in [
        "CHR$(65)",
        "A$",
        "\"A\"",
        "\"\"",
        "LEFT$(A$,1)",
        "RIGHT$(A$,1)",
        "MID$(A$,1,1)",
        "(A$+A$)",
        "LEFT$(CHR$(65),1)",
    ] {
        for count in [0usize, 1, 2, 3, 7, 8, 9] {
            let mut m = Memory::new();
            let mut c = Cpu::default();
            empty_programme(&mut m);
            enable_guest_printer(&mut m);
            assert!(execute_direct(&mut m, &mut c, "A$=\"A\""));
            canonical_install_observer(&mut m, true);
            let mut expression = "CHR$(USR0(66))".to_owned();
            for _ in 0..count {
                expression = format!("{atom}+({expression})");
            }
            let succeeded = execute_direct(&mut m, &mut c, &format!("B$={expression}"));
            let pending = if atom == "A$" { 0 } else { count };
            let entered = pending <= 8;
            assert_eq!(m.bytes[0x6307] != 0, entered, "{expression}");
            assert_eq!(succeeded, pending < 8, "{expression}");
            if entered {
                assert_eq!(
                    word(&m, 0x6300),
                    0x1a9 + 5 * u16::try_from(pending).unwrap(),
                    "{expression}"
                );
                assert_eq!(
                    word(&m, 0x6302),
                    0x1a4 + 5 * u16::try_from(pending).unwrap(),
                    "{expression}"
                );
                if count == 1
                    && [
                        "LEFT$(A$,1)",
                        "RIGHT$(A$,1)",
                        "MID$(A$,1,1)",
                        "LEFT$(CHR$(65),1)",
                    ]
                    .contains(&atom)
                {
                    assert_eq!(
                        word(&m, 0x6312),
                        if atom == "LEFT$(CHR$(65),1)" {
                            0x7ffc
                        } else {
                            0x7ffd
                        },
                        "{expression}"
                    );
                }
                for i in 0..pending {
                    let expected_len = if atom == "\"\"" {
                        0
                    } else if atom == "(A$+A$)" {
                        2
                    } else {
                        1
                    };
                    assert_eq!(
                        m.bytes[0x6310 + i * 5],
                        expected_len,
                        "{expression} descriptor {i}"
                    );
                    assert_eq!(
                        m.bytes[0x6340 + i],
                        if expected_len == 0 { 0 } else { b'A' },
                        "{expression} payload {i}"
                    );
                }
            }
            if !succeeded {
                assert_eq!(candidate_error_index(&m), 24, "{expression}");
            }
            canonical_assert_empty(&m);
        }
    }
}
#[test]
fn canonical_temporaries_follow_collection_and_do_not_retain_consumed_values() {
    for (expression, pending) in [
        ("CHR$(65)+(CHR$(65)+(CHR$(USR0(66))))", 2usize),
        ("CHR$(65)+(CHR$(65)+(CHR$(USR0(LEN(STRING$(47,65))))))", 2),
        ("A$+(CHR$(65)+(CHR$(USR0(LEN(STRING$(48,65))))))", 1),
    ] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        assert!(execute_direct(
            &mut m,
            &mut c,
            "CLEAR50:A$=\"A\":Q$=STRING$(40,65):Q$=\"\""
        ));
        canonical_install_observer(&mut m, true);
        assert!(
            execute_direct(&mut m, &mut c, &format!("B$={expression}")),
            "{expression}"
        );
        assert_eq!(
            word(&m, 0x6300),
            0x1a9 + 5 * u16::try_from(pending).unwrap(),
            "{expression}"
        );
        for i in 0..pending {
            assert_eq!(m.bytes[0x6340 + i], b'A', "{expression}");
        }
        if expression.contains("LEN") {
            assert_eq!(word(&m, 0x6312), 0x7ffd, "{expression}");
            if pending == 2 {
                assert_eq!(word(&m, 0x6317), 0x7ffc, "{expression}");
            }
        } else {
            assert_eq!(word(&m, 0x6312), 0x7fd5);
            assert_eq!(word(&m, 0x6317), 0x7fd4);
        }
        canonical_assert_empty(&m);
    }
    for source in [
        "A$=CHR$(65)+CHR$(66)",
        "Z=LEN(CHR$(65)+CHR$(66))",
        "Z=ASC(\"A\")",
        "Z=VAL(\"1\")",
        "PRINT \"A\";\"B\"",
        "Z=INSTR(\"ABC\",\"B\")",
    ] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        canonical_install_observer(&mut m, true);
        assert!(
            execute_direct(&mut m, &mut c, &format!("{source}:B$=CHR$(USR0(66))")),
            "{source}"
        );
        assert_eq!(word(&m, 0x6300), 0x1a9, "{source}");
        canonical_assert_empty(&m);
    }
}
#[test]
fn canonical_usr_string_arguments_use_canonical_or_borrowed_descriptors() {
    for (argument, owned) in [
        ("\"A\"", true),
        ("\"\"", true),
        ("A$", false),
        ("A$+A$", true),
        ("LEFT$(A$,1)", true),
        ("A$(0)", false),
    ] {
        for numeric_return in [false, true] {
            let mut m = Memory::new();
            let mut c = Cpu::default();
            empty_programme(&mut m);
            enable_guest_printer(&mut m);
            assert!(execute_direct(
                &mut m,
                &mut c,
                "A$=\"A\":DIM A$(0):A$(0)=\"A\""
            ));
            canonical_install_observer(&mut m, numeric_return);
            assert_eq!(
                execute_direct(&mut m, &mut c, &format!("Z=USR0({argument})")),
                numeric_return,
                "{argument}"
            );
            assert_eq!(m.bytes[0x6307], 1, "{argument}");
            assert_eq!(m.bytes[0x6306], 255, "{argument}");
            let expected = if owned {
                0x1a9
            } else if argument == "A$" {
                0x1e05
            } else {
                word(&m, 0x1d) + 7
            };
            assert_eq!(word(&m, 0x6304), expected, "{argument}");
            if numeric_return {
                assert_eq!(numeric_scalar(&m, [b'Z', 0]), packed_integer(66));
            } else {
                assert_eq!(candidate_error_index(&m), 1);
            }
            canonical_assert_empty(&m);
        }
    }
    let mut m = Memory::new();
    let mut c = Cpu::default();
    empty_programme(&mut m);
    enable_guest_printer(&mut m);
    canonical_install_observer(&mut m, true);
    let mut expression = "CHR$(USR0(\"A\"))".to_owned();
    for _ in 0..7 {
        expression = format!("CHR$(65)+({expression})");
    }
    assert!(execute_direct(&mut m, &mut c, &format!("B$={expression}")));
    canonical_assert_empty(&m);
}
#[test]
fn canonical_programme_literals_and_failure_unwind_match_public_state() {
    for atom in ["\"A\"", "\"\"", "A$", "(A$+A$)"] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        store_line(&mut m, &mut c, 10, "A$=\"A\"");
        store_line(&mut m, &mut c, 20, &format!("B$={atom}+CHR$(USR0(66))"));
        canonical_install_observer(&mut m, true);
        assert!(execute_direct(&mut m, &mut c, "RUN"));
        assert_eq!(word(&m, 0x6300), if atom == "A$" { 0x1a9 } else { 0x1ae });
        canonical_assert_empty(&m);
    }
    for bad in [
        "B$=CHR$(65)+(CHR$(66)+1)",
        "Z=LEN(CHR$(65)+1)",
        "B$=LEFT$(CHR$(65),-1)",
        "B$=CHR$(65)+(1/0)",
        "PRINT USING \"#\";\"A\"",
    ] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        assert!(!execute_direct(&mut m, &mut c, bad), "{bad}");
        canonical_assert_empty(&m);
        canonical_install_observer(&mut m, true);
        assert!(execute_direct(&mut m, &mut c, "B$=CHR$(USR0(66))"));
        assert_eq!(word(&m, 0x6300), 0x1a9);
        canonical_assert_empty(&m);
    }
}
#[test]
fn canonical_public_descriptors_are_collected_and_corruption_is_preflighted() {
    let mut m = Memory::new();
    let mut c = Cpu::default();
    empty_programme(&mut m);
    set_word(&mut m, 0x27, 0x7ffe);
    set_word(&mut m, 0x23, 0x7f80);
    set_word(&mut m, 0xb, 0x1ae);
    set_word(&mut m, 0xd, 0x1a9);
    m.bytes[0x1a9..0x1ae].copy_from_slice(&[3, 0, 0x7f, 0x90, 0]);
    m.bytes[0x7f90..0x7f93].copy_from_slice(b"ABC");
    let mut call_gc = Vec::new();
    call(&mut call_gc, symbol("STRING_COLLECT"));
    m.execute(&mut c, &call_gc);
    assert_eq!(c.registers.cc & C, 0);
    assert_eq!(word(&m, 0x1ab), 0x7ffc);
    assert_eq!(&m.bytes[0x7ffc..0x7fff], b"ABC");
    for (free, last) in [
        (0, 0),
        (0x1a8, 0x1a3),
        (0x1aa, 0x1a5),
        (0x1d2, 0x1cd),
        (0x1ae, 0x1a4),
    ] {
        set_word(&mut m, 0xb, free);
        set_word(&mut m, 0xd, last);
        let heap = m.bytes[0x7f80..0x7fff].to_vec();
        m.execute(&mut c, &call_gc);
        assert_ne!(c.registers.cc & C, 0, "{free:04x}/{last:04x}");
        assert_eq!(&m.bytes[0x7f80..0x7fff], &heap);
        assert_eq!(word(&m, 0xb), free);
        assert_eq!(word(&m, 0xd), last);
    }
    set_word(&mut m, 0xb, 0x1b3);
    set_word(&mut m, 0xd, 0x1ae);
    // Start within the managed heap and cross MEMTOP. A descriptor wholly
    // above MEMTOP is static, including a ROM pointer, and must be ignored.
    m.bytes[0x1ae..0x1b3].copy_from_slice(&[4, 0, 0x7f, 0xfd, 0]);
    let heap = m.bytes[0x7f80..0x7fff].to_vec();
    let descriptors = m.bytes[0x1a9..0x1b3].to_vec();
    m.execute(&mut c, &call_gc);
    assert_ne!(c.registers.cc & C, 0);
    assert_eq!(&m.bytes[0x7f80..0x7fff], &heap);
    assert_eq!(&m.bytes[0x1a9..0x1b3], &descriptors);
}
#[test]
fn canonical_native_evaluation_restores_only_its_owned_temporary_scope() {
    let mut m = Memory::new();
    let mut c = Cpu::default();
    empty_programme(&mut m);
    set_word(&mut m, 0x27, 0x7ffe);
    set_word(&mut m, 0x23, 0x7ffd);
    m.bytes[0x7ffe] = b'A';
    set_word(&mut m, 0xb, 0x1ae);
    set_word(&mut m, 0xd, 0x1a9);
    m.bytes[0x1a9..0x1ae].copy_from_slice(&[1, 0, 0x7f, 0xfe, 0]);
    let old = m.bytes[0x1a9..0x1ae].to_vec();
    for (source, ok) in [("CHR$(66)+1", false), ("CHR$(66)", true)] {
        guest_tokens(&mut m, &mut c, source);
        let mut code = vec![0x8e, 2, 0xdc];
        call(&mut code, symbol("EVAL"));
        m.execute(&mut c, &code);
        assert_eq!(c.registers.cc & C == 0, ok, "{source}");
        assert_eq!(&m.bytes[0x1a9..0x1ae], &old);
        assert_eq!(word(&m, 0xb), if ok { 0x1b3 } else { 0x1ae });
        assert_eq!(word(&m, 0xd), if ok { 0x1ae } else { 0x1a9 });
    }
    let mut consume = Vec::new();
    call(&mut consume, symbol("STRING_LENGTH"));
    m.execute(&mut c, &consume);
    assert_eq!(word(&m, 0xb), 0x1ae);
    assert_eq!(&m.bytes[0x1a9..0x1ae], &old);
}
#[test]
fn canonical_format_descriptor_lives_until_statement_completion() {
    let mut m = Memory::new();
    let mut c = Cpu::default();
    empty_programme(&mut m);
    enable_guest_printer(&mut m);
    assert!(execute_direct(&mut m, &mut c, "A$=\"A\""));
    canonical_install_observer(&mut m, true);
    assert!(execute_direct(&mut m, &mut c, "PRINT USING\"#\";USR0(1)"));
    assert_eq!(word(&m, 0x6300), 0x1ae);
    assert_eq!(word(&m, 0x6302), 0x1a9);
    assert_eq!(m.bytes[0x6310], 1);
    assert_eq!(m.bytes[0x6340], b'#');
    assert_eq!(word(&m, 0x6312), 0x7ffd);
    canonical_assert_empty(&m);
    for source in ["PRINT USING\"#\";1", "DRAW\"R0\"", "PLAY\"A\""] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        m.execute_with_budget(&mut c, &init, 1_000_000);
        m.next_frame = Some(m.cycles + 17745);
        c.registers.cc &= 0xaf;
        canonical_install_observer(&mut m, true);
        assert!(
            execute_direct_with_budget(
                &mut m,
                &mut c,
                &format!("{source}:B$=CHR$(USR0(66))"),
                8_000_000
            ),
            "{source}"
        );
        assert_eq!(word(&m, 0x6300), 0x1a9, "{source}");
        canonical_assert_empty(&m);
    }
}
#[test]
fn canonical_owned_operands_observe_usr_descriptor_edits() {
    // Fresh reference observations identify both results, without inspecting
    // firmware instructions: mutation-observations.json in the ABI receipt.
    for (source, result, value) in [
        ("B$=CHR$(65)+CHR$(USR0(66))", &b"ZB"[..], 66u16),
        ("B$=LEFT$(CHR$(65),USR0(1))", &b"Z"[..], 1),
    ] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        m.bytes[0x6300] = b'Z';
        let mut code = vec![0x86, 1, 0xb7, 1, 0xa9, 0xcc, 0x63, 0, 0xfd, 1, 0xab, 0xcc];
        code.extend(value.to_be_bytes());
        call(&mut code, 0x8c37);
        code.push(0x39);
        m.bytes[0x6400..0x6400 + code.len()].copy_from_slice(&code);
        set_word(&mut m, 0xb0, 0x134);
        set_word(&mut m, 0x134, 0x6400);
        assert!(execute_direct(&mut m, &mut c, source), "{source}");
        let record = m.bytes[usize::from(word(&m, 0x1b))..usize::from(word(&m, 0x1d))]
            .chunks_exact(7)
            .find(|r| r[..2] == [b'B', 128])
            .unwrap();
        let pointer = usize::from(u16::from_be_bytes([record[4], record[5]]));
        assert_eq!(
            &m.bytes[pointer..pointer + usize::from(record[2])],
            result,
            "{source}"
        );
        canonical_assert_empty(&m);
    }
}
#[test]
fn canonical_consumption_order_matches_heap_exhaustion_observations() {
    for (source, success) in [
        ("CLEAR50:B$=STRING$(50,CHR$(65))", true),
        ("CLEAR50:Z=LEN(STRING$(50,CHR$(65)))", true),
        ("CLEAR50:B$=STRING$(50,\"A\")", true),
        ("CLEAR50:B$=STRING$(50,65)", true),
        ("CLEAR50:A$=\"A\":B$=STRING$(50,A$)", false),
        ("CLEAR50:B$=LEFT$(STRING$(50,65),1)", false),
        ("CLEAR50:B$=RIGHT$(STRING$(50,65),1)", false),
        ("CLEAR50:B$=MID$(STRING$(50,65),1,1)", false),
    ] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        assert_eq!(execute_direct(&mut m, &mut c, source), success, "{source}");
        if !success {
            assert_eq!(candidate_error_index(&m), 20, "{source}");
        }
        canonical_assert_empty(&m);
        assert!(execute_direct(&mut m, &mut c, "Z=85"));
        assert_eq!(numeric_scalar(&m, [b'Z', 0]), packed_integer(85));
    }
    let mut m = Memory::new();
    let mut c = Cpu::default();
    empty_programme(&mut m);
    enable_guest_printer(&mut m);
    canonical_install_observer(&mut m, true);
    assert!(execute_direct(
        &mut m,
        &mut c,
        "PRINT USING\"!#\";\"A\";USR0(1)"
    ));
    assert_eq!(word(&m, 0x6300), 0x1ae);
    assert_eq!(word(&m, 0x6302), 0x1a9);
    assert_eq!(m.bytes[0x6310], 2);
    assert_eq!(m.bytes[0x6340], b'!');
    canonical_assert_empty(&m);
}
#[test]
fn canonical_device_and_filename_arguments_are_consumed_before_later_expressions() {
    for (source, value, expected) in [
        ("OPEN\"O\",USR0(0),\"X\"", 0u8, true),
        ("DLOAD\"X\",USR0(1)", 1, false),
        ("CSAVEM\"X\",USR0(1),1,1", 1, true),
    ] {
        let mut m = Memory::new();
        let mut c = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        canonical_install_observer(&mut m, true);
        let len = include_bytes!("fixtures/complete-basic/ceb9bca88aea60fc-observer.bin").len();
        m.bytes[0x6400 + len - 5] = value;
        assert_eq!(
            execute_direct_with_budget(&mut m, &mut c, source, 32_000_000),
            expected,
            "{source}"
        );
        assert_eq!(m.bytes[0x6307], 1, "{source}");
        assert_eq!(word(&m, 0x6300), 0x1a9, "{source}");
        assert_eq!(word(&m, 0x6302), 0x1a4, "{source}");
        canonical_assert_empty(&m);
    }
}

#[test]
fn public_numeric_signed_words_leave_observed_integer_mantissa_and_registers() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    for entry in [0x8b2d, 0x8b30] {
        for raw in 0..=u16::MAX {
            let value = raw.cast_signed();
            unpack_to(&mut memory, 0x4f, packed_integer(value));
            let exponent = memory.bytes[0x4f];
            let sign = memory.bytes[0x54];
            cpu.registers = Registers {
                x: 0x4f,
                y: 0x6300,
                u: 0x6400,
                ..Registers::default()
            };
            let mut code = Vec::new();
            call(&mut code, entry);
            memory.execute(&mut cpu, &code);
            assert_eq!(cpu.registers.d(), raw, "entry {entry:04X}: {value}");
            assert_eq!(&memory.bytes[0x50..0x54], &i32::from(value).to_be_bytes());
            assert_eq!((memory.bytes[0x4f], memory.bytes[0x54]), (exponent, sign));
            assert_eq!(
                (
                    cpu.registers.x,
                    cpu.registers.y,
                    cpu.registers.u,
                    cpu.registers.s
                ),
                (0x4f, 0x6300, 0x6400, 0x7000)
            );
        }
    }
}

// Conversion of independently computed, already integral reference values.
// These assertions prohibit truncation or saturation from hiding a mismatch.
#[allow(clippy::cast_possible_truncation)]
fn reference_signed_word(value: f64) -> i16 {
    assert!(value.is_finite() && value.fract() == 0.0);
    assert!((f64::from(i16::MIN)..=f64::from(i16::MAX)).contains(&value));
    value as i16
}

#[test]
fn public_numeric_fractional_conversion_floors_without_changing_private_truncation() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    for value in [
        0.0_f64,
        0.5,
        -0.5,
        1.9,
        -1.9,
        32767.9,
        -32768.0,
        0.000_000_1,
        -0.000_000_1,
        255.5,
        -255.5,
    ] {
        for entry in [0x8b2d, 0x8b30, symbol("FAC_TO_INT")] {
            unpack_to(&mut memory, 0x4f, packed_number(value));
            let before = memory.bytes[0x4f..0x55].to_vec();
            let mut code = Vec::new();
            call(&mut code, entry);
            memory.execute(&mut cpu, &code);
            let expected = reference_signed_word(if entry == symbol("FAC_TO_INT") {
                value.trunc()
            } else {
                value.floor()
            });
            assert_eq!(
                cpu.registers.d().cast_signed(),
                expected,
                "{entry:04X} {value}"
            );
            if entry == symbol("FAC_TO_INT") {
                assert_eq!(&memory.bytes[0x4f..0x55], &before);
                assert_eq!(cpu.registers.cc & C, 0);
            } else {
                assert_eq!(
                    &memory.bytes[0x50..0x54],
                    &i32::from(expected).to_be_bytes()
                );
                assert_eq!(
                    (memory.bytes[0x4f], memory.bytes[0x54]),
                    (before[0], before[5])
                );
            }
        }
    }
}

#[test]
fn public_numeric_usr_range_failure_unwinds_and_allows_next_statement() {
    for entry in [0x8b2d_u16, 0x8b30] {
        for (source, expected) in [
            ("0", Some(0_i16)),
            ("-.5", Some(-1)),
            ("-1.9", Some(-2)),
            ("32767.9", Some(32767)),
            ("-32768", Some(-32768)),
            ("32768", None),
            ("-32768.9", None),
            ("-32769", None),
            ("65535", None),
            ("1E38", None),
            ("-1E38", None),
        ] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            // Authored routine marks entry and successful return, then restores a
            // valid floating result through the published signed-word entry.
            let mut routine = vec![0x7c, 0x63, 0x10];
            call(&mut routine, entry);
            routine.extend([0xfd, 0x63, 0x12, 0x7c, 0x63, 0x11]);
            call(&mut routine, 0x8c37);
            routine.push(0x39);
            memory.bytes[0x6000..0x6000 + routine.len()].copy_from_slice(&routine);
            set_word(&mut memory, 0xb0, 0x134);
            set_word(&mut memory, 0x134, 0x6000);
            let okay = execute_direct(&mut memory, &mut cpu, &format!("Z=USR0({source})"));
            assert_eq!(memory.bytes[0x6310], 1, "{entry:04X} {source}");
            assert_eq!(okay, expected.is_some(), "{entry:04X} {source}");
            assert_eq!(memory.bytes[0x6311], u8::from(expected.is_some()));
            if let Some(value) = expected {
                assert_eq!(word(&memory, 0x6312).cast_signed(), value);
                assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(value));
            } else {
                assert_eq!(
                    memory.bytes[usize::from(symbol("ERROR_CODE"))],
                    8,
                    "FC for {source}"
                );
            }
            assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0);
            assert!(execute_direct(&mut memory, &mut cpu, "Z=42"));
            assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(42));
        }
    }
}
#[test]
fn public_numeric_checked_and_unchecked_entries_have_distinct_type_contracts() {
    for entry in [0x8b2d_u16, 0x8b30] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        let mut routine = vec![0x86, 0xff, 0x97, 0x06];
        call(&mut routine, entry);
        routine.extend([0x7c, 0x63, 0x11]);
        call(&mut routine, 0x8c37);
        routine.push(0x39);
        memory.bytes[0x6000..0x6000 + routine.len()].copy_from_slice(&routine);
        set_word(&mut memory, 0xb0, 0x134);
        set_word(&mut memory, 0x134, 0x6000);
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, "Z=USR0(1)"),
            entry == 0x8b30
        );
        assert_eq!(memory.bytes[0x6311], u8::from(entry == 0x8b30));
        if entry == 0x8b2d {
            assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 24);
        } else {
            assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(1));
        }
        assert!(execute_direct(&mut memory, &mut cpu, "Z=42"));
    }
}

#[test]
fn cassette_status_matches_named_wildcard_failure_and_public_cursor_facts() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/4c0236a31c8a1b37-observations.json"
    ))
    .unwrap();
    let selected = [
        "skip-named",
        "skip-wild",
        "load-named",
        "load-wild",
        "load-wrong-type",
        "open-named",
        "bad-header",
        "long-name",
        "blank-name",
        "positioned",
        "screen-tail",
        "mixed-case",
        "zero-name",
        "search-unmatched",
        "load-search-unmatched",
        "load-mode-state",
        "skip-two-data",
        "open-empty",
        "open-two-refills",
    ];
    for fact in facts["cases"].as_array().unwrap() {
        let id = fact["id"].as_str().unwrap();
        if !selected.contains(&id) {
            continue;
        }
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        // Every status operation owns the whole text-screen clear, and writes
        // through the screen primitive independently of the selected printer.
        memory.bytes[0x400..0x600].fill(0x55);
        set_word(&mut memory, 0x88, 0x04a5);
        memory.bytes[0x6c] = 5;
        memory.bytes[0x6800..0x6804].copy_from_slice(&[0x7c, 0x63, 0xa0, 0x39]);
        memory.bytes[0x16a..0x16d].copy_from_slice(&[0x7e, 0x68, 0x00]);
        let mut tape = Vec::new();
        for file in fact["files"].as_array().unwrap() {
            let mut header = file["name"].as_str().unwrap().as_bytes().to_vec();
            assert_eq!(header.len(), 8);
            header.extend([
                u8::try_from(file["type"].as_u64().unwrap_or(2)).unwrap(),
                u8::try_from(file["ascii"].as_u64().unwrap_or(0)).unwrap(),
                u8::try_from(file["gap"].as_u64().unwrap_or(0)).unwrap(),
                0x60,
                0,
                0x60,
                0,
            ]);
            append_synthetic_cassette_block(&mut tape, 0, &header);
            if file["corrupt"].as_bool().unwrap_or(false) {
                let checksum = tape.len() - 2;
                tape[checksum] ^= 1;
            }
            let payload = file["data"]
                .as_array()
                .map(|values| {
                    values
                        .iter()
                        .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                        .collect::<Vec<_>>()
                })
                .unwrap_or(vec![0x39]);
            if let Some(blocks) = file["blocks"].as_array() {
                for block in blocks {
                    let data: Vec<u8> = block
                        .as_array()
                        .unwrap()
                        .iter()
                        .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                        .collect();
                    append_synthetic_cassette_block(&mut tape, 1, &data);
                }
            } else {
                append_synthetic_cassette_block(&mut tape, 1, &payload);
            }
            append_synthetic_cassette_block(&mut tape, 255, &[]);
        }
        tape.extend([0x55; 16]);
        synthetic_tape(&mut memory, &tape);
        let ok = execute_direct_with_budget(
            &mut memory,
            &mut cpu,
            fact["source"].as_str().unwrap(),
            16_777_216,
        );
        let expected_ok = !matches!(
            id,
            "load-wrong-type" | "bad-header" | "search-unmatched" | "load-search-unmatched"
        );
        assert_eq!(ok, expected_ok, "{id}");
        let cells: Vec<u8> = fact["screenBytes"]
            .as_array()
            .unwrap()
            .iter()
            .map(|b| u8::try_from(b.as_u64().unwrap()).unwrap())
            .collect();
        assert_eq!(&memory.bytes[0x400..0x40a], cells, "{id}");
        assert!(
            memory.bytes[0x40a..0x600].iter().all(|b| *b == 0x60),
            "{id}: clears screen"
        );
        if ok {
            assert_eq!(
                word(&memory, 0x88),
                u16::try_from(fact["cursor"].as_u64().unwrap()).unwrap(),
                "{id}: cursor"
            );
            assert_eq!(memory.bytes[0x6c], 5, "{id}: retained column cache");
        }
        assert_eq!(memory.bytes[0x63a0], 0, "{id}: bypasses device output hook");
        assert_eq!(memory.bytes[0xff21] & 8, 0, "{id}: motor stops");
        for address in [0x78, 0x79, 0x7a, 0x7b, 0x7c, 0x7d, 0x81] {
            assert_eq!(
                memory.bytes[address],
                u8::try_from(
                    fact["workspace"][format!("{address:04x}")]
                        .as_u64()
                        .unwrap()
                )
                .unwrap(),
                "{id}: workspace {address:04x}"
            );
        }
    }
}

fn install_character_hook(memory: &mut Memory, hook: usize) {
    let callback: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/f939ce6c94029011-output-callback.json"
    ))
    .unwrap();
    let code: Vec<u8> = callback["bytes"]
        .as_array()
        .unwrap()
        .iter()
        .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
        .collect();
    memory.bytes[0x6800..0x6800 + code.len()].copy_from_slice(&code);
    let entry = u16::try_from(callback["symbols"]["OUTPUT"].as_u64().unwrap()).unwrap();
    memory.bytes[hook] = 0x7e;
    set_word(memory, hook + 1, entry);
    memory.bytes[0x637e] = 0;
    memory.bytes[0x637f] = 1;
}
fn character_hook_trace(memory: &Memory) -> &[u8] {
    let count = usize::from(memory.bytes[0x637e]);
    assert!(count < 240);
    &memory.bytes[0x6400..0x6400 + count]
}
#[test]
fn character_hooks_use_published_addresses_and_keep_raw_entries_unhooked() {
    for (source, expected) in [
        ("PRINT\"HI\";", b"HI".as_slice()),
        ("PRINT#-2,\"HI\";", b"HI".as_slice()),
        ("A$=STR$(123)", b"".as_slice()),
        (
            "OPEN\"O\",-1,\"TEXT\":PRINT#-1,\"HI\";:CLOSE",
            b"HI\r".as_slice(),
        ),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        install_character_hook(&mut memory, 0x167);
        assert!(execute_direct(&mut memory, &mut cpu, source), "{source}");
        assert_eq!(character_hook_trace(&memory), expected, "{source}");
    }
    for (entry, hooked) in [(0x800c, false), (0x800f, false), (0xb54a, true)] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        memory.bytes[0x6f] = 0;
        set_word(&mut memory, 0x88, 0x400);
        install_character_hook(&mut memory, 0x167);
        cpu.registers.b = 0xa5;
        cpu.registers.x = 0x4321;
        cpu.registers.y = 0x1234;
        cpu.registers.u = 0x4567;
        let mut code = vec![0x86, b'A'];
        call(&mut code, entry);
        memory.execute(&mut cpu, &code);
        assert_eq!(
            character_hook_trace(&memory),
            if hooked {
                b"A".as_slice()
            } else {
                b"".as_slice()
            },
            "entry {entry:04x}"
        );
        assert_eq!(
            (
                cpu.registers.a,
                cpu.registers.b,
                cpu.registers.x,
                cpu.registers.y,
                cpu.registers.u
            ),
            (b'A', 0xa5, 0x4321, 0x1234, 0x4567)
        );
    }
    for input in [false, true] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        install_character_hook(&mut memory, 0x16a);
        if input {
            assert!(execute_direct(&mut memory, &mut cpu, "A$=INKEY$"));
        } else {
            let mut code = Vec::new();
            call(&mut code, 0x8006);
            memory.execute(&mut cpu, &code);
        }
        assert!(character_hook_trace(&memory).is_empty());
    }
    for (source, reply) in [
        ("INPUT A", b"42\r".as_slice()),
        ("LINE INPUT A$", b"AB\r".as_slice()),
    ] {
        for hook in [0x167, 0x16a, 0x182] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            supply_original_keyboard(&mut memory, reply);
            install_character_hook(&mut memory, hook);
            assert!(execute_input_programme(&mut memory, &mut cpu, source));
            let trace = character_hook_trace(&memory);
            match hook {
                0x167 => assert_eq!(
                    trace,
                    if source == "INPUT A" {
                        b"? 42\r".as_slice()
                    } else {
                        b"AB\r".as_slice()
                    },
                    "{source}: output"
                ),
                0x16a => {
                    assert_eq!(trace.len(), 3, "{source}: one hook per character");
                    assert_eq!(&trace[1..], &reply[..2], "{source}: preceding characters");
                }
                0x182 => assert_eq!(trace.len(), 1, "{source}: one hook per line"),
                _ => unreachable!(),
            }
        }
    }
}

#[test]
fn cassette_names_use_output_hook_and_programme_reads_preserve_screen() {
    for programme in [false, true] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        install_character_hook(&mut memory, 0x167);
        let mut tape = Vec::new();
        for name in [b"FIRST   ", b"WANTED  "] {
            append_synthetic_cassette_file(&mut tape, *name);
        }
        tape.extend([0x55; 16]);
        synthetic_tape(&mut memory, &tape);
        memory.bytes[0x400..0x600].fill(0x55);
        set_word(&mut memory, 0x88, 0x450);
        if programme {
            store_line(&mut memory, &mut cpu, 10, "SKIPF\"WANTED\"");
        }
        assert!(execute_direct_with_budget(
            &mut memory,
            &mut cpu,
            if programme { "RUN" } else { "SKIPF\"WANTED\"" },
            16_777_216
        ));
        assert_eq!(
            character_hook_trace(&memory),
            if programme {
                b"".as_slice()
            } else {
                b"FIRST   WANTED  ".as_slice()
            }
        );
        if programme {
            assert!(memory.bytes[0x400..0x600].iter().all(|v| *v == 0x55));
            assert_eq!(word(&memory, 0x88), 0x450);
        } else {
            assert_eq!(word(&memory, 0x88), 0x40a);
        }
    }
}

#[test]
fn device_lifecycle_matches_exact_phase_reference_observations() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/b93399e2ac8e66f0-device-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        memory.signal_limit = 131_072;
        let source = fact["source"].as_str().unwrap();
        if source.contains("SKIPF") {
            let mut tape = Vec::new();
            append_synthetic_cassette_file(&mut tape, *b"FIRST   ");
            tape.extend([0x55; 16]);
            synthetic_tape(&mut memory, &tape);
        }
        let success = execute_direct_with_budget(&mut memory, &mut cpu, source, 16_777_216);
        assert_eq!(
            success,
            fact["completionPhase"].as_u64().unwrap() == 1,
            "{source}"
        );
        let expected_device = u8::try_from(fact["device"].as_u64().unwrap()).unwrap();
        assert_eq!(memory.bytes[0x6f], expected_device, "{source}");
        let expected_output: Vec<u8> = fact["printer"]
            .as_array()
            .unwrap()
            .iter()
            .map(|b| u8::try_from(b.as_u64().unwrap()).unwrap())
            .collect();
        assert_eq!(memory.output, expected_output, "{source}");
        assert_eq!(
            word(&memory, usize::from(symbol("STR_ROOTS"))),
            0,
            "{source}"
        );
        assert_eq!(
            word(&memory, usize::from(symbol("STATEMENT_SP"))),
            0,
            "{source}"
        );
        assert_eq!(memory.bytes[0xff21] & 8, 0, "{source}");
        if !success {
            // Observe the published error hook before prompt cleanup, matching
            // reference phase 3. The independently authored hook preserves D.
            memory.bytes[0x6400..0x640d].copy_from_slice(&[
                0x34, 6, 0x96, 0x6f, 0xb7, 0x63, 0xf0, 0x35, 6, 0xf7, 0x63, 0xf1, 0x39,
            ]);
            memory.bytes[0x18e..0x191].copy_from_slice(&[0x7e, 0x64, 0]);
            let mut code = Vec::new();
            call(&mut code, symbol("BASIC_ERROR"));
            memory.execute(&mut cpu, &code);
            assert_eq!(memory.bytes[0x63f0], expected_device, "error hook {source}");
            let selector = match fact["id"].as_str().unwrap() {
                "device-matrix-FC" => 8,
                "device-matrix-TM" => 24,
                "device-matrix-SN" => 2,
                other => panic!("unrecognised authored error case {other}"),
            };
            assert_eq!(memory.bytes[0x63f1], selector, "error hook {source}");
            assert!(execute_direct(&mut memory, &mut cpu, "Z=85"));
            assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
        }
    }
}

#[test]
fn device_lifecycle_routes_each_print_and_keeps_partial_failure_selection() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    set_word(&mut memory, 0x88, 0x400);
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        "POKE111,254:PRINT\"ONE\";:A=1:PRINT\"TWO\";"
    ));
    assert_eq!(memory.output, b"ONE");
    assert_eq!(&memory.bytes[0x400..0x403], b"TWO");
    assert_eq!(numeric_scalar(&memory, [b'A', 0]), packed_integer(1));
    assert_eq!(memory.bytes[0x6f], 0);
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        "PRINT#-2,\"THREE\";:PRINT\"FOUR\";"
    ));
    assert_eq!(memory.output, b"ONETHREE");
    assert_eq!(&memory.bytes[0x400..0x407], b"TWOFOUR");
    assert_eq!(memory.bytes[0x6f], 0);
    memory.output.clear();
    assert!(!execute_direct(
        &mut memory,
        &mut cpu,
        "POKE111,254:PRINT\"PART\";1/0"
    ));
    assert_eq!(memory.output, b"PART");
    assert_eq!(memory.bytes[0x6f], 0xfe);
    assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 20);
    assert!(!execute_direct(&mut memory, &mut cpu, "PRINT#0,1/0"));
    assert_eq!(memory.bytes[0x6f], 0xfe);
    assert!(execute_direct(&mut memory, &mut cpu, "PRINT\"RECOVERED\";"));
    assert_eq!(memory.output, b"PARTRECOVERED");
    assert_eq!(memory.bytes[0x6f], 0);
}

fn cassette_order_facts() -> serde_json::Value {
    serde_json::from_str(include_str!(
        "fixtures/complete-basic/66b3b4c26bf94d5b-observations.json"
    ))
    .unwrap()
}
fn cassette_order_tape(fact: &serde_json::Value) -> Vec<u8> {
    let mut tape = Vec::new();
    for file in fact["files"].as_array().unwrap() {
        let mut header = file["name"].as_str().unwrap().as_bytes().to_vec();
        header.extend([
            u8::try_from(file["type"].as_u64().unwrap_or(2)).unwrap(),
            u8::try_from(file["ascii"].as_u64().unwrap_or(0)).unwrap(),
            u8::try_from(file["gap"].as_u64().unwrap_or(0)).unwrap(),
            0x60,
            0,
            0x60,
            0,
        ]);
        let blocks: Vec<Vec<u8>> = if let Some(blocks) = file["blocks"].as_array() {
            blocks
                .iter()
                .map(|b| {
                    b.as_array()
                        .unwrap()
                        .iter()
                        .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                        .collect()
                })
                .collect()
        } else {
            vec![
                file["data"]
                    .as_array()
                    .map(|b| {
                        b.iter()
                            .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                            .collect()
                    })
                    .unwrap_or(vec![0x39]),
            ]
        };
        let records = std::iter::once((0, header))
            .chain(blocks.into_iter().map(|b| (1, b)))
            .chain(std::iter::once((255, Vec::new())));
        for (kind, data) in records {
            append_synthetic_cassette_block(&mut tape, kind, &data);
            if (kind == 0 && file["corrupt"].as_bool().unwrap_or(false))
                || file["corruptKind"].as_u64() == Some(u64::from(kind))
            {
                let checksum = tape.len() - 2;
                tape[checksum] ^= 1;
            }
        }
    }
    tape.extend([0x55; 16]);
    tape
}
#[test]
fn cassette_machine_offset_waits_for_header_then_evaluates_with_motor_off() {
    for fact in cassette_order_facts()["cases"].as_array().unwrap() {
        let id = fact["id"].as_str().unwrap();
        if !id.starts_with("offset-usr-")
            && !id.starts_with("read-suffix-")
            && !id.starts_with("read-io-")
            && !id.starts_with("offset-literal-")
        {
            continue;
        }
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        let callback = include_bytes!("fixtures/complete-basic/d4c91d08a497f6ba-usr-capture.bin");
        memory.bytes[0x6a00..0x6a00 + callback.len()].copy_from_slice(callback);
        assert!(execute_direct(&mut memory, &mut cpu, "DEFUSR0=27136"));
        install_character_hook(&mut memory, 0x167);
        synthetic_tape(&mut memory, &cassette_order_tape(fact));
        memory.tape_clock = Some(memory.cycles);
        memory.signal_limit = 131_072;
        let ok = execute_direct_with_budget(
            &mut memory,
            &mut cpu,
            fact["source"].as_str().unwrap(),
            32_000_000,
        );
        if fact["completionPhase"] == 4 {
            assert_eq!(memory.bytes[0x6303], 1, "{id}: offset evaluated once");
            assert_eq!(memory.bytes[0x6305] & 8, 0, "{id}: motor off at USR");
            for address in [0x78, 0x79, 0x7a, 0x7b, 0x7c, 0x7d, 0x81] {
                assert_eq!(
                    memory.bytes[0x6310 + address - 0x78],
                    u8::try_from(
                        fact["workspace"][format!("{address:04x}")]
                            .as_u64()
                            .unwrap()
                    )
                    .unwrap(),
                    "{id}: USR workspace {address:04x}"
                );
            }
            if id != "offset-usr-save-control" {
                assert_eq!(
                    memory.bytes[0x6306], 70,
                    "{id}: selected header shown before offset"
                );
            }
        } else if fact["completionPhase"] == 1 {
            assert!(ok, "{id}: accepted after header");
            assert_eq!(word(&memory, 0x9d), 0x6100, "{id}: offset applies to entry");
            assert_eq!(memory.bytes[0x6100], 0x39, "{id}: offset applies to data");
        } else {
            assert!(!ok, "{id}: rejected");
            assert_eq!(memory.bytes[0x6303], 0, "{id}: USR not reached");
            assert_eq!(
                memory.bytes[usize::from(symbol("ERROR_CODE"))],
                u8::try_from(fact["errorSelector"].as_u64().unwrap()).unwrap(),
                "{id}: diagnostic order"
            );
            for address in [0x79, 0x7a, 0x7b, 0x7c, 0x7d, 0x81] {
                assert_eq!(
                    memory.bytes[address],
                    u8::try_from(
                        fact["workspace"][format!("{address:04x}")]
                            .as_u64()
                            .unwrap()
                    )
                    .unwrap(),
                    "{id}: final workspace {address:04x}"
                );
            }
        }
        assert_eq!(memory.bytes[0xff21] & 8, 0, "{id}: completed motor state");
        assert_eq!(
            word(&memory, usize::from(symbol("STR_ROOTS"))),
            0,
            "{id}: roots released"
        );
        assert!(
            execute_direct(&mut memory, &mut cpu, "A=17"),
            "{id}: recovery"
        );
    }
}
#[test]
fn cassette_character_consumption_prefetches_next_block_and_reports_io_before_store() {
    for fact in cassette_order_facts()["cases"].as_array().unwrap() {
        let id = fact["id"].as_str().unwrap();
        if !id.starts_with("refill-") {
            continue;
        }
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        let programme = fact["programme"]
            .as_str()
            .unwrap()
            .strip_prefix("10 ")
            .unwrap()
            .strip_suffix(":EXEC25000\r")
            .unwrap();
        store_line(&mut memory, &mut cpu, 10, programme);
        install_character_hook(&mut memory, 0x16a);
        synthetic_tape(&mut memory, &cassette_order_tape(fact));
        memory.tape_clock = Some(memory.cycles);
        let ok = execute_direct_with_budget(&mut memory, &mut cpu, "RUN", 32_000_000);
        let expected = fact["errorSelector"] == 0;
        assert_eq!(ok, expected, "{id}");
        if !ok {
            assert_eq!(memory.bytes[usize::from(symbol("ERROR_CODE"))], 42, "{id}");
        }
        for address in [0x78, 0x79, 0x7a, 0x7b, 0x7c, 0x7d, 0x7e, 0x7f, 0x81] {
            assert_eq!(
                memory.bytes[address],
                u8::try_from(
                    fact["workspace"][format!("{address:04x}")]
                        .as_u64()
                        .unwrap()
                )
                .unwrap(),
                "{id}: workspace {address:04x}"
            );
        }
        let count = fact["output"].as_array().unwrap().len();
        assert_eq!(
            character_hook_trace(&memory).len(),
            count,
            "{id}: one hook per consumed character"
        );
        assert_eq!(memory.bytes[0xff21] & 8, 0, "{id}: motor stopped");
        let expected_a: Vec<u8> = fact["numericA"]
            .as_array()
            .unwrap()
            .iter()
            .map(|b| u8::try_from(b.as_u64().unwrap()).unwrap())
            .collect();
        assert_eq!(
            numeric_scalar(&memory, [b'A', 0]).as_slice(),
            expected_a,
            "{id}: value store boundary"
        );
    }
}

fn check_graphics_published_workspace(paint: bool) {
    use sha2::{Digest, Sha256};
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/28f83fbbd3ac01be-graphics-observations.json"
    ))
    .unwrap();
    assert_eq!(
        facts["referenceSha256"],
        "fc0e900bfec6b52f0f80ba1e65a4712808d2a411b5b00496639ef1a2152351f1"
    );
    let mut differences = Vec::new();
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let id = fact["id"].as_str().unwrap();
        if id.contains("paint") != paint {
            continue;
        }
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        memory.execute_with_budget(&mut cpu, &init, 1_000_000);
        assert!(
            execute_direct_with_budget(&mut memory, &mut cpu, source, 8_388_608),
            "{source}"
        );
        for (address, value) in fact["workspace"].as_object().unwrap() {
            let address = usize::from_str_radix(address, 16).unwrap();
            let expected = u8::try_from(value.as_u64().unwrap()).unwrap();
            if memory.bytes[address] != expected {
                differences.push(format!(
                    "{id} ${address:04x}: {} expected {expected}",
                    memory.bytes[address]
                ));
            }
        }
        let size = usize::try_from(fact["canvasBytes"].as_u64().unwrap()).unwrap();
        assert_eq!(
            format!("{:x}", Sha256::digest(&memory.bytes[0x600..0x600 + size])),
            fact["syntheticCanvasSha256"].as_str().unwrap(),
            "{id}: canvas"
        );
    }
    assert!(differences.is_empty(), "{}", differences.join("\n"));
}

#[test]
fn graphics_published_axis_and_rectangle_cursor_contracts() {
    check_graphics_published_workspace(false);
}

#[test]
fn shared_word_extraction_keeps_every_discarded_fraction_bit_and_public_state() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    for exponent in 1u8..=144 {
        for bit in 0..32 {
            let mantissa = 0x8000_0000_u32 | (1u32 << bit);
            for negative in [false, true] {
                let magnitude = f64::from(mantissa) * 2f64.powi(i32::from(exponent) - 160);
                let value = if negative { -magnitude } else { magnitude };
                let rounded = value.floor();
                if rounded < f64::from(i16::MIN) || rounded > f64::from(i16::MAX) {
                    continue;
                }
                let mut packed = [0u8; 5];
                packed[0] = exponent;
                packed[1..].copy_from_slice(&mantissa.to_be_bytes());
                packed[1] = (packed[1] & 0x7f) | if negative { 0x80 } else { 0 };
                for entry in [0x8b2d, 0x8b30, symbol("FAC_TO_INT")] {
                    unpack_to(&mut memory, 0x4f, packed);
                    memory.bytes[0x06] = 0;
                    let before = memory.bytes[0x4f..0x55].to_vec();
                    cpu.registers = Registers {
                        x: 0x3456,
                        y: 0x4567,
                        u: 0x5678,
                        ..Registers::default()
                    };
                    let mut code = Vec::new();
                    call(&mut code, entry);
                    memory.execute(&mut cpu, &code);
                    let expected = reference_signed_word(if entry == symbol("FAC_TO_INT") {
                        value.trunc()
                    } else {
                        rounded
                    });
                    assert_eq!(
                        cpu.registers.d().cast_signed(),
                        expected,
                        "entry {entry:04X}, exponent {exponent}, bit {bit}, negative {negative}"
                    );
                    assert_eq!(
                        (
                            cpu.registers.x,
                            cpu.registers.y,
                            cpu.registers.u,
                            cpu.registers.s
                        ),
                        (0x3456, 0x4567, 0x5678, 0x7000)
                    );
                    if entry == symbol("FAC_TO_INT") {
                        assert_eq!(&memory.bytes[0x4f..0x55], &before);
                        assert_eq!(cpu.registers.cc & C, 0);
                    } else {
                        assert_eq!(
                            &memory.bytes[0x50..0x54],
                            &i32::from(expected).to_be_bytes()
                        );
                        assert_eq!(
                            (memory.bytes[0x4f], memory.bytes[0x54]),
                            (before[0], before[5])
                        );
                    }
                }
            }
        }
    }
}

#[test]
fn pending_borrowed_string_values_observe_scalar_and_relocated_array_descriptors() {
    for (array, expression, result, returned) in [
        (false, "A$+CHR$(USR0(66))", "ZB", 66u16),
        (false, "LEFT$(A$,USR0(1))", "Z", 1),
        (false, "STRING$(USR0(1),A$)", "Z", 1),
        (true, "A$(1)+CHR$(USR0(66))", "ZB", 66),
        (true, "LEFT$(A$(1),USR0(1))", "Z", 1),
        (true, "A$(1)+CHR$(USR0(Z+66))", "ZB", 66),
        (true, "LEFT$(A$(1),USR0(Z+1))", "Z", 1),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            if array {
                "DIM A$(1):A$(1)=\"A\""
            } else {
                "A$=\"A\""
            }
        ));
        memory.bytes[0x6300] = b'Z';
        // Authored 6809: locate the current scalar/array descriptor, set length
        // and pointer to our Z, then return through the published numeric entry.
        let mut routine = vec![
            0x10,
            0x9e,
            if array { 0x1d } else { 0x1b },
            0x31,
            if array { 0x2c } else { 0x22 },
            0x86,
            1,
            0xa7,
            0xa4,
            0xcc,
            0x63,
            0,
            0xed,
            0x22,
            0xcc,
        ];
        routine.extend(returned.to_be_bytes());
        call(&mut routine, 0x8c37);
        routine.push(0x39);
        memory.bytes[0x6400..0x6400 + routine.len()].copy_from_slice(&routine);
        set_word(&mut memory, 0xb0, 0x134);
        set_word(&mut memory, 0x134, 0x6400);
        assert!(
            execute_direct(&mut memory, &mut cpu, &format!("B$={expression}")),
            "{expression}"
        );
        let record = numeric_scalar(&memory, [b'B', 0x80]);
        assert_eq!(record[0] as usize, result.len(), "{expression}");
        let pointer = u16::from_be_bytes([record[2], record[3]]) as usize;
        assert_eq!(
            &memory.bytes[pointer..pointer + result.len()],
            result.as_bytes(),
            "{expression}"
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn authoritative_array_references_survive_scalar_movement_and_forced_collection() {
    for (expression, expected) in [
        ("A$(1)+CHR$(Z+LEN(STRING$(48,65))+18)", Some("AB")),
        ("LEFT$(A$(1),Z+LEN(STRING$(48,65))-47)", Some("A")),
        ("INSTR(A$(1),CHR$(Z+LEN(STRING$(48,65))+17))", None),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "CLEAR50:DIM A$(1):Q$=STRING$(40,65):A$(1)=\"A\":Q$=\"\""
        ));
        let old_array = word(&memory, 0x1d);
        let old_pointer = word(&memory, usize::from(old_array) + 14);
        let destination = if expected.is_some() { "B$" } else { "B" };
        assert!(
            execute_direct(
                &mut memory,
                &mut cpu,
                &format!("{destination}={expression}")
            ),
            "{expression}"
        );
        let new_array = word(&memory, 0x1d);
        let new_pointer = word(&memory, usize::from(new_array) + 14);
        assert_eq!(
            new_array,
            old_array + 14,
            "destination and nested Z each add one scalar"
        );
        assert_ne!(
            new_pointer, old_pointer,
            "the pending source must move during collection"
        );
        assert_eq!(memory.bytes[usize::from(new_pointer)], b'A');
        if let Some(expected) = expected {
            let record = numeric_scalar(&memory, [b'B', 0x80]);
            assert_eq!(usize::from(record[0]), expected.len());
            let pointer = usize::from(u16::from_be_bytes([record[2], record[3]]));
            assert_eq!(
                &memory.bytes[pointer..pointer + expected.len()],
                expected.as_bytes()
            );
        } else {
            assert_eq!(numeric_scalar(&memory, [b'B', 0]), packed_integer(1));
        }
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn graphics_published_paint_span_traversal_contract() {
    use sha2::{Digest, Sha256};
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/8103b722f64defee-paint-observations.json"
    ))
    .unwrap();
    assert_eq!(
        facts["referenceSha256"],
        "fc0e900bfec6b52f0f80ba1e65a4712808d2a411b5b00496639ef1a2152351f1"
    );
    let mut differences = Vec::new();
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let id = fact["id"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        memory.execute_with_budget(&mut cpu, &init, 1_000_000);
        assert!(
            execute_direct_with_budget(&mut memory, &mut cpu, source, 8_388_608),
            "{source}"
        );
        for (address, value) in fact["workspace"].as_object().unwrap() {
            let address = usize::from_str_radix(address, 16).unwrap();
            let expected = u8::try_from(value.as_u64().unwrap()).unwrap();
            if memory.bytes[address] != expected {
                differences.push(format!(
                    "{id} ${address:04x}: {} expected {expected}",
                    memory.bytes[address]
                ));
            }
        }
        let size = usize::try_from(fact["canvasBytes"].as_u64().unwrap()).unwrap();
        assert_eq!(
            format!("{:x}", Sha256::digest(&memory.bytes[0x600..0x600 + size])),
            fact["syntheticCanvasSha256"].as_str().unwrap(),
            "{id}: canvas"
        );
    }
    assert!(differences.is_empty(), "{}", differences.join("\n"));
}

#[test]
fn shared_lvalue_references_follow_array_movement_and_preserve_failed_destinations() {
    for (source, string, expected, succeeds) in [
        ("A(1)=Z+7", false, "7", true),
        ("A(1)=CHR$(Z+65)", false, "9", false),
        ("A$(1)=CHR$(Z+88)", true, "X", true),
        ("A$(1)=Z+7", true, "HELLO", false),
        ("MID$(A$(1),Z+2,1)=CHR$(Y+88)", true, "HXLLO", true),
        ("MID$(A$(1),Z+2,1)=Y+7", true, "HELLO", false),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            if string {
                "DIM A$(1):A$(0)=\"KEEP\":A$(1)=\"HELLO\""
            } else {
                "DIM A(1):A(0)=11:A(1)=9"
            }
        ));
        let old_array = word(&memory, 0x1d);
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, source),
            succeeds,
            "{source}"
        );
        let new_array = word(&memory, 0x1d);
        assert_eq!(
            new_array,
            old_array + if source.starts_with("MID$") { 14 } else { 7 },
            "{source}"
        );
        assert_eq!(cpu.registers.s, 0x7000, "{source}");
        canonical_assert_empty(&memory);
        if !succeeds {
            assert_eq!(
                memory.bytes[usize::from(symbol("ERROR_CODE"))],
                24,
                "{source}"
            );
        }
        let first = usize::from(new_array) + 7;
        let second = first + 5;
        if string {
            for (at, text) in [(first, "KEEP"), (second, expected)] {
                let pointer = usize::from(word(&memory, at + 2));
                assert_eq!(usize::from(memory.bytes[at]), text.len(), "{source}");
                assert_eq!(
                    &memory.bytes[pointer..pointer + text.len()],
                    text.as_bytes(),
                    "{source}"
                );
            }
        } else {
            assert_eq!(
                &memory.bytes[first..first + 5],
                &packed_integer(11),
                "{source}"
            );
            assert_eq!(
                &memory.bytes[second..second + 5],
                &packed_integer(expected.parse().unwrap()),
                "{source}"
            );
        }
        assert!(execute_direct(&mut memory, &mut cpu, "Q=17"), "{source}");
        assert_eq!(
            numeric_scalar(&memory, [b'Q', 0]),
            packed_integer(17),
            "{source}"
        );
    }
}

fn install_authored_string_extension(memory: &mut Memory) {
    memory.bytes[0x6020..0x6024].copy_from_slice(b"ZIN\xc7");
    memory.bytes[0x12a..0x134].copy_from_slice(&[0, 0, 0, 0, 0, 1, 0x60, 0x20, 0x61, 0x40]);
    let mut code = Vec::new();
    for _ in 0..3 {
        call(&mut code, 0x009f);
    }
    // Set public type and descriptor pointer, as the authored lawful probe does.
    code.extend([0x86, 0xff, 0x97, 0x06, 0x8e, 0x63, 0x10, 0x9f, 0x52, 0x39]);
    memory.bytes[0x6140..0x6140 + code.len()].copy_from_slice(&code);
    memory.bytes[0x6300] = b'Z';
    memory.bytes[0x6310..0x6315].copy_from_slice(&[1, 0, 0x63, 0, 0]);
}

#[test]
fn readonly_cartridge_descriptors_preserve_their_full_public_address() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/59a233a127be02ea-rom-descriptor-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    assert_eq!(facts["authoredCartridgeOnly"], true);
    for fact in facts["cases"].as_array().unwrap() {
        let address = u16::try_from(fact["descriptorAddress"].as_u64().unwrap()).unwrap();
        let source = fact["source"].as_str().unwrap();
        let expected = fact["result"][0].as_str().unwrap().as_bytes();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        install_authored_string_extension(&mut memory);
        // The authored cartridge is above the entire explicit overflow image.
        assert!(
            0x8000
                + include_bytes!("../../../firmware/basic-complete/qualification/candidate.bin")
                    .len()
                < 0xd100
        );
        let pointer: u16 = if address < 0x8000 { 0x6320 } else { 0xd110 };
        let [high, low] = pointer.to_be_bytes();
        let descriptor = [1, 0, high, low, 0];
        let at = usize::from(address);
        memory.bytes[at..at + 5].copy_from_slice(&descriptor);
        memory.bytes[usize::from(pointer)] = b'Z';
        // Replace only the authored LDX operand, after its three scanner calls.
        set_word(&mut memory, 0x614e, address);
        assert!(
            execute_direct(&mut memory, &mut cpu, source),
            "{source} at {address:04x}"
        );
        let value = numeric_scalar(&memory, [b'B', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([value[2], value[3]]));
        assert_eq!(usize::from(value[0]), expected.len(), "{source}");
        assert_eq!(
            &memory.bytes[pointer..pointer + expected.len()],
            expected,
            "{source}"
        );
        assert_eq!(&memory.bytes[at..at + 5], &descriptor);
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn readonly_descriptors_survive_pending_arguments_collection_and_formatting() {
    for (source, payload, output, string_result, number, success) in [
        ("B$=RIGHT$(ZING(7),Q+1)", "AZ", "", "Z", None, true),
        ("B$=MID$(ZING(7),Q+2,1)", "AZ", "", "Z", None, true),
        ("B=INSTR(ZING(7),CHR$(Q+90))", "AZ", "", "", Some(2), true),
        (
            "B$=ZING(7)+STRING$(20,Q+66)",
            "Z",
            "",
            "ZBBBBBBBBBBBBBBBBBBBB",
            None,
            true,
        ),
        (
            "PRINT#-2,USING ZING(7);Q+12",
            "[##]",
            "[12]\r",
            "",
            None,
            true,
        ),
        (
            "PRINT#-2,USING ZING(7);CHR$(Q+90)",
            "[!]",
            "[Z]\r",
            "",
            None,
            true,
        ),
        ("PRINT#-2,USING ZING(7);Q+12", "[!]", "[", "", None, false),
        ("B$=LEFT$(ZING(7),Q-1)", "Z", "", "", None, false),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        enable_guest_printer(&mut memory);
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "CLEAR50:DIM A$(1):A$(1)=CHR$(75):T$=STRING$(40,65):T$=\"\""
        ));
        install_authored_string_extension(&mut memory);
        let length = u8::try_from(payload.len()).unwrap();
        let descriptor = [length, 0, 0xd1, 0x10, 0];
        memory.bytes[0xd100..0xd105].copy_from_slice(&descriptor);
        memory.bytes[0xd110..0xd110 + payload.len()].copy_from_slice(payload.as_bytes());
        set_word(&mut memory, 0x614e, 0xd100);
        let old_array = word(&memory, 0x1d);
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, source),
            success,
            "{source}"
        );
        assert!(
            word(&memory, 0x1d) > old_array,
            "Q moves the existing array: {source}"
        );
        if !string_result.is_empty() {
            let value = numeric_scalar(&memory, [b'B', 0x80]);
            let pointer = usize::from(u16::from_be_bytes([value[2], value[3]]));
            assert_eq!(usize::from(value[0]), string_result.len(), "{source}");
            assert_eq!(
                &memory.bytes[pointer..pointer + string_result.len()],
                string_result.as_bytes(),
                "{source}"
            );
        }
        if let Some(value) = number {
            assert_eq!(
                numeric_scalar(&memory, [b'B', 0]),
                packed_integer(value),
                "{source}"
            );
        }
        assert_eq!(memory.output, output.as_bytes(), "{source}");
        assert_eq!(&memory.bytes[0xd100..0xd105], &descriptor);
        assert_eq!(
            &memory.bytes[0xd110..0xd110 + payload.len()],
            payload.as_bytes()
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
        memory.output.clear();
        assert!(execute_direct(&mut memory, &mut cpu, "PRINT#-2,A$(1):Q=19"));
        assert_eq!(memory.output, b"K\r");
        assert_eq!(numeric_scalar(&memory, [b'Q', 0]), packed_integer(19));
    }
}

#[test]
fn external_chained_strings_use_the_published_descriptor_return_convention() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/262e80741d151586-chain-return-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"]
        .as_array()
        .unwrap()
        .iter()
        .filter(|fact| fact["id"].as_str().unwrap().starts_with("descriptor-"))
    {
        let source = fact["source"].as_str().unwrap();
        let expected = fact["result"].as_str().unwrap().as_bytes();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        install_authored_string_extension(&mut memory);
        memory.bytes[0xd8..0xea].fill(0xa5);
        assert!(execute_direct(&mut memory, &mut cpu, source), "{source}");
        let record = numeric_scalar(&memory, [b'B', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([record[2], record[3]]));
        assert_eq!(usize::from(record[0]), expected.len(), "{source}");
        assert_eq!(
            &memory.bytes[pointer..pointer + expected.len()],
            expected,
            "{source}"
        );
        assert_eq!(&memory.bytes[0x6310..0x6315], &[1, 0, 0x63, 0, 0]);
        assert_eq!(&memory.bytes[0xd8..0xea], &[0xa5; 18]);
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn external_string_descriptor_identity_is_independent_of_array_table_movement() {
    for (expression, expected) in [("ZING(7)+CHR$(Q+66)", "ZB"), ("LEFT$(ZING(7),Q+1)", "Z")] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        install_authored_string_extension(&mut memory);
        assert!(execute_direct(&mut memory, &mut cpu, "DIM A(1)"));
        let old_array = word(&memory, 0x1d);
        assert!(
            execute_direct(&mut memory, &mut cpu, &format!("B$={expression}")),
            "{expression}"
        );
        assert_eq!(
            word(&memory, 0x1d),
            old_array + 14,
            "destination and Q move the unrelated array"
        );
        let record = numeric_scalar(&memory, [b'B', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([record[2], record[3]]));
        assert_eq!(usize::from(record[0]), expected.len(), "{expression}");
        assert_eq!(
            &memory.bytes[pointer..pointer + expected.len()],
            expected.as_bytes(),
            "{expression}"
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn rebound_primary_functions_reject_descriptor_results_at_the_numeric_continuation() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/546df924859ca90f-primary-return-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    // Ordinal 22's pre-parser is separately qualified; these facts reached the
    // callback and establish the common return boundary across primary kinds.
    for fact in facts["cases"]
        .as_array()
        .unwrap()
        .iter()
        .filter(|fact| fact["called"] == true)
    {
        let ordinal = usize::try_from(fact["ordinal"].as_u64().unwrap()).unwrap();
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        let mut words = Vec::new();
        for index in 0..34 {
            words.extend(if index == ordinal {
                b"ZIN\xc7".as_slice()
            } else {
                b"QQ\xd1".as_slice()
            });
        }
        memory.bytes[0x6600..0x6600 + words.len()].copy_from_slice(&words);
        for index in 0..34 {
            set_word(&mut memory, 0x6700 + index * 2, 0x6140);
        }
        memory.bytes[0x125] = 34;
        set_word(&mut memory, 0x126, 0x6600);
        set_word(&mut memory, 0x128, 0x6700);
        let mut callback = vec![0x7c, 0x63, 0x02];
        if ordinal >= 22 {
            for _ in 0..3 {
                call(&mut callback, 0x009f);
            }
        }
        callback.extend([0x86, 0xff, 0x97, 0x06, 0x8e, 0x63, 0x10, 0x9f, 0x52, 0x39]);
        memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
        memory.bytes[0x6300] = b'Z';
        memory.bytes[0x6310..0x6315].copy_from_slice(&[1, 0, 0x63, 0, 0]);
        assert!(
            !execute_direct(&mut memory, &mut cpu, source),
            "ordinal {ordinal}: {source}"
        );
        assert_eq!(memory.bytes[0x6302], 1, "ordinal {ordinal}: {source}");
        assert_eq!(
            memory.bytes[usize::from(symbol("ERROR_CODE"))],
            24,
            "ordinal {ordinal}: {source}"
        );
        assert_eq!(
            numeric_scalar(&memory, [b'B', 0x80]),
            [0; 5],
            "failed assignment stays empty"
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn chained_string_descriptor_is_borrowed_without_creating_a_public_temporary() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/7f359bb9ba435b6b-chain-pending-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    assert_eq!(facts["observation"]["temporaryCount"], 0);
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    set_word(&mut memory, 0x27, 0x7ffe);
    set_word(&mut memory, 0x23, 0x7ffe);
    install_authored_string_extension(&mut memory);
    let mut observer = vec![
        0xdc, 0x0b, 0xfd, 0x63, 0x20, 0xdc, 0x0d, 0xfd, 0x63, 0x22, 0xcc, 0, 66,
    ];
    call(&mut observer, 0x8c37);
    observer.push(0x39);
    memory.bytes[0x6400..0x6400 + observer.len()].copy_from_slice(&observer);
    set_word(&mut memory, 0xb0, 0x134);
    set_word(&mut memory, 0x134, 0x6400);
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        facts["source"].as_str().unwrap()
    ));
    assert_eq!(word(&memory, 0x6320), 0x1a9);
    assert_eq!(word(&memory, 0x6322), 0x1a4);
    let record = numeric_scalar(&memory, [b'B', 0x80]);
    let pointer = usize::from(u16::from_be_bytes([record[2], record[3]]));
    assert_eq!(record[0], 2);
    assert_eq!(&memory.bytes[pointer..pointer + 2], b"ZB");
    canonical_assert_empty(&memory);
    assert_eq!(cpu.registers.s, 0x7000);
}

#[test]
fn pending_external_string_values_observe_the_original_descriptor_mutation() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/bfc066f82e6fc775-chain-mutation-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for (source, returned, expected) in [
        ("B$=ZING(7)+CHR$(USR0(66))", 66, b"BB".as_slice()),
        ("B$=LEFT$(ZING(7),USR0(1))", 1, b"B".as_slice()),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        install_authored_string_extension(&mut memory);
        memory.bytes[0x6320] = b'B';
        let mut callback = vec![0xcc, 0x63, 0x20, 0xfd, 0x63, 0x12, 0xcc, 0, returned];
        call(&mut callback, 0x8c37);
        callback.push(0x39);
        memory.bytes[0x6400..0x6400 + callback.len()].copy_from_slice(&callback);
        set_word(&mut memory, 0xb0, 0x134);
        set_word(&mut memory, 0x134, 0x6400);
        assert!(execute_direct(&mut memory, &mut cpu, source), "{source}");
        let record = numeric_scalar(&memory, [b'B', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([record[2], record[3]]));
        assert_eq!(usize::from(record[0]), expected.len(), "{source}");
        assert_eq!(
            &memory.bytes[pointer..pointer + expected.len()],
            expected,
            "{source}"
        );
        assert_eq!(word(&memory, 0x6312), 0x6320);
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn machine_code_string_arguments_publish_descriptors_and_exact_temporary_lifetimes() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/ab99a869eeaff9b6-callback-string-entry-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let usr = fact["kind"] == "usr";
        for outer in [false, true] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            set_word(&mut memory, 0x27, 0x7ffe);
            set_word(&mut memory, 0x23, 0x7ffe);
            assert!(execute_direct(
                &mut memory,
                &mut cpu,
                "A$=\"Z\":A$(1)=\"Z\""
            ));
            let mut callback = vec![
                0xbf, 0x63, 0x30, 0xdc, 0x52, 0xfd, 0x63, 0x32, 0xdc, 0x0b, 0xfd, 0x63, 0x34, 0x9e,
                0x52, 0xa6, 0x84, 0xb7, 0x63, 0x36, 0xae, 0x02, 0xa6, 0x84, 0xb7, 0x63, 0x37, 0x96,
                0x06, 0xb7, 0x63, 0x38, 0xcc, 0, 66,
            ];
            call(&mut callback, 0x8c37);
            callback.push(0x39);
            memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
            let function = if usr {
                set_word(&mut memory, 0xb0, 0x134);
                set_word(&mut memory, 0x134, 0x6140);
                "USR0"
            } else {
                let ordinal = usize::try_from(fact["ordinal"].as_u64().unwrap()).unwrap();
                let mut words = Vec::new();
                for index in 0..34 {
                    words.extend(if index == ordinal {
                        b"ZIN\xc7".as_slice()
                    } else {
                        b"QQ\xd1".as_slice()
                    });
                }
                memory.bytes[0x6600..0x6600 + words.len()].copy_from_slice(&words);
                for index in 0..34 {
                    set_word(&mut memory, 0x6700 + index * 2, 0x6140);
                }
                memory.bytes[0x125] = 34;
                set_word(&mut memory, 0x126, 0x6600);
                set_word(&mut memory, 0x128, 0x6700);
                "ZING"
            };
            let value = format!("{function}({})", fact["argument"].as_str().unwrap());
            let source = if outer && usr {
                format!("B$=CHR$(65)+CHR$({value})")
            } else if outer {
                format!("B=\"A\"+{value}")
            } else {
                format!("B={value}")
            };
            assert_eq!(
                execute_direct(&mut memory, &mut cpu, &source),
                !outer || usr,
                "{source}"
            );
            assert_eq!(memory.bytes[0x6336], 1, "{source}");
            assert_eq!(memory.bytes[0x6337], b'Z', "{source}");
            assert_eq!(memory.bytes[0x6338], 255, "{source}");
            assert_eq!(
                word(&memory, 0x6330) == word(&memory, 0x6332),
                fact["facPointerEqualsX"].as_bool().unwrap(),
                "{source}"
            );
            let count =
                u16::try_from(fact["temporaryCount"].as_u64().unwrap()).unwrap() + u16::from(outer);
            assert_eq!(word(&memory, 0x6334), 0x1a9 + 5 * count, "{source}");
            if outer && usr {
                let record = numeric_scalar(&memory, [b'B', 0x80]);
                let pointer = usize::from(u16::from_be_bytes([record[2], record[3]]));
                assert_eq!(record[0], 2);
                assert_eq!(&memory.bytes[pointer..pointer + 2], b"AB");
            } else {
                assert_eq!(
                    numeric_scalar(&memory, [b'B', 0]),
                    packed_integer(if outer { 0 } else { 66 })
                );
            }
            canonical_assert_empty(&memory);
            assert_eq!(cpu.registers.s, 0x7000);
        }
    }
}

#[test]
fn published_cassette_prepare_wraps_zero_leader_and_preserves_input_status() {
    // Authored exact-SHA observations: zero is a complete 16-bit countdown,
    // both documented call forms retain $81, and $90/$91 is never consumed.
    for (entry, count, status) in [
        (0x801b, 0_u16, 165_u8),
        (0x801b, 1, 0),
        (0x801b, 2, 165),
        (0x801b, 255, 165),
        (0xa00c, 1, 165),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        memory.signal_limit = 0;
        memory.bytes[0xff21] = 0x34;
        memory.bytes[0x81] = status;
        set_word(&mut memory, 0x90, count);
        set_word(&mut memory, 0x95, 1);
        cpu.registers.cc = 0x51;
        let mut code = Vec::new();
        if entry == 0xa00c {
            code.extend([0xad, 0x9f, 0xa0, 0x0c]);
        } else {
            call(&mut code, entry);
        }
        memory.execute_with_budget(&mut cpu, &code, 200_000_000);
        let bytes = if count == 0 {
            65536_usize
        } else {
            usize::from(count)
        };
        assert_eq!(
            memory.rising_edges,
            bytes * 8,
            "entry {entry:04x}, count {count}"
        );
        assert_eq!(memory.bytes[0x81], status, "prepare preserves input status");
        assert_eq!(word(&memory, 0x90), count);
        assert_eq!(word(&memory, 0x95), 1);
        assert_ne!(memory.bytes[0xff21] & 8, 0);
        assert_eq!(cpu.registers.cc & 0x50, 0x50);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

fn install_primary_argument_probe(memory: &mut Memory, ordinal: usize) {
    let mut words = Vec::new();
    for index in 0..34 {
        words.extend(if index == ordinal {
            b"ZIN\xc7".as_slice()
        } else {
            b"QQ\xd1".as_slice()
        });
    }
    memory.bytes[0x6600..0x6600 + words.len()].copy_from_slice(&words);
    for index in 0..34 {
        set_word(memory, 0x6700 + index * 2, 0x6140);
    }
    memory.bytes[0x125] = 34;
    set_word(memory, 0x126, 0x6600);
    set_word(memory, 0x128, 0x6700);
}

#[test]
fn primary_function_preprocessing_matches_observed_cursor_register_and_stack_arguments() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/2dbb294de4e0917b-primary-multi-entry-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let ordinal = usize::try_from(fact["ordinal"].as_u64().unwrap()).unwrap();
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        install_primary_argument_probe(&mut memory, ordinal);
        guest_tokens(&mut memory, &mut cpu, source);
        let mut entry = vec![0x8e, 2, 0xdc];
        call_guest_executor(&mut entry);
        memory.bytes[0x2000..0x2000 + entry.len()].copy_from_slice(&entry);
        cpu.registers.pc = 0x2000;
        cpu.registers.s = 0x7000;
        for _ in 0..1_000_000 {
            if cpu.registers.pc == 0x6140 {
                break;
            }
            cpu.step(&mut memory).unwrap();
        }
        assert_eq!(cpu.registers.pc, 0x6140, "callback entry: {source}");
        assert_eq!(
            cpu.registers.a,
            u8::try_from(fact["a"].as_u64().unwrap()).unwrap(),
            "A {source}"
        );
        assert_eq!(
            cpu.registers.b,
            u8::try_from(fact["b"].as_u64().unwrap()).unwrap(),
            "B {source}"
        );
        assert_eq!(
            cpu.registers.x,
            0x6700 + u16::try_from(ordinal * 2).unwrap(),
            "table entry {source}"
        );
        let cursor = word(&memory, 0xa6);
        assert_eq!(
            cursor,
            0x2d9 + u16::try_from(fact["cursorOffset"].as_u64().unwrap()).unwrap(),
            "cursor {source}"
        );
        assert_eq!(
            memory.bytes[0x06],
            u8::try_from(fact["type"].as_u64().unwrap()).unwrap(),
            "type {source}"
        );
        assert_eq!(
            word(&memory, 0x0b),
            0x1a9 + 5 * u16::try_from(fact["temporaryCount"].as_u64().unwrap()).unwrap(),
            "temporary {source}"
        );
        for descriptor in fact["stackDescriptors"].as_array().unwrap() {
            let address = usize::from(cpu.registers.s)
                + usize::try_from(descriptor["offset"].as_u64().unwrap()).unwrap();
            let pointer = usize::from(word(&memory, address));
            let text = descriptor["authoredText"].as_str().unwrap().as_bytes();
            assert_eq!(
                usize::from(memory.bytes[pointer]),
                text.len(),
                "descriptor length {source}"
            );
            let chars = usize::from(word(&memory, pointer + 2));
            assert_eq!(
                &memory.bytes[chars..chars + text.len()],
                text,
                "descriptor contents {source}"
            );
        }
        if (22..=24).contains(&ordinal) {
            assert_eq!(cpu.registers.u, 0, "count conversion U {source}");
            assert_eq!(
                memory.bytes[usize::from(cpu.registers.s) + 2],
                2,
                "stack count {source}"
            );
            for offset in 0..8 {
                assert_eq!(
                    memory.bytes[0x4f + offset],
                    u8::try_from(fact["publicFacBytes"][offset].as_u64().unwrap()).unwrap(),
                    "FAC offset {offset}: {source}"
                );
            }
        }
    }
}

#[test]
fn primary_slice_callbacks_own_argument_cleanup_and_numeric_continuation() {
    for (ordinal, source, advance, cleanup) in [
        (22, "A=ZING(\"XYZ\",2)", 1, 3),
        (23, "A=ZING(\"XYZ\",2)", 1, 3),
        (24, "A=ZING(\"XYZ\",2)", 1, 3),
        (24, "A=ZING(\"XYZ\",2,1)", 3, 3),
        (25, "A=ZING(2,3)", 4, 0),
    ] {
        for string_return in [false, true] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            set_word(&mut memory, 0x27, 0x7ffe);
            set_word(&mut memory, 0x23, 0x7ffe);
            install_primary_argument_probe(&mut memory, ordinal);
            let mut callback = vec![0x7c, 0x63, 0x02];
            for _ in 0..advance {
                call(&mut callback, 0x009f);
            }
            if string_return {
                callback.extend([0x86, 0xff, 0x97, 0x06, 0x8e, 0x63, 0x10, 0x9f, 0x52]);
            } else {
                callback.extend([0xcc, 0, 123]);
                call(&mut callback, 0x8c37);
            }
            if cleanup == 3 {
                callback.extend([0x35, 0x20, 0x32, 0x63, 0x6e, 0xa4]);
            } else {
                callback.push(0x39);
            }
            memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
            memory.bytes[0x6310..0x6315].copy_from_slice(&[1, 0, 0x63, 0, 0]);
            memory.bytes[0x6300] = b'Z';
            assert_eq!(
                execute_direct(&mut memory, &mut cpu, source),
                !string_return,
                "ordinal {ordinal}: {source}"
            );
            assert_eq!(memory.bytes[0x6302], 1, "callback reached {source}");
            assert_eq!(
                numeric_scalar(&memory, [b'A', 0]),
                packed_integer(if string_return { 0 } else { 123 }),
                "result {source}"
            );
            if string_return {
                assert_eq!(
                    memory.bytes[usize::from(symbol("ERROR_CODE"))],
                    24,
                    "TM {source}"
                );
            }
            canonical_assert_empty(&memory);
            assert_eq!(cpu.registers.s, 0x7000);
            assert!(execute_direct(&mut memory, &mut cpu, "Q=17"));
            assert_eq!(numeric_scalar(&memory, [b'Q', 0]), packed_integer(17));
        }
    }
}

#[test]
fn primary_slice_byte_conversion_and_error_order_match_original_observations() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/a767604d44dea855-primary-byte-entry-observations.json"
    ))
    .unwrap();
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let called = fact["called"].as_bool().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        install_primary_argument_probe(&mut memory, 22);
        let mut callback = vec![0x7c, 0x63, 0x02];
        for offset in 0..8 {
            callback.extend([0x96, 0x4f + offset, 0xb7, 0x63, 0x40 + offset]);
        }
        call(&mut callback, 0x009f);
        callback.extend([0xcc, 0, 123]);
        call(&mut callback, 0x8c37);
        callback.extend([0x35, 0x20, 0x32, 0x63, 0x6e, 0xa4]);
        memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, source),
            called,
            "{source}"
        );
        assert_eq!(memory.bytes[0x6302], u8::from(called), "callback {source}");
        if called {
            for offset in 0..8 {
                assert_eq!(
                    memory.bytes[0x6340 + offset],
                    u8::try_from(fact["publicFacBytes"][offset].as_u64().unwrap()).unwrap(),
                    "FAC {offset}: {source}"
                );
            }
            assert_eq!(numeric_scalar(&memory, [b'A', 0]), packed_integer(123));
        } else {
            let error = match fact["errors"][0].as_str().unwrap() {
                "SN" => 2,
                "FC" => 8,
                "TM" => 24,
                _ => panic!("unqualified error"),
            };
            assert_eq!(
                memory.bytes[usize::from(symbol("ERROR_CODE"))],
                error,
                "{source}"
            );
            assert_eq!(numeric_scalar(&memory, [b'A', 0]), [0; 5]);
        }
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
        assert!(execute_direct(&mut memory, &mut cpu, "Q=17"));
        assert_eq!(numeric_scalar(&memory, [b'Q', 0]), packed_integer(17));
    }
}

#[test]
fn primary_slice_argument_identity_tracks_later_array_movement() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    set_word(&mut memory, 0x27, 0x7ffe);
    set_word(&mut memory, 0x23, 0x7ffe);
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        "DIM A$(1):A$(1)=\"XYZ\""
    ));
    let old_array = word(&memory, 0x1d);
    install_primary_argument_probe(&mut memory, 22);
    // Read the public descriptor from S+3 before consuming its argument frame.
    let mut callback = vec![
        0xae, 0x63, 0xbf, 0x63, 0x30, 0xa6, 0x84, 0xb7, 0x63, 0x32, 0xae, 0x02, 0xa6, 0x84, 0xb7,
        0x63, 0x33,
    ];
    call(&mut callback, 0x009f);
    callback.extend([0xcc, 0, 123]);
    call(&mut callback, 0x8c37);
    callback.extend([0x35, 0x20, 0x32, 0x63, 0x6e, 0xa4]);
    memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
    assert!(execute_direct(&mut memory, &mut cpu, "A=ZING(A$(1),Q+2)"));
    assert_eq!(word(&memory, 0x1d), old_array + 14);
    assert_eq!(word(&memory, 0x6330), word(&memory, 0x1d) + 12);
    assert_eq!(&memory.bytes[0x6332..0x6334], &[3, b'X']);
    assert_eq!(numeric_scalar(&memory, [b'A', 0]), packed_integer(123));
    canonical_assert_empty(&memory);
    assert_eq!(cpu.registers.s, 0x7000);
}

#[test]
fn copied_primary_function_table_preserves_each_unchanged_builtin_entry() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/230ef477720e3727-copied-function-table-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        let table = usize::from(word(&memory, 0x128));
        let entries = memory.bytes[table..table + 68].to_vec();
        memory.bytes[0x6700..0x6744].copy_from_slice(&entries);
        set_word(&mut memory, 0x128, 0x6700);
        set_word(&mut memory, 0x6700, 0x6140);
        let mut callback = vec![0x7c, 0x63, 0x02, 0xcc, 0, 123];
        call(&mut callback, 0x8c37);
        callback.push(0x39);
        memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
        assert!(execute_direct(&mut memory, &mut cpu, source), "{source}");
        assert_eq!(
            memory.bytes[0x6302],
            u8::from(fact["replacementCalled"].as_bool().unwrap()),
            "{source}"
        );
        if let Some(expected) = fact["result"].as_str() {
            let descriptor = numeric_scalar(&memory, [b'B', 0x80]);
            let pointer = usize::from(u16::from_be_bytes([descriptor[2], descriptor[3]]));
            assert_eq!(usize::from(descriptor[0]), expected.len(), "{source}");
            assert_eq!(
                &memory.bytes[pointer..pointer + expected.len()],
                expected.as_bytes(),
                "{source}"
            );
        } else {
            assert_eq!(
                numeric_scalar(&memory, [b'A', 0]),
                packed_number(fact["result"].as_f64().unwrap()),
                "{source}"
            );
        }
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn published_screen_control_and_inverse_cells_match_authored_reference_sweep() {
    use sha2::{Digest, Sha256};
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/faa8d1e07419084f-screen-reference-observations.json"
    ))
    .unwrap();
    let cases = facts["cases"].as_array().unwrap();
    assert_eq!(cases.len(), 1536);
    for c in cases {
        let cursor = u16::try_from(c["cursor"].as_u64().unwrap()).unwrap();
        let byte = u8::try_from(c["byte"].as_u64().unwrap()).unwrap();
        let mut m = Memory::new();
        let mut cpu = Cpu::default();
        m.signal_limit = 0;
        for i in 0..512 {
            m.bytes[0x400 + i] = 0x40 + u8::try_from(i % 32).unwrap();
        }
        set_word(&mut m, 0x88, cursor);
        m.bytes[0x6c] = (cursor & 31) as u8;
        m.bytes[0x2000..0x2003].copy_from_slice(&[0xbd, 0x80, 0x0c]);
        cpu.registers = Registers {
            pc: 0x2000,
            s: 0x7000,
            x: 0x4567,
            y: 0x5678,
            u: 0x6789,
            a: byte,
            b: 0x34,
            cc: 0x50,
            ..Registers::default()
        };
        let mut returned = false;
        for _ in 0..100_000 {
            if cpu.registers.pc == 0x2003 {
                returned = true;
                break;
            }
            cpu.step(&mut m).unwrap();
        }
        assert!(
            returned,
            "screen did not return for byte {byte}, cursor {cursor}"
        );
        assert_eq!(
            word(&m, 0x88),
            u16::try_from(c["cursorAfter"].as_u64().unwrap()).unwrap(),
            "cursor: byte {byte}, initial {cursor}"
        );
        assert_eq!(
            hex::encode(Sha256::digest(&m.bytes[0x400..0x600])),
            c["canvasSha256"].as_str().unwrap(),
            "canvas: byte {byte}, initial {cursor}"
        );
        assert_eq!(
            (
                cpu.registers.a,
                cpu.registers.b,
                cpu.registers.x,
                cpu.registers.y,
                cpu.registers.u,
                cpu.registers.s
            ),
            (byte, 0x34, 0x4567, 0x5678, 0x6789, 0x7000)
        );
    }
}

#[test]
fn published_screen_column_cache_follows_pos_and_print_field_boundaries() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/fed8633c11ce8e00-column-statement-facts.json"
    ))
    .unwrap();
    for c in facts["cases"].as_array().unwrap() {
        let id = c["id"].as_str().unwrap();
        let mut m = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        m.bytes[0x6f] = 0;
        for line in c["source"]
            .as_str()
            .unwrap()
            .split('\r')
            .filter(|s| !s.is_empty())
        {
            assert!(execute_direct(&mut m, &mut cpu, line), "{id}: {line}");
        }
        for (name, value) in c["values"].as_object().unwrap() {
            assert_eq!(
                numeric_scalar(&m, [name.as_bytes()[0], 0]),
                packed_integer(i16::try_from(value.as_i64().unwrap()).unwrap()),
                "{id}: {name}"
            );
        }
    }
}
#[test]
fn published_character_output_retains_column_cache_across_direct_and_indirect_entries() {
    use sha2::{Digest, Sha256};
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/78a7c03942b07cae-column-reference-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["cases"].as_array().unwrap().len(), 81);
    for c in facts["cases"].as_array().unwrap() {
        let entry = u16::try_from(c["entry"].as_u64().unwrap()).unwrap();
        let cursor = u16::try_from(c["cursor"].as_u64().unwrap()).unwrap();
        let byte = u8::try_from(c["byte"].as_u64().unwrap()).unwrap();
        let mut m = Memory::new();
        let mut cpu = Cpu::default();
        m.signal_limit = 0;
        for i in 0..512 {
            m.bytes[0x400 + i] = 0x40 + u8::try_from(i % 32).unwrap();
        }
        set_word(&mut m, 0x88, cursor);
        m.bytes[0x6c] = 5;
        m.bytes[0x167..0x16a].copy_from_slice(&[0x7e, 0x65, 0x00]);
        m.bytes[0x6500..0x6509]
            .copy_from_slice(&[0x34, 0x02, 0x96, 0x6c, 0xb7, 0x63, 0xa0, 0x35, 0x82]);
        m.bytes[0x63a0] = 0xa5;
        let code = if entry == 0xa002 {
            vec![0xad, 0x9f, 0xa0, 0x02]
        } else {
            let mut c = Vec::new();
            call(&mut c, entry);
            c
        };
        cpu.registers = Registers {
            a: byte,
            b: 0x34,
            x: 0x4567,
            y: 0x5678,
            u: 0x6789,
            cc: 0x50,
            ..Registers::default()
        };
        m.execute_with_budget(&mut cpu, &code, 100_000);
        assert_eq!(
            m.bytes[0x6c],
            u8::try_from(c["columnAfter"].as_u64().unwrap()).unwrap(),
            "column {entry:x}/{cursor:x}/{byte}"
        );
        assert_eq!(
            m.bytes[0x63a0],
            u8::try_from(c["hookColumn"].as_u64().unwrap()).unwrap(),
            "hook {entry:x}/{cursor:x}/{byte}"
        );
        assert_eq!(
            word(&m, 0x88),
            u16::try_from(c["cursorAfter"].as_u64().unwrap()).unwrap()
        );
        assert_eq!(
            hex::encode(Sha256::digest(&m.bytes[0x400..0x600])),
            c["canvasSha256"].as_str().unwrap()
        );
    }
}
#[test]
fn successful_cassette_status_retains_the_prior_column_cache() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/c2341f45b917d282-cassette-column-observations.json"
    ))
    .unwrap();
    let mut checked = 0;
    for c in facts["cases"].as_array().unwrap() {
        if c["completionPhase"].as_u64().unwrap() != 1 {
            continue;
        }
        let mut m = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        m.bytes[0x6f] = 0;
        m.bytes[0x6c] = 5;
        set_word(&mut m, 0x88, 0x4a5);
        let mut tape = Vec::new();
        for f in c["files"].as_array().unwrap() {
            let mut header = f["name"].as_str().unwrap().as_bytes().to_vec();
            header.extend([
                u8::try_from(f["type"].as_u64().unwrap_or(2)).unwrap(),
                u8::try_from(f["ascii"].as_u64().unwrap_or(0)).unwrap(),
                u8::try_from(f["gap"].as_u64().unwrap_or(0)).unwrap(),
                0x60,
                0,
                0x60,
                0,
            ]);
            append_synthetic_cassette_block(&mut tape, 0, &header);
            let data = f["data"]
                .as_array()
                .map(|a| {
                    a.iter()
                        .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
                        .collect::<Vec<_>>()
                })
                .unwrap_or(vec![0x39]);
            append_synthetic_cassette_block(&mut tape, 1, &data);
            append_synthetic_cassette_block(&mut tape, 255, &[]);
        }
        tape.extend([0x55; 16]);
        synthetic_tape(&mut m, &tape);
        assert!(
            execute_direct_with_budget(&mut m, &mut cpu, c["source"].as_str().unwrap(), 16_777_216),
            "{}",
            c["id"]
        );
        assert_eq!(
            m.bytes[0x6c],
            u8::try_from(c["column"].as_u64().unwrap()).unwrap(),
            "{}",
            c["id"]
        );
        assert_eq!(
            word(&m, 0x88),
            u16::try_from(c["cursor"].as_u64().unwrap()).unwrap()
        );
        checked += 1;
    }
    assert_eq!(checked, 5);
}

#[test]
fn copied_primary_statement_table_preserves_unchanged_commands_and_replacement() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/d6e12c5544196e54-copied-statement-table-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        let table = usize::from(word(&memory, 0x123));
        let entries = memory.bytes[table..table + 118].to_vec();
        memory.bytes[0x6700..0x6776].copy_from_slice(&entries);
        set_word(&mut memory, 0x123, 0x6700);
        set_word(&mut memory, 0x6740, 0x6140);
        memory.bytes[0x6140..0x6144].copy_from_slice(&[0x7c, 0x63, 0x02, 0x39]);
        let success = fact["errors"].as_array().unwrap().is_empty();
        assert_eq!(
            execute_direct(&mut memory, &mut cpu, source),
            success,
            "{source}"
        );
        assert_eq!(
            memory.bytes[0x6302],
            u8::from(fact["replacementCalled"].as_bool().unwrap()),
            "{source}"
        );
        assert_eq!(
            memory.bytes[0x6303],
            if fact["pokeMarker"] == true { 85 } else { 0 },
            "{source}"
        );
        if let Some(expected) = fact["result"].as_f64() {
            assert_eq!(
                numeric_scalar(&memory, [b'A', 0]),
                packed_number(expected),
                "{source}"
            );
        }
        if source.starts_with("PRINT") {
            assert_eq!(memory.bytes[0x400], b'Z');
            assert_eq!(word(&memory, 0x88), 0x401);
        }
        if !success {
            assert_eq!(
                memory.bytes[usize::from(symbol("ERROR_CODE"))],
                6,
                "observed OD: {source}"
            );
        }
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn external_heap_descriptors_match_reference_collection_ownership() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/14e007f0de3a2472-external-heap-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let id = fact["id"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR50"));
        install_authored_string_extension(&mut memory);
        let callback = [
            0x7c, 0x63, 0x38, 0xbd, 0, 0x9f, 0xbd, 0, 0x9f, 0xbd, 0, 0x9f, 0x86, 0xff, 0x97, 6,
            0xbe, 0x63, 0x34, 0x9f, 0x52, 0x39,
        ];
        memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "Q$=STRING$(40,65):Q$=\"\":A$=CHR$(90):M=VARPTR(A$)"
        ));
        let scalar = (usize::from(word(&memory, 0x1b))..usize::from(word(&memory, 0x1d)))
            .step_by(7)
            .find(|&p| memory.bytes[p..p + 2] == [b'A', 0x80])
            .unwrap()
            + 2;
        let original = word(&memory, scalar + 2);
        let descriptor = if fact["usesScalarDescriptor"].as_bool().unwrap() {
            scalar
        } else {
            let value = memory.bytes[scalar..scalar + 5].to_vec();
            memory.bytes[0x6310..0x6315].copy_from_slice(&value);
            0x6310
        };
        set_word(&mut memory, 0x6334, u16::try_from(descriptor).unwrap());
        if !fact["retainsScalarAlias"].as_bool().unwrap() {
            assert!(execute_direct(&mut memory, &mut cpu, "A$=\"\""));
        }
        assert!(
            execute_direct(&mut memory, &mut cpu, source),
            "{id}: {source}"
        );
        assert_eq!(memory.bytes[0x6338], 1, "callback {id}");
        let expected = fact["result"].as_str().unwrap().as_bytes();
        let value = numeric_scalar(&memory, [b'B', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([value[2], value[3]]));
        assert_eq!(usize::from(value[0]), expected.len(), "length {id}");
        assert_eq!(
            &memory.bytes[pointer..pointer + expected.len()],
            expected,
            "value {id}"
        );
        assert_eq!(
            word(&memory, descriptor + 2) != original,
            fact["descriptorMoved"].as_bool().unwrap(),
            "descriptor movement {id}"
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn static_strings_above_a_reduced_memory_limit_survive_collection() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/static-string-memory-limit.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let address = u16::try_from(fact["staticAddress"].as_u64().unwrap()).unwrap();
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        assert!(execute_direct(&mut memory, &mut cpu, "CLEAR50,24000"));
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "Q$=STRING$(40,65):Q$=\"\":A$=CHR$(90):M=VARPTR(A$)"
        ));
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            &format!(
                "POKE{address},90:POKEM+2,{}:POKEM+3,{}",
                address >> 8,
                address & 255
            )
        ));
        assert!(execute_direct(&mut memory, &mut cpu, source), "{fact}");
        for name in [b'A', b'B'] {
            let expected = &fact["strings"][char::from(name).to_string()];
            let descriptor = numeric_scalar(&memory, [name, 0x80]);
            let pointer = usize::from(u16::from_be_bytes([descriptor[2], descriptor[3]]));
            assert_eq!(
                &memory.bytes[pointer..pointer + usize::from(descriptor[0])],
                expected["text"].as_str().unwrap().as_bytes(),
                "{fact}"
            );
            assert_eq!(
                pointer,
                usize::try_from(expected["pointer"].as_u64().unwrap()).unwrap(),
                "{fact}"
            );
        }
        assert_eq!(
            u64::from(word(&memory, 0x23)),
            fact["fretop"].as_u64().unwrap()
        );
        assert_eq!(memory.bytes[usize::from(address)], b'Z');
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

#[test]
fn line_input_clear_key_discards_prefix_clears_screen_and_recovers_after_full_buffer() {
    use sha2::{Digest, Sha256};
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/45d22bde85f8e821-clear-input-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["cases"].as_array().unwrap().len(), 7);
    for c in facts["cases"].as_array().unwrap() {
        let id = c["id"].as_str().unwrap();
        let keys = c["keys"].as_str().unwrap();
        let mut reply = keys.as_bytes().to_vec();
        reply.push(13);
        let mut m = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut m);
        enable_guest_printer(&mut m);
        m.bytes[0x6f] = 0;
        supply_original_keyboard(&mut m, &reply);
        m.bytes[0x400..0x600].fill(0x55);
        assert!(
            execute_input_programme(&mut m, &mut cpu, "LINE INPUT A$"),
            "{id}"
        );
        let value = numeric_scalar(&m, [b'A', 128]);
        let p = usize::from(u16::from_be_bytes([value[2], value[3]]));
        let expected: Vec<u8> = c["result"]["textBytes"]
            .as_array()
            .unwrap()
            .iter()
            .map(|b| u8::try_from(b.as_u64().unwrap()).unwrap())
            .collect();
        assert_eq!(
            &m.bytes[p..p + usize::from(value[0])],
            expected,
            "{id}: reply"
        );
        assert_eq!(
            m.bytes[0x6c],
            u8::try_from(c["result"]["column"].as_u64().unwrap()).unwrap(),
            "{id}: column"
        );
        if keys.contains('\x0c') {
            // Clear owns the entire canvas, so the preceding boot/prompt is irrelevant.
            assert_eq!(
                word(&m, 0x88),
                u16::try_from(c["result"]["cursor"].as_u64().unwrap()).unwrap(),
                "{id}: cursor"
            );
            assert_eq!(
                hex::encode(Sha256::digest(&m.bytes[0x400..0x600])),
                c["result"]["canvasSha256"].as_str().unwrap(),
                "{id}: canvas"
            );
        }
        assert_eq!(cpu.registers.s, 0x7000, "{id}: stack");
    }
}

#[test]
fn returned_canonical_aliases_consume_only_the_active_top_descriptor() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/6069494a70a93416-canonical-alias-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let address = u16::try_from(fact["returnedDescriptor"].as_u64().unwrap()).unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        install_authored_string_extension(&mut memory);
        let mut callback = vec![0x7c, 0x63, 0x38];
        for _ in 0..3 {
            call(&mut callback, 0x009f);
        }
        callback.extend([0x86, 0xff, 0x97, 6, 0x8e]);
        callback.extend(address.to_be_bytes());
        callback.extend([0x9f, 0x52, 0x39]);
        memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
        if fact["pendingCount"] == 0 {
            memory.bytes[0x1a9..0x1ae].copy_from_slice(&[1, 0, 0x63, 0, 0]);
        }
        set_word(&mut memory, 0xb0, 0x134);
        set_word(&mut memory, 0x134, 0x6000);
        guest_tokens(&mut memory, &mut cpu, source);
        let mut code = vec![0x8e, 2, 0xdc];
        call_guest_executor(&mut code);
        memory.bytes[0x2000..0x2000 + code.len()].copy_from_slice(&code);
        cpu.registers.pc = 0x2000;
        cpu.registers.s = 0x7000;
        for _ in 0..200_000 {
            if cpu.registers.pc == 0x6000 {
                break;
            }
            cpu.step(&mut memory).unwrap();
        }
        assert_eq!(cpu.registers.pc, 0x6000, "{source}");
        assert_eq!(memory.bytes[0x6338], 1, "{source}");
        let expected = 0x1a9 + 5 * u16::try_from(fact["temporaryCount"].as_u64().unwrap()).unwrap();
        assert_eq!(
            word(&memory, 0x0b),
            expected,
            "{source}, descriptor {address:04x}"
        );
        assert_eq!(word(&memory, 0x0d), expected - 5, "{source}");
    }
}

#[test]
fn returned_canonical_aliases_preserve_reference_completion_values() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/a248c5e54d7d4304-canonical-alias-completion-observations.json"
    ))
    .unwrap();
    assert_eq!(facts["romInstructionsInspected"], false);
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let address = u16::try_from(fact["returnedDescriptor"].as_u64().unwrap()).unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        set_word(&mut memory, 0x27, 0x7ffe);
        set_word(&mut memory, 0x23, 0x7ffe);
        install_authored_string_extension(&mut memory);
        let mut callback = vec![0x7c, 0x63, 0x38];
        for _ in 0..3 {
            call(&mut callback, 0x009f);
        }
        callback.extend([0x86, 0xff, 0x97, 6, 0x8e]);
        callback.extend(address.to_be_bytes());
        callback.extend([0x9f, 0x52, 0x39]);
        memory.bytes[0x6140..0x6140 + callback.len()].copy_from_slice(&callback);
        memory.bytes[0x6000..0x600b]
            .copy_from_slice(&[0x7c, 0x63, 0x39, 0xcc, 0, 1, 0xbd, 0x8c, 0x37, 0x39, 0x12]);
        set_word(&mut memory, 0xb0, 0x134);
        set_word(&mut memory, 0x134, 0x6000);
        assert!(execute_direct(&mut memory, &mut cpu, source), "{source}");
        assert_eq!(&memory.bytes[0x6338..0x633a], &[1, 1], "{source}");
        let expected: Vec<u8> = fact["resultBytes"]
            .as_array()
            .unwrap()
            .iter()
            .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap())
            .collect();
        let record = numeric_scalar(&memory, [b'B', 0x80]);
        let pointer = usize::from(u16::from_be_bytes([record[2], record[3]]));
        assert_eq!(usize::from(record[0]), expected.len(), "{source}");
        assert_eq!(
            &memory.bytes[pointer..pointer + expected.len()],
            expected,
            "{source}"
        );
        canonical_assert_empty(&memory);
        assert_eq!(cpu.registers.s, 0x7000);
    }
}

