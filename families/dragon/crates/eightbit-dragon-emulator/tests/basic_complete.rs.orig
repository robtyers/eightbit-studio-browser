}

#[test]
fn basic_rom_shared_text_context_skips_every_function_prefix() {
    for function in [
        "SGN", "INT", "ABS", "POS", "RND", "SQR", "LOG", "EXP", "SIN", "COS", "TAN", "ATN", "PEEK",
        "LEN", "STR$", "VAL", "ASC", "CHR$", "EOF", "JOYSTK", "FIX", "HEX$", "LEFT$", "RIGHT$",
        "MID$", "POINT", "INKEY$", "MEM", "VARPTR", "INSTR", "TIMER", "PPOINT", "STRING$", "USR",
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        // No function body or argument validation may run in a false branch.
        memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
        assert!(
            execute_direct(
                &mut memory,
                &mut cpu,
                &format!("IF 0 THEN A={function}(1) ELSE PRINT 7")
            ),
            "{function}"
        );
        assert_eq!(memory.output, b" 7 \r", "{function}");
        store_line(&mut memory, &mut cpu, 10, &format!("A={function}(1)"));
        store_line(&mut memory, &mut cpu, 20, "DATA 85");
        let mut code = Vec::new();
        call(&mut code, symbol("DATA_RESET"));
        memory.execute(&mut cpu, &code);
        memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
        assert!(
            execute_direct(&mut memory, &mut cpu, "READ B"),
            "{function}"
        );
        assert_eq!(
            numeric_scalar(&memory, [b'B', 0]),
            packed_integer(85),
            "{function}"
        );
        memory.output.clear();
        memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
        assert!(execute_direct(&mut memory, &mut cpu, "LIST"));
        assert_eq!(
            memory.output,
            format!("10 A={function}(1)\r20 DATA 85\r").as_bytes(),
            "{function}"
        );
    }
}

#[test]
fn basic_rom_native_scope_restores_temporary_output_mode_on_success_and_failure() {
    for previous in [0u8, 1, 255] {
        for fail in [false, true] {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            memory.bytes[usize::from(symbol("FORMAT_BUFFER"))] = previous;
            memory.bytes[0x6f] = 0xfe;
            let mut body = vec![0x34, 0x66]; // The ordinary native wrapper saves D/Y/U.
            call(&mut body, symbol("NATIVE_INLINE"));
            body.extend([0x86, 23, 0xb7]);
            body.extend(symbol("FORMAT_BUFFER").to_be_bytes());
            if fail {
                body.extend([0x0f, 0x6f, 0x7e]);
                body.extend(symbol("NATIVE_FAIL").to_be_bytes());
            } else {
                body.extend([0x4f, 0x39]);
            }
            memory.bytes[0x6400..0x6400 + body.len()].copy_from_slice(&body);
            memory.execute(&mut cpu, &[0xbd, 0x64, 0]);
            assert_eq!(cpu.registers.cc & C != 0, fail);
            assert_eq!(cpu.registers.s, 0x7000);
            assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], previous);
            assert_eq!(memory.bytes[0x6f], 0xfe);
            assert_eq!(word(&memory, usize::from(symbol("STATEMENT_SP"))), 0);
        }
    }
}

#[test]
fn basic_rom_shared_byte_compare_keeps_unsigned_flags_and_bounded_spans() {
    for size in [0usize, 1, 8, 255] {
        for difference in [None, Some(0), Some(size.saturating_sub(1))] {
            for greater in [false, true] {
                let mut memory = Memory::new();
                let mut cpu = Cpu::default();
                memory.bytes[0x3000..0x3100].fill(0x55);
                memory.bytes[0x3200..0x3300].fill(0x55);
                let mismatch = difference.filter(|&offset| offset < size);
                if let Some(offset) = mismatch {
                    memory.bytes[0x3000 + offset] = if greater { 255 } else { 0 };
                }
                cpu.registers.x = 0x3000;
                cpu.registers.y = 0x3200;
                cpu.registers.u = 0x4567;
                cpu.registers.b = u8::try_from(size).unwrap();
                cpu.registers.cc = C;
                let mut code = Vec::new();
                call(&mut code, symbol("COMPARE_BYTES"));
                memory.execute(&mut cpu, &code);
                assert_eq!(
                    cpu.registers.cc & eightbit_m6809_core::Z != 0,
                    mismatch.is_none()
                );
                assert_eq!(cpu.registers.cc & C != 0, mismatch.is_some() && !greater);
                let consumed = u16::try_from(mismatch.map_or(size, |offset| offset + 1)).unwrap();
                assert_eq!(cpu.registers.x, 0x3000 + consumed);
                assert_eq!(cpu.registers.y, 0x3200 + consumed);
                assert_eq!(cpu.registers.u, 0x4567);
                assert_eq!(cpu.registers.s, 0x7000);
            }
        }
    }
}

#[test]
fn staged_cassette_output_records_and_cursor() {
    for (source, expected) in [
        ("PRINT#-1,12", b" 12\r".as_slice()),
        ("PRINT#-1,-12.5", b"-12.5\r".as_slice()),
        ("PRINT#-1,\"A\",\"B\"", b"A\rB\r".as_slice()),
        ("PRINT#-1,1;2", b" 1\r 2\r".as_slice()),
        ("PRINT#-1,STR$(12);\"Ab\"", b" 12\rAb\r".as_slice()),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        memory.signal_limit = 131_072;
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "OPEN\"O\",#-1,\"OWNDATA\""
        ));
        assert_eq!(memory.bytes[0x78], 2);
        assert_eq!(memory.bytes[0x79], 0);
        assert_eq!(word(&memory, 0x7a), 0x1da);
        assert!(execute_direct(&mut memory, &mut cpu, source), "{source}");
        assert_eq!(memory.bytes[0x79], u8::try_from(expected.len()).unwrap());
        assert_eq!(
            word(&memory, 0x7a),
            0x1da + u16::try_from(expected.len()).unwrap()
        );
        assert_eq!(
            &memory.bytes[0x1da..0x1da + expected.len()],
            expected,
            "{source}"
        );
        assert!(execute_direct(&mut memory, &mut cpu, "CLOSE#-1"));
        assert_eq!(memory.bytes[0x78], 0);
        assert_eq!(memory.bytes[0x79], 0);
        assert_eq!(word(&memory, 0x7a), 0x1da);
        let blocks = original_cassette_blocks(&recorded_gapped_cassette(&memory));
        assert_eq!(
            blocks,
            vec![
                (0, b"OWNDATA \x01\xff\xff\0\0\0\0".to_vec()),
                (1, expected.to_vec()),
                (255, vec![])
            ]
        );
    }
}
fn own_data_cassette(payload: &[u8], size: usize) -> Vec<u8> {
    let mut tape = Vec::new();
    append_synthetic_cassette_block(&mut tape, 0, b"OWNDATA \x01\xff\xff\0\0\0\0");
    for block in payload.chunks(size) {
        append_synthetic_cassette_block(&mut tape, 1, block);
    }
    append_synthetic_cassette_block(&mut tape, 255, &[]);
    tape.extend([0x55; 16]);
    tape
}
fn own_hex(hex: &str) -> Vec<u8> {
    hex.as_bytes()
        .chunks_exact(2)
        .map(|b| u8::from_str_radix(std::str::from_utf8(b).unwrap(), 16).unwrap())
        .collect()
}
#[test]
fn staged_cassette_input_reference_records() {
    for (path, contents) in [
        (
            "data-file-input.json",
            include_bytes!("fixtures/complete-basic/c68db9d4c391db0c-data-file-input.json")
                .as_slice(),
        ),
        (
            "data-file-input-boundaries.json",
            include_bytes!(
                "fixtures/complete-basic/975f1ec238146559-data-file-input-boundaries.json"
            )
            .as_slice(),
        ),
        (
            "data-file-input-controls.json",
            include_bytes!(
                "fixtures/complete-basic/2b8bcaf284b8f0cd-data-file-input-controls.json"
            )
            .as_slice(),
        ),
    ] {
        let facts: serde_json::Value =
            serde_json::from_slice(contents).unwrap_or_else(|error| panic!("{path}: {error}"));
        for row in facts["observations"].as_array().unwrap() {
            let body = row["body"].as_str().unwrap();
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            assert!(execute_direct(&mut memory, &mut cpu, "CLEAR1000"));
            store_line(
                &mut memory,
                &mut cpu,
                10,
                &format!("OPEN\"I\",#-1,\"OWNDATA\":{body}"),
            );
            synthetic_tape(
                &mut memory,
                &own_data_cassette(&own_hex(row["payload"].as_str().unwrap()), 255),
            );
            memory.tape_clock = Some(memory.cycles);
            let success = execute_direct_with_budget(&mut memory, &mut cpu, "RUN", 64_000_000);
            let errors = row["errors"].as_array().unwrap();
            assert_eq!(
                success,
                errors.is_empty(),
                "{body}: error {}",
                candidate_error_index(&memory)
            );
            for item in row["values"].as_array().unwrap() {
                let name = own_hex(item["name"].as_str().unwrap());
                let expected = own_hex(item["value"].as_str().unwrap());
                let value = numeric_scalar(&memory, name.try_into().unwrap());
                if item["name"].as_str().unwrap().ends_with("80") {
                    let ptr = usize::from(u16::from_be_bytes([value[2], value[3]]));
                    assert_eq!(
                        memory.bytes[ptr..ptr + usize::from(value[0])],
                        expected,
                        "{body}"
                    );
                } else {
                    assert_eq!(value.as_slice(), expected, "{body}");
                }
            }
            assert_eq!(
                memory.bytes[0x78],
                u8::try_from(row["mode"].as_u64().unwrap()).unwrap(),
                "{body}"
            );
            assert_eq!(
                memory.bytes[0x79],
                u8::try_from(row["count"].as_u64().unwrap()).unwrap(),
                "{body}"
            );
            assert_eq!(
                word(&memory, 0x7a),
                u16::try_from(row["cursor"].as_u64().unwrap()).unwrap(),
                "{body}"
            );
            if let Some(error) = errors.first() {
                let expected = match error.as_str().unwrap() {
                    "IE" => 9,
                    "FD" => 10,
                    x => panic!("unreviewed {x}"),
                };
                assert_eq!(candidate_error_index(&memory), expected, "{body}");
            }
        }
    }
}
#[test]
fn staged_cassette_output_reference_grammar() {
    for (path, contents) in [
        (
            "data-file-lifecycle.json",
            include_bytes!("fixtures/complete-basic/40619db9f2ed41e4-data-file-lifecycle.json")
                .as_slice(),
        ),
        (
            "data-file-grammar.json",
            include_bytes!("fixtures/complete-basic/130d86389114b6b7-data-file-grammar.json")
                .as_slice(),
        ),
        (
            "data-file-eof-closed.json",
            include_bytes!("fixtures/complete-basic/7707762120183d7a-data-file-eof-closed.json")
                .as_slice(),
        ),
    ] {
        let facts: serde_json::Value =
            serde_json::from_slice(contents).unwrap_or_else(|error| panic!("{path}: {error}"));
        for row in facts["observations"].as_array().unwrap() {
            let command = row["command"].as_str().unwrap();
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            memory.signal_limit = 131_072;
            let success = execute_direct_with_budget(&mut memory, &mut cpu, command, 32_000_000);
            let errors = row["errors"].as_array().unwrap();
            assert_eq!(
                success,
                errors.is_empty(),
                "{command}: error {}",
                candidate_error_index(&memory)
            );
            let blocks = original_cassette_blocks(&recorded_gapped_cassette(&memory));
            let expected: Vec<_> = row["blocks"]
                .as_array()
                .unwrap()
                .iter()
                .map(|b| {
                    (
                        u8::try_from(b["kind"].as_u64().unwrap()).unwrap(),
                        own_hex(b["data"].as_str().unwrap()),
                    )
                })
                .collect();
            assert_eq!(blocks, expected, "{command}");
            assert_eq!(
                memory.bytes[0x78],
                u8::try_from(row["mode"].as_u64().unwrap()).unwrap(),
                "{command}"
            );
            assert_eq!(
                memory.bytes[0x79],
                u8::try_from(row["count"].as_u64().unwrap()).unwrap(),
                "{command}"
            );
            assert_eq!(
                word(&memory, 0x7a),
                u16::try_from(row["headerAddress"].as_u64().unwrap()).unwrap(),
                "{command}"
            );
        }
    }
}

#[test]
fn staged_cassette_recovery_reference_lifecycle() {
    let facts: serde_json::Value = serde_json::from_slice(include_bytes!(
        "fixtures/complete-basic/61d661c7e66cb16b-data-file-recovery.json"
    ))
    .unwrap();
    for row in facts["observations"].as_array().unwrap() {
        let command = row["command"].as_str().unwrap();
        // CLOAD's supplied input transport has a separate qualified fixture.
        if command.contains("CLOAD") {
            continue;
        }
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        memory.signal_limit = 131_072;
        let success = if let Some(body) = command.strip_prefix("10 ") {
            store_line(
                &mut memory,
                &mut cpu,
                10,
                body.strip_suffix("\rRUN").unwrap(),
            );
            execute_direct_with_budget(&mut memory, &mut cpu, "RUN", 32_000_000)
        } else {
            execute_direct_with_budget(&mut memory, &mut cpu, command, 32_000_000)
        };
        let errors = row["errors"].as_array().unwrap();
        assert_eq!(success, errors.is_empty(), "{command}");
        let expected: Vec<_> = row["blocks"]
            .as_array()
            .unwrap()
            .iter()
            .map(|b| {
                (
                    u8::try_from(b["kind"].as_u64().unwrap()).unwrap(),
                    own_hex(b["data"].as_str().unwrap()),
                )
            })
            .collect();
        assert_eq!(
            original_cassette_blocks(&recorded_data_motor(&memory)),
            expected,
            "{command}"
        );
        assert_eq!(
            memory.bytes[0x78],
            u8::try_from(row["mode"].as_u64().unwrap()).unwrap(),
            "{command}"
        );
        assert_eq!(
            memory.bytes[0x79],
            u8::try_from(row["count"].as_u64().unwrap()).unwrap(),
            "{command}"
        );
        assert_eq!(
            word(&memory, 0x7a),
            u16::try_from(row["headerAddress"].as_u64().unwrap()).unwrap(),
            "{command}"
        );
        if let Some(error) = errors.first() {
            memory.output.clear();
            let mut code = Vec::new();
            memory.bytes[0x6f] = 0xfe;
            call(&mut code, symbol("BASIC_ERROR"));
            memory.execute(&mut cpu, &code);
            assert_eq!(
                memory.output,
                format!("?{} ERROR\r", error.as_str().unwrap()).as_bytes(),
                "{command}"
            );
        }
        memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
        assert!(execute_direct(&mut memory, &mut cpu, "CLOSE:Z=85"));
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
    }
}
#[test]
fn staged_cassette_malformed_streams_stop_motor_and_recover() {
    for (case, expected) in [
        ("missing", 12),
        ("short header", 12),
        ("header checksum", 12),
        ("wrong gap", 7),
        ("wrong flags", 7),
        ("wrong block", 12),
        ("data checksum", 12),
        ("bad eof", 12),
        ("missing data", 12),
        ("unterminated record", 9),
    ] {
        let mut tape = Vec::new();
        let mut header = b"OWNDATA \x01\xff\xff\0\0\0\0".to_vec();
        if case == "short header" {
            header.pop();
        }
        if case == "wrong gap" {
            header[10] = 0;
        }
        if case == "wrong flags" {
            header[9] = 0;
        }
        if case != "missing" {
            append_synthetic_cassette_block(&mut tape, 0, &header);
            if case == "header checksum" {
                let at = tape.len() - 2;
                tape[at] ^= 1;
            }
            if case != "missing data" {
                let kind = if case == "wrong block" {
                    2
                } else if case == "bad eof" {
                    255
                } else {
                    1
                };
                append_synthetic_cassette_block(
                    &mut tape,
                    kind,
                    if case == "unterminated record" {
                        b"12"
                    } else {
                        b"12\r"
                    },
                );
                if case == "data checksum" {
                    let at = tape.len() - 2;
                    tape[at] ^= 1;
                }
                append_synthetic_cassette_block(&mut tape, 255, &[]);
            }
        }
        tape.extend([0x55; 16]);
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        store_line(
            &mut memory,
            &mut cpu,
            10,
            "OPEN\"I\",-1,\"OWNDATA\":INPUT#-1,A",
        );
        synthetic_tape(&mut memory, &tape);
        memory.tape_clock = Some(memory.cycles);
        memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
        assert!(
            !execute_direct_with_budget(&mut memory, &mut cpu, "RUN", 32_000_000),
            "{case}"
        );
        assert_eq!(candidate_error_index(&memory), expected, "{case}");
        assert_eq!(memory.bytes[0xff21] & 8, 0, "motor after {case}");
        assert_eq!(
            word(&memory, usize::from(symbol("STR_ROOTS"))),
            0,
            "roots after {case}"
        );
        assert_eq!(
            word(&memory, usize::from(symbol("STATEMENT_SP"))),
            0,
            "boundary after {case}"
        );
        assert_eq!(
            memory.bytes[usize::from(symbol("FORMAT_BUFFER"))],
            0,
            "output after {case}"
        );
        memory.output.clear();
        let mut code = Vec::new();
        memory.bytes[0x6f] = 0xfe;
        call(&mut code, symbol("BASIC_ERROR"));
        memory.execute(&mut cpu, &code);
        let error = match expected {
            7 => "FM",
            9 => "IE",
            _ => "IO",
        };
        assert_eq!(
            memory.output,
            format!("?{error} ERROR IN 10\r").as_bytes(),
            "{case}"
        );
        memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
        assert!(
            execute_direct_with_budget(
                &mut memory,
                &mut cpu,
                "CLOSE:OPEN\"O\",-1,\"RETRY\":PRINT#-1,85:CLOSE:Z=85",
                32_000_000
            ),
            "recover {case}"
        );
        assert_eq!(memory.bytes[0x78], 0);
        assert_eq!(memory.bytes[0x79], 0);
        assert_eq!(word(&memory, 0x7a), 0x1da);
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
    }
}

fn recorded_data_motor(memory: &Memory) -> Vec<u8> {
    let mut capture = Memory::new();
    capture.signal_limit = memory.signal_limit;
    let mut motor = false;
    for &(cycle, address, value) in &memory.signals {
        if address == 0xff21 {
            motor = value & 8 != 0;
        }
        if motor && address == 0xff20 {
            capture.signals.push((cycle, address, value));
        }
    }
    recorded_gapped_cassette(&capture)
}

#[test]
fn staged_cassette_load_abandons_data_file_without_flushing() {
    for command in ["CLOAD\"B\"", "CLOADM\"B\""] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        memory.signal_limit = 131_072;
        assert!(execute_direct(
            &mut memory,
            &mut cpu,
            "OPEN\"O\",-1,\"A\":PRINT#-1,\"Ab\""
        ));
        let mut tape = Vec::new();
        append_synthetic_cassette_block(&mut tape, 0, b"B       \0\0\0\0\0\0\0");
        append_synthetic_cassette_block(&mut tape, 1, &[0x1e, 0x07, 0, 10, 0x8a, 0, 0, 0]);
        append_synthetic_cassette_block(&mut tape, 255, &[]);
        tape.extend([0x55; 16]);
        synthetic_tape(&mut memory, &tape);
        memory.tape_clock = Some(memory.cycles);
        assert_eq!(
            execute_direct_with_budget(&mut memory, &mut cpu, command, 32_000_000),
            !command.starts_with("CLOADM")
        );
        assert_eq!(memory.bytes[0x78], 0);
        assert_eq!(memory.bytes[0x79], 0);
        assert_eq!(word(&memory, 0x7a), 0x1da);
        assert_eq!(memory.bytes[0xff21] & 8, 0);
        let blocks = original_cassette_blocks(&recorded_data_motor(&memory));
        assert_eq!(blocks, vec![(0, b"A       \x01\xff\xff\0\0\0\0".to_vec())]);
        if command.starts_with("CLOADM") {
            assert_eq!(candidate_error_index(&memory), 7);
            assert!(execute_direct(&mut memory, &mut cpu, "Z=85"));
        } else {
            assert_eq!(
                memory.bytes[0x1e01..0x1e09],
                [0x1e, 0x07, 0, 10, 0x8a, 0, 0, 0]
            );
            assert!(execute_direct(&mut memory, &mut cpu, "RUN:Z=85"));
        }
    }
}

#[test]
fn staged_cassette_open_header_flags_match_reference() {
    let facts: serde_json::Value = serde_json::from_slice(include_bytes!(
        "fixtures/complete-basic/e7997899ee60c6e4-data-file-header-modes.json"
    ))
    .unwrap();
    for row in facts["observations"].as_array().unwrap() {
        let mut tape = Vec::new();
        let mut header = b"OWNDATA ".to_vec();
        header.extend(
            row["headerFlags"]
                .as_array()
                .unwrap()
                .iter()
                .map(|v| u8::try_from(v.as_u64().unwrap()).unwrap()),
        );
        header.extend([0; 4]);
        append_synthetic_cassette_block(&mut tape, 0, &header);
        append_synthetic_cassette_block(&mut tape, 1, b"12\r");
        append_synthetic_cassette_block(&mut tape, 255, &[]);
        tape.extend([0x55; 16]);
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        synthetic_tape(&mut memory, &tape);
        memory.tape_clock = Some(memory.cycles);
        let success = execute_direct_with_budget(
            &mut memory,
            &mut cpu,
            "OPEN\"I\",-1,\"OWNDATA\"",
            32_000_000,
        );
        assert_eq!(
            success,
            row["errors"].as_array().unwrap().is_empty(),
            "{:?}",
            row["headerFlags"]
        );
        assert_eq!(
            memory.bytes[0x78],
            u8::try_from(row["mode"].as_u64().unwrap()).unwrap()
        );
        assert_eq!(
            memory.bytes[0x79],
            u8::try_from(row["count"].as_u64().unwrap()).unwrap()
        );
        assert_eq!(
            word(&memory, 0x7a),
            u16::try_from(row["cursor"].as_u64().unwrap()).unwrap()
        );
        assert_eq!(
            memory.bytes[0x81],
            u8::try_from(row["blockStatus"].as_u64().unwrap()).unwrap()
        );
        assert_eq!(memory.bytes[0xff21] & 8, 0);
    }
}

#[test]
fn staged_using_synthetic_reference() {
    let mut failures = Vec::new();
    for (path, contents) in [
        (
            "using.json",
            include_bytes!("fixtures/complete-basic/de4aabafdbb54a90-using.json").as_slice(),
        ),
        (
            "using-extra.json",
            include_bytes!("fixtures/complete-basic/ad1b3509ab1e971e-using-extra.json").as_slice(),
        ),
        (
            "using-edge.json",
            include_bytes!("fixtures/complete-basic/ac5289583f3d67cf-using-edge.json").as_slice(),
        ),
        (
            "using-limits.json",
            include_bytes!("fixtures/complete-basic/330bfa5956e000d6-using-limits.json").as_slice(),
        ),
        (
            "using-buffer-limits.json",
            include_bytes!("fixtures/complete-basic/5f704f270ffbae47-using-buffer-limits.json")
                .as_slice(),
        ),
        (
            "using-wide-exponent.json",
            include_bytes!("fixtures/complete-basic/b7744c4fa36cc69c-using-wide-exponent.json")
                .as_slice(),
        ),
        (
            "using-wide-boundary.json",
            include_bytes!("fixtures/complete-basic/e2cdfc725fba957e-using-wide-boundary.json")
                .as_slice(),
        ),
        (
            "using-wide-signs.json",
            include_bytes!("fixtures/complete-basic/8b641d97019e0d24-using-wide-signs.json")
                .as_slice(),
        ),
    ] {
        let cases: serde_json::Value =
            serde_json::from_slice(contents).unwrap_or_else(|error| panic!("{path}: {error}"));
        for case in cases.as_array().unwrap() {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            let source = case["source"].as_str().unwrap();
            let success = execute_direct_with_budget(&mut memory, &mut cpu, source, 4_194_304);
            let printed = String::from_utf8_lossy(&memory.output);
            if success != case["success"].as_bool().unwrap()
                || printed != case["output"].as_str().unwrap()
            {
                failures.push(format!(
                    "{source}: expected {:?}/{} got {printed:?}/{success}",
                    case["output"].as_str().unwrap(),
                    case["success"]
                ));
            }
        }
    }
    assert!(
        failures.is_empty(),
        "{} failures: {}",
        failures.len(),
        failures.join("\n")
    );
}

#[test]
fn staged_using_roots_failures_and_recovery() {
    for (source, expected, success) in [
        (
            "A$=\"[##]\":PRINT#-2,USING A$;1,2,3",
            "[ 1][ 2][ 3]\r",
            true,
        ),
        (
            "CLEAR20:A$=\"%%\":PRINT#-2,USING A$;STR$(1),STR$(2),STR$(3)",
            " 1 2 3\r",
            true,
        ),
        ("PRINT#-2,USING STRING$(255,65);1", "", false),
        ("PRINT#-2,USING\"##\";1/0", "", false),
        ("PRINT#-2,USING\"##\";\"X\"", "", false),
        ("PRINT#-2,USING1;2", "", false),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert_eq!(
            execute_direct_with_budget(&mut memory, &mut cpu, source, 4_194_304),
            success,
            "{source}"
        );
        assert_eq!(memory.output, expected.as_bytes(), "{source}");
        assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0);
        assert_eq!(memory.bytes[0x6f], if success { 0 } else { 0xfe });
        memory.output.clear();
        memory.bytes[0x6f] = 0xfe; // Select the recovery transcript device explicitly.
        assert!(execute_direct(&mut memory, &mut cpu, "PRINT 7"));
        assert_eq!(memory.output, b" 7 \r");
    }
}

#[test]
fn staged_using_rounding_inputs() {
    let cases: serde_json::Value = serde_json::from_slice(include_bytes!(
        "fixtures/complete-basic/8b5247502169f2af-using-rounding.json"
