#[test]
fn staged_edit_storage_and_expanded_text_failures_preserve_programme() {
    for expanded in [false, true] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        let body = if expanded {
            "?".repeat(63)
        } else {
            "REM ABC".into()
        };
        store_line(&mut memory, &mut cpu, 10, &body);
        assert!(execute_direct(&mut memory, &mut cpu, "Z=85"));
        let pointers = memory.bytes[0x19..0x21].to_vec();
        let before = memory.bytes[0x1e01..usize::from(word(&memory, 0x1f))].to_vec();
        if !expanded {
            let end = word(&memory, 0x1b);
            set_word(&mut memory, 0x21, end + 128 + 4);
        }
        supply_original_keyboard(&mut memory, b"I123456789\r");
        assert!(!execute_direct(&mut memory, &mut cpu, "EDIT10"));
        assert_eq!(memory.bytes[0x19..0x21], pointers);
        assert_eq!(memory.bytes[0x1e01..0x1e01 + before.len()], before);
        assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], 0);
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
        assert!(execute_direct(&mut memory, &mut cpu, "PRINT 42"));
    }
}

#[test]
fn staged_combined_edit_renumber_format_and_data_file_round_trip() {
    let mut writer = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut writer);
    enable_guest_printer(&mut writer);
    writer.signal_limit = 131_072;
    for (line, source) in [
        (10, "GOSUB100:END"),
        (100, "OPEN\"O\",-1,\"OWNDATA\""),
        (110, "FOR I=1 TO 3"),
        (120, "PRINT#-1,I*I"),
        (130, "PRINT#-2,USING\"##\";I*I"),
        (140, "NEXT:CLOSE:RETURN"),
    ] {
        store_line(&mut writer, &mut cpu, line, source);
    }
    assert!(execute_direct(&mut writer, &mut cpu, "RENUM1000,0,10"));
    supply_original_keyboard(&mut writer, b"X:REM EDITED\r");
    assert!(execute_direct(&mut writer, &mut cpu, "EDIT1020"));
    writer.output.clear();
    assert!(execute_direct_with_budget(
        &mut writer,
        &mut cpu,
        "RUN",
        32_000_000
    ));
    assert_eq!(writer.output, b" 1\r 4\r 9\r");
    assert_eq!(writer.bytes[0x78], 0);
    let tape = recorded_data_motor(&writer);
    let blocks = original_cassette_blocks(&tape);
    assert_eq!(
        blocks,
        vec![
            (0, b"OWNDATA \x01\xff\xff\0\0\0\0".to_vec()),
            (1, b" 1\r 4\r 9\r".to_vec()),
            (255, vec![]),
        ]
    );

    let mut reader = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut reader);
    enable_guest_printer(&mut reader);
    store_line(
        &mut reader,
        &mut cpu,
        10,
        "OPEN\"I\",-1,\"OWNDATA\":INPUT#-1,A,B,C:PRINT#-2, USING\"##\";A,B,C:CLOSE",
    );
    synthetic_tape(&mut reader, &tape);
    reader.tape_clock = Some(reader.cycles);
    assert!(execute_direct_with_budget(
        &mut reader,
        &mut cpu,
        "RUN",
        32_000_000
    ));
    assert_eq!(reader.output, b" 1 4 9\r");
    for (name, expected) in [(b'A', 1), (b'B', 4), (b'C', 9)] {
        assert_eq!(numeric_scalar(&reader, [name, 0]), packed_integer(expected));
    }
    assert_eq!(reader.bytes[0x78], 0);
    assert_eq!(reader.bytes[0xff21] & 8, 0);
    assert_eq!(word(&reader, usize::from(symbol("STR_ROOTS"))), 0);
    assert_eq!(word(&reader, usize::from(symbol("STATEMENT_SP"))), 0);
}

#[test]
fn staged_combined_format_failure_preserves_pending_cassette_record() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    memory.signal_limit = 131_072;
    memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        "OPEN\"O\",-1,\"OWNDATA\":PRINT#-1,STR$(12)"
    ));
    let buffered = memory.bytes[0x1da..0x1de].to_vec();
    memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
    assert!(!execute_direct(
        &mut memory,
        &mut cpu,
        "PRINT#-2,USING\"##\";1/0"
    ));
    assert_eq!(memory.bytes[0x78], 2);
    assert_eq!(memory.bytes[0x79], 4);
    assert_eq!(word(&memory, 0x7a), 0x1de);
    assert_eq!(memory.bytes[0x1da..0x1de], buffered);
    assert_eq!(memory.bytes[usize::from(symbol("FORMAT_BUFFER"))], 0);
    memory.output.clear();
    memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
    assert!(execute_direct(
        &mut memory,
        &mut cpu,
        "PRINT#-2, USING\"##\";7:PRINT#-1,34:CLOSE"
    ));
    assert_eq!(memory.output, b" 7\r");
    assert_eq!(
        original_cassette_blocks(&recorded_data_motor(&memory)),
        vec![
            (0, b"OWNDATA \x01\xff\xff\0\0\0\0".to_vec()),
            (1, b" 12\r 34\r".to_vec()),
            (255, vec![]),
        ]
    );
}

#[test]
fn staged_dload_base_dragon32_error_and_recovery_observations() {
    for (fixture, contents) in [
        (
            "dload.json",
            include_bytes!("fixtures/complete-basic/65bf1a83a8ed3db1-dload.json").as_slice(),
        ),
        (
            "dload-extra.json",
            include_bytes!("fixtures/complete-basic/bb51ec6379fb2817-dload-extra.json").as_slice(),
        ),
        (
            "dload-selectors.json",
            include_bytes!("fixtures/complete-basic/44dd0fccf462696d-dload-selectors.json")
                .as_slice(),
        ),
    ] {
        let facts: serde_json::Value =
            serde_json::from_slice(contents).unwrap_or_else(|error| panic!("{fixture}: {error}"));
        for fact in facts["observations"].as_array().unwrap() {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            enable_guest_printer(&mut memory);
            store_line(&mut memory, &mut cpu, 10, "Z=85");
            let end = usize::from(word(&memory, 0x1b));
            let original = memory.bytes[0x1e01..end].to_vec();
            let command = fact["command"].as_str().unwrap();
            assert!(!execute_direct(&mut memory, &mut cpu, command), "{command}");
            assert_eq!(memory.bytes[0x1e01..end], original, "{command}");
            memory.output.clear();
            let mut code = Vec::new();
            call(&mut code, symbol("BASIC_ERROR"));
            memory.execute(&mut cpu, &code);
            assert_eq!(
                memory.output,
                format!("?{} ERROR\r", fact["errors"][0].as_str().unwrap()).as_bytes(),
                "{command}"
            );
            assert!(
                execute_direct(&mut memory, &mut cpu, "RUN"),
                "recovery {command}"
            );
            assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
            assert_eq!(word(&memory, usize::from(symbol("STR_ROOTS"))), 0);
            assert_eq!(word(&memory, usize::from(symbol("STATEMENT_SP"))), 0);
        }
    }
}

#[test]
fn staged_dload_closes_data_file_before_argument_errors() {
    let facts: serde_json::Value = serde_json::from_slice(include_bytes!(
        "fixtures/complete-basic/04747cb69e9a5113-data-file-dload.json"
    ))
    .unwrap();
    for fact in facts["observations"].as_array().unwrap() {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        memory.signal_limit = 131_072;
        let command = fact["command"].as_str().unwrap();
        memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
        assert!(!execute_direct_with_budget(
            &mut memory,
            &mut cpu,
            command,
            32_000_000
        ));
        let expected: Vec<_> = fact["blocks"]
            .as_array()
            .unwrap()
            .iter()
            .map(|b| {
                (
                    u8::try_from(b["kind"].as_u64().unwrap()).unwrap(),
                    own_hex(b["data"].as_str().unwrap()),
                )
            })
            .collect();
        assert_eq!(
            original_cassette_blocks(&recorded_data_motor(&memory)),
            expected,
            "{command}"
        );
        assert_eq!(memory.bytes[0x78], 0);
        assert_eq!(memory.bytes[0x79], 0);
        assert_eq!(word(&memory, 0x7a), 0x1da);
        assert_eq!(memory.bytes[0xff21] & 8, 0);
        memory.output.clear();
        let mut code = Vec::new();
        memory.bytes[0x6f] = 0xfe; // Capture the separate error-rendering ABI probe.
        call(&mut code, symbol("BASIC_ERROR"));
        memory.execute(&mut cpu, &code);
        assert_eq!(
            memory.output,
            format!("?{} ERROR\r", fact["errors"][0].as_str().unwrap()).as_bytes(),
            "{command}"
        );
        memory.bytes[0x6f] = 0xfe; // This invocation captures printer output.
        assert!(execute_direct(&mut memory, &mut cpu, "Z=85"));
        assert_eq!(numeric_scalar(&memory, [b'Z', 0]), packed_integer(85));
    }
}

#[test]
fn native_macro_public_cursor_count_and_failure_order_match_reference() {
    let facts: serde_json::Value = serde_json::from_str(include_str!(
        "fixtures/complete-basic/cd63601e6e08efb0-observations.json"
    ))
    .unwrap();
    let mut failures = Vec::new();
    for fact in facts["cases"].as_array().unwrap() {
        let source = fact["source"].as_str().unwrap();
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        let mut init = Vec::new();
        call(&mut init, symbol("SETUP"));
        memory.execute_with_budget(&mut cpu, &init, 1_000_000);
        memory.next_frame = Some(memory.cycles + 17745);
        cpu.registers.cc &= 0xaf;
        let success = execute_direct_with_budget(&mut memory, &mut cpu, source, 8_000_000);
        let expected_error = fact["error"].as_str();
        if success != expected_error.is_none() {
            failures.push(format!(
                "{source}: success={success}, error={expected_error:?}"
            ));
        }
        if let Some(error) = expected_error {
            let expected_code = match error {
                "SN" => 0,
                "TM" => 1,
                "FC" => 2,
                _ => panic!("Unqualified diagnostic"),
            };
            let got = candidate_error_index(&memory);
            if got != expected_code {
                failures.push(format!("{source}: diagnostic={got}, expected={error}"));
            }
        }
        // Graphics masks DB..DD are outside this regression except for seeded
        // preservation cases. Music state and the public cursor are all checked.
        let mut addresses = vec![0xd8, 0xd9, 0xda];
        addresses.extend(0xde..0xea);
        if source.contains("POKE219") {
            addresses.extend(0xdb..0xde);
        }
        for address in addresses {
            let key = format!("{address:04x}");
            let expected = u8::try_from(fact["workspace"][&key].as_u64().unwrap()).unwrap();
            let got = memory.bytes[address];
            if got != expected {
                failures.push(format!("{source}: {key}={got}, expected={expected}"));
            }
        }
        if let Some(canvas) = fact.get("syntheticGraphics") {
            use sha2::{Digest, Sha256};
            let length = usize::try_from(canvas["bytes"].as_u64().unwrap()).unwrap();
            assert_eq!(
                format!("{:x}", Sha256::digest(&memory.bytes[0x600..0x600 + length])),
                canvas["sha256"].as_str().unwrap(),
                "{source}: canvas"
            );
            assert_eq!(
                serde_json::json!([word(&memory, 0xc7), word(&memory, 0xc9)]),
                fact["cursor"],
                "{source}: cursor"
            );
        }
        assert_eq!(cpu.registers.s, 0x7000, "{source}");
        assert_eq!(
            word(&memory, usize::from(symbol("STR_ROOTS"))),
            0,
            "{source}"
        );
        assert_eq!(memory.bytes[0xff23] & 8, 0, "{source}");
        assert!(
            execute_direct(&mut memory, &mut cpu, "PLAY\"L4\":DRAW\"S4\""),
            "{source}: recovery"
        );
        assert_eq!(
            &memory.bytes[0xd8..0xdb],
            &[1, 0, 0],
            "{source}: recovery workspace"
        );
        assert_eq!(cpu.registers.s, 0x7000, "{source}: recovery stack");
    }
    assert!(
        failures.is_empty(),
        "{} failures:\n{}",
        failures.len(),
        failures.join("\n")
    );
}

#[test]
fn candidate_break_preserves_nested_control_frames_and_continuation() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    // The real prompt owns the control stack throughout RUN/Break/CONT. An ABI
    // call with a separate caller stack must not replace those live frames.
    let key = usize::from(symbol("KEYIN"));
    memory.bytes[key..key + 3].copy_from_slice(&[0x7e, 0x65, 0]);
    memory.bytes[0x6500..0x650d].copy_from_slice(&[
        0x34, 0x10, 0xbe, 0x66, 0, 0xa6, 0x80, 0xbf, 0x66, 0, 0x4d, 0x35, 0x90,
    ]);
    set_word(&mut memory, 0x6600, 0x6800);
    let text = concat!(
        "10 FOR I=1 TO 2\r20 GOSUB100\r30 NEXT I\r40 POKE25002,85:END\r",
        "100 POKE25000,I:IF PEEK(25001)=0 THEN100\r110 RETURN\r",
        "OPEN\"O\",-1,\"BREAK\":PRINT#-1,\"KEPT\"\rRUN\rPOKE25001,1:CONT\r"
    );
    memory.bytes[0x6800..0x6800 + text.len()].copy_from_slice(text.as_bytes());
    cpu.reset(&mut memory);
    let mut interrupted = false;
    let mut stopped = false;
    let mut finished = false;
    for _ in 0..8_388_608 {
        if memory.bytes[25000] == 1 && !interrupted {
            let mut keys = [0; 8];
            keys[2] = 64;
            memory.key_matrix = Some(keys);
            interrupted = true;
        }
        if interrupted && !stopped && memory.bytes[usize::from(symbol("CONT_VALID"))] == 1 {
            stopped = true;
            assert_eq!(word(&memory, 0x29), 100);
            assert_eq!(memory.bytes[0x78], 2, "Break retains an open data output");
            assert_eq!(memory.bytes[0x79], 5);
            assert_eq!(&memory.bytes[0x1da..0x1df], b"KEPT\r");
            memory.key_matrix = Some([0; 8]);
        }
        if memory.bytes[25002] == 85 {
            finished = true;
            break;
        }
        cpu.step(&mut memory).unwrap();
    }
    assert!(interrupted && stopped && finished);
    assert_eq!(memory.bytes[25000], 2);
    assert_eq!(numeric_scalar(&memory, [b'I', 0]), packed_integer(3));
}

#[test]
fn candidate_break_poll_uses_only_escape_without_printer_data_or_other_key_consumption() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    for index in 0..56 {
        let mut keys = [0; 8];
        keys[index % 8] = 1 << (index / 8);
        memory.key_matrix = Some(keys);
        memory.bytes[0xff02] = 0x3a;
        memory.bytes[0x152] = 0xff;
        let mut code = vec![];
        call(&mut code, symbol("BREAK_POLL"));
        memory.execute(&mut cpu, &code);
        assert_eq!(cpu.registers.cc & 4 != 0, index == 50, "matrix {index}");
        assert_eq!(memory.bytes[0xff02], 0x3a);
        assert_eq!(memory.bytes[0x152], if index == 50 { 0xbf } else { 0xff });
        assert!(memory.output.is_empty());
    }
}

#[test]
fn candidate_stop_reports_line_and_continues_after_the_statement() {
    let mut memory = Memory::new();
    let mut cpu = Cpu::default();
    empty_programme(&mut memory);
    enable_guest_printer(&mut memory);
    store_line(&mut memory, &mut cpu, 10, "STOP:POKE25000,85");
    assert!(execute_direct(&mut memory, &mut cpu, "RUN"));
    assert_eq!(memory.bytes[25000], 0);
    assert!(memory.output.ends_with(b"BREAK IN 10\r"));
    assert!(execute_direct(&mut memory, &mut cpu, "CONT"));
    assert_eq!(memory.bytes[25000], 85);
}

#[test]
fn native_store_line_requires_exact_bounded_nul_termination() {
    for length in [0_usize, 1, 2, 17, 251, 252, 253] {
        for terminator in 0..=length {
            let mut memory = Memory::new();
            let mut cpu = Cpu::default();
            empty_programme(&mut memory);
            store_line(&mut memory, &mut cpu, 10, "END");
            let before = memory.bytes[0x1e01..0x2000].to_vec();
            let limits = memory.bytes[0x1b..0x21].to_vec();
            memory.bytes[0x2dc..0x2dc + length].fill(b'A');
            if terminator < length {
                memory.bytes[0x2dc + terminator] = 0;
            }
            let mut code = vec![0xcc, 0, 20, 0x10, 0x8e];
            code.extend(u16::try_from(0x2dc + length).unwrap().to_be_bytes());
            call(&mut code, symbol("STORE_LINE"));
            memory.execute(&mut cpu, &code);
            let valid = (1..=252).contains(&length) && terminator == length - 1;
            assert_eq!(
                cpu.registers.cc & C == 0,
                valid,
                "length {length}, terminator {terminator}"
            );
            if !valid {
                assert_eq!(&memory.bytes[0x1e01..0x2000], before.as_slice());
                assert_eq!(&memory.bytes[0x1b..0x21], limits.as_slice());
            }
        }
    }
}

// Original synthetic programmes; two-letter results observed from the
// exact-SHA lawful reference. No implementation bytes are used as fixtures.
#[test]
fn complete_candidate_reports_control_array_storage_and_function_errors() {
    for (source, expected) in [
        ("NEXT", "NF"),
        ("NEXT A$", "NF"),
        ("RETURN", "RG"),
        ("READ A", "OD"),
        ("GOTO12345", "UL"),
        ("RUN12345", "UL"),
        ("CONT", "CN"),
        ("DIM A(1):DIM A(1)", "DD"),
        ("DIM A(-1)", "FC"),
        ("A(11)=1", "BS"),
        ("DIM A(1):A(2)=1", "BS"),
        ("DIM A(2):A(-1)=1", "FC"),
        ("DIM A(2):A(1,1)=1", "BS"),
        ("DIM A(32767)", "BS"),
        ("DIM A(10000)", "OM"),
        ("CLEAR99999", "FC"),
        ("CLEAR32760", "OM"),
        ("A$=STRING$(255,65)+\"A\"", "OS"),
        ("CLEAR1:A$=\"AB\"", "OS"),
        ("CLEAR1000:A$=STRING$(255,65)+\"A\"", "LS"),
        ("A$=STRING$(256,65)", "FC"),
        ("DEF FNA(X)=X:A=FNB(1)", "ID"),
        ("A=FNB(1)", "UF"),
        ("FORI=1TO2:NEXTJ", "NF"),
        ("A=FN(1)", "SN"),
        ("A=FNA$(1)", "TM"),
        ("A=FNA", "SN"),
        ("A=FNA(1/0)", "/0"),
        ("A=FNA(\"X\")", "TM"),
        ("DIM A()", "SN"),
        ("NEXT1", "SN"),
        ("NEXT,", "SN"),
        ("NEXT A,1", "NF"),
        ("RETURN 1", "SN"),
        ("CLEAR1,0", "OM"),
        ("CLEAR1,32768", "OM"),
        ("CLEAR1,65535", "OM"),
        ("CLEAR1,1", "OM"),
        ("CLEAR1,-1", "FC"),
    ] {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        assert!(!execute_direct(&mut memory, &mut cpu, source), "{source}");
        assert_eq!(
            word(&memory, usize::from(symbol("STR_ROOTS"))),
            0,
            "{source}"
        );
        assert_eq!(memory.bytes[usize::from(symbol("EX_DEPTH"))], 0, "{source}");
        memory.output.clear();
        let mut code = Vec::new();
        call(&mut code, symbol("BASIC_ERROR"));
        memory.execute(&mut cpu, &code);
        assert_eq!(
            memory.output,
            format!("?{expected} ERROR\r").as_bytes(),
            "{source}"
        );
        assert!(
            execute_direct(&mut memory, &mut cpu, "Z=85"),
            "recovery {source}"
        );
        assert_eq!(
            numeric_scalar(&memory, [b'Z', 0]),
            packed_integer(85),
            "{source}"
        );
    }
}

#[test]
fn complete_candidate_control_errors_retain_the_programme_line() {
    for (source, expected) in [
        ("NEXT", "NF"),
        ("RETURN", "RG"),
