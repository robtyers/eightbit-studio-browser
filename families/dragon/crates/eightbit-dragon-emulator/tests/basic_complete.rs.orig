    for expected in fixture["cases"].as_array().unwrap() {
        let mut memory = Memory::new();
        let mut cpu = Cpu::default();
        empty_programme(&mut memory);
        enable_guest_printer(&mut memory);
        memory.bytes[0x6f] = 0;
