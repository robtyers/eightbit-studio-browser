+#ifdef __EMSCRIPTEN__
+extern "C" int eightbit_key(unsigned int code) {
+    running_machine *machine = running_machine::emscripten_get_running_machine();
+    if (!machine || code < 1 || code > 127 || !machine->natkeyboard().empty()) return 0;
+    machine->natkeyboard().post_char(char32_t(code));
+    return 1;
+}
+#endif
+
+#ifdef __EMSCRIPTEN__
+extern "C" int eightbit_ready() {
+    running_machine *machine = running_machine::emscripten_get_running_machine();
+    return machine && machine->phase() == machine_phase::RUNNING;
+}
+#endif
